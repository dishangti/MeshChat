// Your 10-character Apple Developer Team ID.
DEVELOPMENT_TEAM = YOURTEAMID

// Unique bundle id to be able to register and run locally
PRODUCT_BUNDLE_IDENTIFIER = chat.meshchat.$(DEVELOPMENT_TEAM)

// App and share extension must use an App Group registered to your team.
APP_GROUP_ID = group.chat.meshchat.$(DEVELOPMENT_TEAM)

// Uncomment only when intentionally isolating BLE development traffic from
// released BitChat clients.
// SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) BITCHAT_BLE_TESTNET
