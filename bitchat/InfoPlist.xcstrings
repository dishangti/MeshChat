        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விருப்ப geohash சேனல்கள், மெஷ் பிரிட்ஜ் செல்கள் மற்றும் அருகிலுள்ள இடப் பெயர்களுக்கு மட்டுமே MeshChat இருப்பிடத்தைப் பயன்படுத்துகிறது. துல்லியமான ஆயத்தொலைவுகள் செய்திகளில் சேர்க்கப்படாது."
          }
        },
        "th" : {
          "stringUnit" : {
