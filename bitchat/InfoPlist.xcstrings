    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Explains optional geohash, bridge-cell, and place-label use without claiming exact coordinates never leave the device",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستخدم MeshChat الموقع إلا لقنوات geohash الاختيارية وخلايا جسور الشبكة المتداخلة وتسميات الأماكن القريبة. لا تُضمَّن الإحداثيات الدقيقة في الرسائل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat শুধু ঐচ্ছিক geohash চ্যানেল, মেশ ব্রিজ সেল এবং কাছাকাছি স্থানের নামের জন্য অবস্থান ব্যবহার করে। সুনির্দিষ্ট স্থানাঙ্ক বার্তায় যুক্ত করা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat verwendet den Standort nur für optionale Geohash-Kanäle, Mesh-Bridge-Zellen und Ortsbezeichnungen in der Nähe. Genaue Koordinaten werden nicht in Nachrichten eingefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat uses location only for optional geohash channels, mesh bridge cells, and nearby place labels. Exact coordinates are not included in messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa la ubicación solo para los canales geohash opcionales, las celdas de puente de la red mallada y las etiquetas de lugares cercanos. Las coordenadas exactas no se incluyen en los mensajes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat فقط برای کانال‌های اختیاری geohash، سلول‌های پل شبکهٔ مش و نام مکان‌های نزدیک از موقعیت مکانی استفاده می‌کند. مختصات دقیق در پیام‌ها قرار نمی‌گیرد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit lang ng MeshChat ang lokasyon para sa mga opsyonal na geohash channel, mesh bridge cell, at label ng mga kalapit na lugar. Hindi isinasama sa mga mensahe ang eksaktong coordinate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat utilise la localisation uniquement pour les canaux geohash facultatifs, les cellules de pont du réseau maillé et les libellés de lieux proches. Les coordonnées exactes ne sont pas incluses dans les messages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat משתמש במיקום רק עבור ערוצי geohash אופציונליים, תאי גישור של רשת Mesh ותוויות של מקומות בקרבת מקום. קואורדינטות מדויקות אינן נכללות בהודעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat स्थान का उपयोग केवल वैकल्पिक geohash चैनलों, मेश ब्रिज सेल और आस-पास के स्थानों के लेबल के लिए करता है। सटीक निर्देशांक संदेशों में शामिल नहीं किए जाते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan lokasi hanya untuk kanal geohash opsional, sel bridge mesh, dan label tempat di sekitar. Koordinat pasti tidak disertakan dalam pesan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa la posizione solo per i canali geohash facoltativi, le celle bridge della rete mesh e le etichette dei luoghi vicini. Le coordinate esatte non vengono incluse nei messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChatは、任意で利用するgeohashチャンネル、メッシュブリッジのセル、付近の場所名にのみ位置情報を使用します。正確な座標がメッセージに含まれることはありません。"
