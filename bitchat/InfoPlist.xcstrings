    "NSMicrophoneUsageDescription" : {
      "comment" : "Explains that microphone use is limited to voice-note recording and push-to-talk",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستخدم MeshChat الميكروفون إلا أثناء تسجيل ملاحظة صوتية أو استخدام ميزة اضغط للتحدث."
          }
        },
        "bn" : {
