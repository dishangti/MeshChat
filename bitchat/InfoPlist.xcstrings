    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Explains why the app uses Bluetooth to participate in the nearby mesh",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم MeshChat البلوتوث لاكتشاف الأجهزة المتوافقة القريبة والتواصل معها عبر الشبكة المتداخلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat কাছাকাছি থাকা সামঞ্জস্যপূর্ণ ডিভাইস খুঁজে পেতে এবং মেশ নেটওয়ার্কের মাধ্যমে সেগুলোর সঙ্গে যোগাযোগ করতে Bluetooth ব্যবহার করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat verwendet Bluetooth, um kompatible Geräte in der Nähe zu finden und über das Mesh mit ihnen zu kommunizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat uses Bluetooth to discover and communicate with nearby compatible devices over the mesh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa Bluetooth para descubrir dispositivos compatibles cercanos y comunicarse con ellos a través de la red mallada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat از بلوتوث برای یافتن دستگاه‌های سازگار نزدیک و ارتباط با آن‌ها از طریق شبکهٔ مش استفاده می‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ng MeshChat ang Bluetooth para tumuklas at makipag-ugnayan sa mga kalapit na compatible na device sa mesh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat utilise le Bluetooth pour détecter les appareils compatibles à proximité et communiquer avec eux via le réseau maillé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat משתמש ב-Bluetooth כדי לגלות מכשירים תואמים בקרבת מקום ולתקשר איתם דרך רשת Mesh."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat आस-पास के संगत डिवाइस खोजने और मेश के ज़रिए उनसे संचार करने के लिए Bluetooth का उपयोग करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan Bluetooth untuk menemukan dan berkomunikasi dengan perangkat kompatibel di sekitar melalui mesh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa il Bluetooth per rilevare dispositivi compatibili nelle vicinanze e comunicare con loro tramite la rete mesh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChatは、近くの対応デバイスを検出し、メッシュ経由で通信するためにBluetoothを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat은 주변의 호환 기기를 찾고 메시를 통해 통신하기 위해 Bluetooth를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan Bluetooth untuk menemui dan berkomunikasi dengan peranti serasi berdekatan melalui mesh."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat ले नजिकका मिल्दो उपकरण पत्ता लगाउन र मेशमार्फत तिनीसँग सञ्चार गर्न Bluetooth प्रयोग गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat gebruikt Bluetooth om compatibele apparaten in de buurt te vinden en ermee te communiceren via het meshnetwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat używa Bluetooth do wykrywania zgodnych urządzeń w pobliżu i komunikowania się z nimi przez sieć mesh."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MeshChat utiliza Bluetooth para encontrar dispositivos compatíveis por perto e comunicar com eles através da rede mesh."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MeshChat usa Bluetooth para encontrar dispositivos compatíveis próximos e se comunicar com eles pela rede mesh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat использует Bluetooth, чтобы находить совместимые устройства поблизости и связываться с ними через mesh-сеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat använder Bluetooth för att hitta kompatibla enheter i närheten och kommunicera med dem via mesh-nätverket."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat அருகிலுள்ள இணக்கமான சாதனங்களைக் கண்டறிந்து, மெஷ் வழியாக அவற்றுடன் தொடர்புகொள்ள Bluetooth-ஐப் பயன்படுத்துகிறது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat ใช้ Bluetooth เพื่อค้นหาและสื่อสารกับอุปกรณ์ที่รองรับซึ่งอยู่ใกล้เคียงผ่านเครือข่ายเมช"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat, yakındaki uyumlu aygıtları bulmak ve mesh üzerinden onlarla iletişim kurmak için Bluetooth kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat використовує Bluetooth, щоб знаходити сумісні пристрої поблизу та обмінюватися з ними даними через mesh-мережу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat قریبی مطابقت رکھنے والے آلات تلاش کرنے اور میش کے ذریعے ان سے رابطہ کرنے کے لیے Bluetooth استعمال کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat sử dụng Bluetooth để tìm và liên lạc với các thiết bị tương thích ở gần qua mạng mesh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat 使用蓝牙发现附近的兼容设备，并通过 Mesh 网络与其通信。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat 使用藍牙尋找附近的相容裝置，並透過 Mesh 網路與其通訊。"
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
      "comment" : "Explains why the app advertises this device as a Bluetooth peripheral",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم MeshChat الوضع الطرفي للبلوتوث لكي تتمكن الأجهزة المتوافقة القريبة من اكتشاف هذا الجهاز والاتصال به."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat Bluetooth পেরিফেরাল মোড ব্যবহার করে, যাতে কাছাকাছি সামঞ্জস্যপূর্ণ ডিভাইস এই ডিভাইসটি খুঁজে পেয়ে সংযোগ করতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat verwendet den Bluetooth-Peripheriemodus, damit kompatible Geräte in der Nähe dieses Gerät erkennen und sich damit verbinden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat uses Bluetooth peripheral mode so nearby compatible devices can discover and connect to this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa el modo periférico de Bluetooth para que los dispositivos compatibles cercanos puedan descubrir este dispositivo y conectarse a él."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat از حالت دستگاه جانبی بلوتوث استفاده می‌کند تا دستگاه‌های سازگار نزدیک بتوانند این دستگاه را پیدا کنند و به آن متصل شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ang MeshChat ng Bluetooth peripheral mode para matukoy at makakonekta sa device na ito ang mga kalapit na compatible na device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat utilise le mode périphérique Bluetooth afin que les appareils compatibles à proximité puissent détecter cet appareil et s’y connecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat משתמש במצב ציוד היקפי של Bluetooth כדי שמכשירים תואמים בקרבת מקום יוכלו לגלות את המכשיר הזה ולהתחבר אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat Bluetooth पेरिफ़ेरल मोड का उपयोग करता है, ताकि आस-पास के संगत डिवाइस इस डिवाइस को खोजकर इससे कनेक्ट हो सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan mode periferal Bluetooth agar perangkat kompatibel di sekitar dapat menemukan dan terhubung ke perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat usa la modalità periferica Bluetooth affinché i dispositivi compatibili nelle vicinanze possano rilevare questo dispositivo e connettersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChatはBluetoothのペリフェラルモードを使用し、近くの対応デバイスがこのデバイスを検出して接続できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat은 Bluetooth 주변기기 모드를 사용하여 주변의 호환 기기가 이 기기를 찾고 연결할 수 있게 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan mod persisian Bluetooth supaya peranti serasi berdekatan boleh menemui dan bersambung kepada peranti ini."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat ले Bluetooth पेरिफेरल मोड प्रयोग गर्छ, जसले नजिकका मिल्दो उपकरणलाई यो उपकरण पत्ता लगाउन र जडान गर्न दिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat gebruikt de perifere Bluetooth-modus zodat compatibele apparaten in de buurt dit apparaat kunnen vinden en ermee kunnen verbinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat używa trybu urządzenia peryferyjnego Bluetooth, aby zgodne urządzenia w pobliżu mogły wykryć to urządzenie i połączyć się z nim."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MeshChat utiliza o modo periférico de Bluetooth para que dispositivos compatíveis por perto possam detetar e ligar-se a este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MeshChat usa o modo periférico de Bluetooth para que dispositivos compatíveis próximos possam encontrar e se conectar a este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat использует режим периферийного устройства Bluetooth, чтобы совместимые устройства поблизости могли обнаружить это устройство и подключиться к нему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat använder Bluetooths kringutrustningsläge så att kompatibla enheter i närheten kan hitta och ansluta till den här enheten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அருகிலுள்ள இணக்கமான சாதனங்கள் இந்தச் சாதனத்தைக் கண்டறிந்து இணைவதற்காக MeshChat Bluetooth புறச்சாதனப் பயன்முறையைப் பயன்படுத்துகிறது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat ใช้โหมดอุปกรณ์ต่อพ่วง Bluetooth เพื่อให้อุปกรณ์ที่รองรับซึ่งอยู่ใกล้เคียงค้นพบและเชื่อมต่อกับอุปกรณ์นี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat, yakındaki uyumlu aygıtların bu aygıtı bulup bağlanabilmesi için Bluetooth çevre birimi modunu kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat використовує режим периферійного пристрою Bluetooth, щоб сумісні пристрої поблизу могли виявити цей пристрій і підключитися до нього."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat Bluetooth پیریفرل موڈ استعمال کرتا ہے تاکہ قریبی مطابقت رکھنے والے آلات اس آلے کو تلاش کر کے اس سے منسلک ہو سکیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat sử dụng chế độ ngoại vi Bluetooth để các thiết bị tương thích ở gần có thể tìm thấy và kết nối với thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat 使用蓝牙外设模式，让附近的兼容设备能够发现并连接到此设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat 使用藍牙周邊模式，讓附近的相容裝置能夠找到並連線到此裝置。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Explains camera use for adding and verifying friends by QR code and user-initiated photo capture",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم MeshChat الكاميرا لمسح رموز QR للتحقق من المستخدمين الآخرين والتقاط الصور التي تختار مشاركتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
