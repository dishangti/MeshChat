        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MeshChat menggunakan lokasi hanya untuk saluran geohash pilihan, sel jambatan mesh dan label tempat berdekatan. Koordinat tepat tidak disertakan dalam mesej."
