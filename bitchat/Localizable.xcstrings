    "meshchat.help.introduction": {
      "comment": "Short introduction at the top of the MeshChat help page",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تعرّف على كيفية اتصال MeshChat وتعرّفه على الأشخاص وإرسال التنبيهات وحماية خصوصيتك." } },
        "bn": { "stringUnit": { "state": "translated", "value": "MeshChat কীভাবে সংযোগ করে, মানুষকে শনাক্ত করে, সতর্কতা পাঠায় এবং আপনার গোপনীয়তা রক্ষা করে তা জানুন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erfahre, wie MeshChat Verbindungen herstellt, Personen erkennt, Hinweise zustellt und deine Privatsphäre schützt." } },
        "en": { "stringUnit": { "state": "translated", "value": "Learn how MeshChat connects, identifies people, delivers alerts, and protects your privacy." } },
        "es": { "stringUnit": { "state": "translated", "value": "Descubre cómo MeshChat se conecta, identifica a las personas, entrega avisos y protege tu privacidad." } },
        "fa": { "stringUnit": { "state": "translated", "value": "با نحوه اتصال MeshChat، شناسایی افراد، ارسال هشدارها و محافظت از حریم خصوصی خود آشنا شوید." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Alamin kung paano kumokonekta ang MeshChat, kumikilala ng mga tao, naghahatid ng alerto, at nagpoprotekta sa iyong privacy." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Découvre comment MeshChat se connecte, identifie les personnes, transmet les alertes et protège ta vie privée." } },
        "he": { "stringUnit": { "state": "translated", "value": "למדו כיצד MeshChat מתחבר, מזהה אנשים, מוסר התראות ומגן על הפרטיות שלכם." } },
        "hi": { "stringUnit": { "state": "translated", "value": "जानें कि MeshChat कैसे कनेक्ट होता है, लोगों की पहचान करता है, अलर्ट पहुँचाता है और आपकी गोपनीयता की रक्षा करता है।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pelajari cara MeshChat terhubung, mengenali orang, menyampaikan peringatan, dan melindungi privasi Anda." } },
        "it": { "stringUnit": { "state": "translated", "value": "Scopri come MeshChat si connette, identifica le persone, consegna gli avvisi e protegge la tua privacy." } },
        "ja": { "stringUnit": { "state": "translated", "value": "MeshChatの接続方法、相手の識別、通知、プライバシー保護について説明します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "MeshChat의 연결 방식, 사용자 식별, 알림 전송 및 개인정보 보호 방법을 알아보세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Ketahui cara MeshChat bersambung, mengenal pasti orang, menyampaikan amaran dan melindungi privasi anda." } },
        "ne": { "stringUnit": { "state": "translated", "value": "MeshChat कसरी जडान हुन्छ, व्यक्तिहरू पहिचान गर्छ, सूचनाहरू पुर्‍याउँछ र तपाईंको गोपनीयता जोगाउँछ भन्ने जान्नुहोस्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Lees hoe MeshChat verbinding maakt, personen herkent, meldingen bezorgt en je privacy beschermt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dowiedz się, jak MeshChat łączy się, rozpoznaje osoby, dostarcza powiadomienia i chroni prywatność." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Saiba como o MeshChat estabelece ligações, identifica pessoas, envia alertas e protege a sua privacidade." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Saiba como o MeshChat se conecta, identifica pessoas, envia alertas e protege sua privacidade." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Узнайте, как MeshChat подключается, распознаёт людей, доставляет уведомления и защищает вашу конфиденциальность." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Lär dig hur MeshChat ansluter, identifierar personer, levererar aviseringar och skyddar din integritet." } },
        "ta": { "stringUnit": { "state": "translated", "value": "MeshChat எவ்வாறு இணைகிறது, நபர்களை அடையாளம் காண்கிறது, அறிவிப்புகளை வழங்குகிறது மற்றும் உங்கள் தனியுரிமையைப் பாதுகாக்கிறது என்பதை அறியுங்கள்." } },
        "th": { "stringUnit": { "state": "translated", "value": "เรียนรู้วิธีที่ MeshChat เชื่อมต่อ ระบุตัวบุคคล ส่งการแจ้งเตือน และปกป้องความเป็นส่วนตัวของคุณ" } },
        "tr": { "stringUnit": { "state": "translated", "value": "MeshChat'in nasıl bağlandığını, kişileri tanıdığını, bildirimleri ilettiğini ve gizliliğinizi koruduğunu öğrenin." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Дізнайтеся, як MeshChat підключається, розпізнає людей, доставляє сповіщення та захищає вашу приватність." } },
        "ur": { "stringUnit": { "state": "translated", "value": "جانیں کہ MeshChat کیسے جڑتا، لوگوں کی شناخت کرتا، اطلاعات پہنچاتا اور آپ کی رازداری کی حفاظت کرتا ہے۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tìm hiểu cách MeshChat kết nối, nhận diện mọi người, gửi cảnh báo và bảo vệ quyền riêng tư của bạn." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "了解 MeshChat 如何建立连接、识别联系人、发送通知并保护你的隐私。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "瞭解 MeshChat 如何建立連線、識別聯絡人、傳送通知並保護你的隱私。" } }
      }
    },
    "meshchat.help.bridge.description": {
      "comment": "Help text explaining Mesh Bridge and the requirements for internet-only communication",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يربط Mesh Bridge المجموعات القريبة خارج نطاق Bluetooth عبر الإنترنت. عند إيقاف Bluetooth، يحتاج كل جهاز إلى الإنترنت وإذن الموقع، ويجب أن يكون الجهازان في المنطقة التقريبية نفسها أو منطقة مجاورة. عند توفر Bluetooth، يمكن لجهاز bridge قريب توفير المنطقة بدلًا من ذلك." } },
        "bn": { "stringUnit": { "state": "translated", "value": "Mesh Bridge Bluetooth-এর সীমার বাইরের কাছাকাছি গোষ্ঠীগুলোকে ইন্টারনেটের মাধ্যমে যুক্ত করে। Bluetooth বন্ধ থাকলে প্রতিটি ডিভাইসে ইন্টারনেট ও লোকেশন অনুমতি থাকতে হবে এবং দুজনকে একই বা পাশের আনুমানিক এলাকায় থাকতে হবে। Bluetooth চালু থাকলে কাছের bridge peer এলাকার তথ্য দিতে পারে।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Mesh Bridge verbindet nahe Gruppen außerhalb der Bluetooth-Reichweite über das Internet. Ist Bluetooth aus, braucht jedes Gerät Internet- und Standortzugriff; beide müssen sich im selben oder einem benachbarten ungefähren Gebiet befinden. Mit Bluetooth kann stattdessen ein naher Bridge-Peer das Gebiet bereitstellen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Mesh Bridge connects nearby groups beyond Bluetooth range through the internet. With Bluetooth off, each device needs internet and location access, and both must be in the same or a neighboring approximate area. With Bluetooth available, a nearby bridge peer can supply the area instead." } },
        "es": { "stringUnit": { "state": "translated", "value": "Mesh Bridge conecta por internet grupos cercanos fuera del alcance de Bluetooth. Con Bluetooth desactivado, cada dispositivo necesita internet y acceso a la ubicación, y ambos deben estar en la misma zona aproximada o en una contigua. Con Bluetooth disponible, un nodo puente cercano puede proporcionar la zona." } },
        "fa": { "stringUnit": { "state": "translated", "value": "Mesh Bridge گروه‌های نزدیک خارج از برد Bluetooth را از طریق اینترنت به هم متصل می‌کند. وقتی Bluetooth خاموش است، هر دستگاه به اینترنت و دسترسی مکان نیاز دارد و هر دو باید در یک محدوده تقریبی یا محدوده مجاور باشند. با در دسترس بودن Bluetooth، یک همتای bridge نزدیک می‌تواند محدوده را فراهم کند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Pinagdurugtong ng Mesh Bridge sa internet ang magkakalapit na grupo na lampas sa saklaw ng Bluetooth. Kapag naka-off ang Bluetooth, kailangan ng bawat device ang internet at location access, at dapat nasa pareho o magkatabing tinatayang area ang dalawa. Kapag may Bluetooth, maaaring ibigay ng kalapit na bridge peer ang area." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Mesh Bridge relie par internet les groupes proches situés hors de portée Bluetooth. Si le Bluetooth est désactivé, chaque appareil doit avoir internet et l'accès à la localisation, et les deux doivent se trouver dans la même zone approximative ou une zone voisine. Avec Bluetooth, un pair bridge proche peut fournir la zone à la place." } },
        "he": { "stringUnit": { "state": "translated", "value": "Mesh Bridge מחבר דרך האינטרנט קבוצות סמוכות שמעבר לטווח Bluetooth. כש-Bluetooth כבוי, כל מכשיר זקוק לאינטרנט ולהרשאת מיקום, ושניהם חייבים להיות באותו אזור משוער או באזור סמוך. כש-Bluetooth זמין, עמית bridge קרוב יכול לספק את האזור במקום זאת." } },
        "hi": { "stringUnit": { "state": "translated", "value": "Mesh Bridge Bluetooth की सीमा से बाहर के पास के समूहों को इंटरनेट से जोड़ता है। Bluetooth बंद होने पर हर डिवाइस को इंटरनेट और लोकेशन अनुमति चाहिए, और दोनों को एक ही या पड़ोसी अनुमानित क्षेत्र में होना चाहिए। Bluetooth उपलब्ध हो तो पास का bridge peer क्षेत्र की जानकारी दे सकता है।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Mesh Bridge menghubungkan grup terdekat di luar jangkauan Bluetooth melalui internet. Saat Bluetooth mati, setiap perangkat memerlukan internet dan akses lokasi, serta keduanya harus berada di area perkiraan yang sama atau bersebelahan. Saat Bluetooth tersedia, peer bridge terdekat dapat memberikan area tersebut." } },
        "it": { "stringUnit": { "state": "translated", "value": "Mesh Bridge collega tramite internet i gruppi vicini oltre la portata Bluetooth. Con Bluetooth disattivato, ogni dispositivo deve avere internet e accesso alla posizione, ed entrambi devono trovarsi nella stessa area approssimativa o in una confinante. Con Bluetooth disponibile, un peer bridge vicino può fornire l'area." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Mesh BridgeはBluetoothの届かない近くのグループをインターネット経由で接続します。Bluetoothをオフにする場合、各端末でインターネットと位置情報へのアクセスが必要で、双方が同じ、または隣接するおおよそのエリアにいる必要があります。Bluetoothが使える場合は、近くのbridge peerがエリア情報を提供できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Mesh Bridge는 Bluetooth 범위를 벗어난 가까운 그룹을 인터넷으로 연결합니다. Bluetooth가 꺼져 있으면 각 기기에 인터넷과 위치 접근 권한이 필요하며, 두 기기가 같거나 인접한 대략적 영역에 있어야 합니다. Bluetooth를 사용할 수 있으면 가까운 bridge peer가 영역 정보를 제공할 수 있습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Mesh Bridge menghubungkan kumpulan berdekatan di luar julat Bluetooth melalui internet. Apabila Bluetooth dimatikan, setiap peranti memerlukan internet dan akses lokasi, dan kedua-duanya mesti berada dalam kawasan anggaran yang sama atau bersebelahan. Apabila Bluetooth tersedia, peer bridge berdekatan boleh memberikan kawasan tersebut." } },
        "ne": { "stringUnit": { "state": "translated", "value": "Mesh Bridge ले Bluetooth दायराबाहिरका नजिकका समूहहरूलाई इन्टरनेटमार्फत जोड्छ। Bluetooth बन्द हुँदा हरेक उपकरणमा इन्टरनेट र स्थान पहुँच चाहिन्छ, र दुवै एउटै वा छिमेकी अनुमानित क्षेत्रमा हुनुपर्छ। Bluetooth उपलब्ध हुँदा नजिकको bridge peer ले क्षेत्र उपलब्ध गराउन सक्छ।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Mesh Bridge verbindt nabije groepen buiten Bluetooth-bereik via internet. Met Bluetooth uit heeft elk apparaat internet en locatietoegang nodig en moeten beide in hetzelfde of een aangrenzend globaal gebied zijn. Met Bluetooth kan een nabije bridgepeer het gebied doorgeven." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Mesh Bridge łączy przez internet pobliskie grupy poza zasięgiem Bluetooth. Przy wyłączonym Bluetooth każde urządzenie potrzebuje internetu i dostępu do lokalizacji, a oba muszą znajdować się w tym samym lub sąsiednim przybliżonym obszarze. Gdy Bluetooth jest dostępny, pobliski peer bridge może podać ten obszar." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O Mesh Bridge liga através da internet grupos próximos fora do alcance do Bluetooth. Com o Bluetooth desligado, cada dispositivo precisa de internet e acesso à localização, e ambos têm de estar na mesma área aproximada ou numa área vizinha. Com Bluetooth disponível, um peer bridge próximo pode fornecer a área." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O Mesh Bridge conecta pela internet grupos próximos fora do alcance do Bluetooth. Com o Bluetooth desligado, cada dispositivo precisa de internet e acesso à localização, e ambos devem estar na mesma área aproximada ou em uma área vizinha. Com Bluetooth disponível, um peer bridge próximo pode fornecer a área." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Mesh Bridge соединяет через интернет соседние группы за пределами действия Bluetooth. При выключенном Bluetooth каждому устройству нужны интернет и доступ к геопозиции, а оба должны находиться в одной или соседней примерной области. При доступном Bluetooth область может сообщить ближайший bridge-peer." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Mesh Bridge kopplar samman närliggande grupper utanför Bluetooth-räckvidd via internet. När Bluetooth är avstängt behöver varje enhet internet och platsåtkomst, och båda måste vara i samma eller ett angränsande ungefärligt område. Med Bluetooth kan en närliggande bridge-peer ange området." } },
        "ta": { "stringUnit": { "state": "translated", "value": "Mesh Bridge Bluetooth வரம்புக்கு அப்பாலுள்ள அருகிலுள்ள குழுக்களை இணையம் வழியாக இணைக்கிறது. Bluetooth முடக்கப்பட்டிருந்தால் ஒவ்வொரு சாதனத்திற்கும் இணையமும் இருப்பிட அணுகலும் தேவை; இரண்டும் ஒரே அல்லது அண்டைய தோராயமான பகுதியில் இருக்க வேண்டும். Bluetooth கிடைத்தால் அருகிலுள்ள bridge peer பகுதியை வழங்கலாம்." } },
        "th": { "stringUnit": { "state": "translated", "value": "Mesh Bridge เชื่อมกลุ่มใกล้เคียงที่อยู่นอกระยะ Bluetooth ผ่านอินเทอร์เน็ต เมื่อปิด Bluetooth อุปกรณ์แต่ละเครื่องต้องมีอินเทอร์เน็ตและสิทธิ์เข้าถึงตำแหน่ง และทั้งคู่ต้องอยู่ในพื้นที่โดยประมาณเดียวกันหรือพื้นที่ข้างเคียง เมื่อใช้ Bluetooth ได้ peer ที่เป็น bridge ใกล้เคียงสามารถให้ข้อมูลพื้นที่แทนได้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Mesh Bridge, Bluetooth menzili dışındaki yakındaki grupları internet üzerinden bağlar. Bluetooth kapalıyken her cihazın internete ve konum erişimine ihtiyacı vardır; ikisi de aynı veya komşu yaklaşık alanda olmalıdır. Bluetooth kullanılabiliyorsa yakındaki bir bridge peer alanı sağlayabilir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Mesh Bridge з’єднує через інтернет сусідні групи поза межами дії Bluetooth. Коли Bluetooth вимкнено, кожному пристрою потрібні інтернет і доступ до геопозиції, а обидва мають бути в одній або сусідній приблизній області. Коли Bluetooth доступний, область може надати найближчий bridge-peer." } },
        "ur": { "stringUnit": { "state": "translated", "value": "Mesh Bridge، Bluetooth کی حد سے باہر قریبی گروپس کو انٹرنیٹ کے ذریعے جوڑتا ہے۔ Bluetooth بند ہو تو ہر ڈیوائس کو انٹرنیٹ اور مقام کی اجازت درکار ہے، اور دونوں کا ایک ہی یا ملحقہ اندازاً علاقے میں ہونا ضروری ہے۔ Bluetooth دستیاب ہو تو قریبی bridge peer علاقے کی معلومات دے سکتا ہے۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mesh Bridge kết nối qua internet các nhóm gần nhau nhưng ngoài phạm vi Bluetooth. Khi tắt Bluetooth, mỗi thiết bị cần có internet và quyền truy cập vị trí, đồng thời cả hai phải ở cùng hoặc liền kề một khu vực gần đúng. Khi có Bluetooth, một peer bridge gần đó có thể cung cấp khu vực." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Mesh Bridge 通过互联网连接超出蓝牙范围的附近群体。关闭蓝牙时，每台设备都需要互联网和定位权限，而且双方必须位于同一或相邻的大致区域。蓝牙可用时，附近的 Bridge 节点也可以提供区域信息。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "Mesh Bridge 透過網際網路連接超出藍牙範圍的附近群體。關閉藍牙時，每部裝置都需要網際網路和定位權限，而且雙方必須位於相同或相鄰的大致區域。藍牙可用時，附近的 Bridge 節點也可以提供區域資訊。" } }
      }
    },
    "meshchat.help.recent.description": {
      "comment": "Help text explaining which people appear in Recent and how the list is sorted",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تعرض قائمة «الأخيرة» الأشخاص غير المتصلين الذين تحدثت معهم بشكل خاص ولم تضفهم كأصدقاء، مع عرض أحدث محادثة أولًا. اضغط على شخص لمتابعة الدردشة." } },
        "bn": { "stringUnit": { "state": "translated", "value": "Recent-এ সেই অফলাইন মানুষরা থাকে যাদের সঙ্গে আপনি ব্যক্তিগতভাবে কথা বলেছেন কিন্তু বন্ধু হিসেবে যোগ করেননি; সবচেয়ে নতুন কথোপকথন আগে থাকে। আবার চ্যাট করতে কাউকে ট্যাপ করুন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "„Zuletzt“ zeigt Offline-Personen, mit denen du privat geschrieben, die du aber nicht als Freunde hinzugefügt hast – neueste Unterhaltung zuerst. Tippe auf eine Person, um weiterzuschreiben." } },
        "en": { "stringUnit": { "state": "translated", "value": "Recent lists offline people you have privately chatted with but have not added as friends, newest conversation first. Tap a person to continue chatting." } },
        "es": { "stringUnit": { "state": "translated", "value": "Recientes muestra a las personas sin conexión con las que has hablado en privado pero que no has añadido como amigas, con la conversación más reciente primero. Toca a alguien para seguir chateando." } },
        "fa": { "stringUnit": { "state": "translated", "value": "بخش «اخیر» افراد آفلاینی را نشان می‌دهد که با آن‌ها گفت‌وگوی خصوصی داشته‌اید اما به دوستان اضافه نکرده‌اید؛ تازه‌ترین گفت‌وگو در بالا است. برای ادامه گفت‌وگو روی فرد بزنید." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Ipinapakita ng Recent ang mga offline na taong naka-private chat mo pero hindi mo pa idinagdag bilang kaibigan, na nauuna ang pinakabagong usapan. I-tap ang isang tao para magpatuloy." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Récents affiche les personnes hors ligne avec qui tu as discuté en privé sans les ajouter comme amis, la conversation la plus récente en premier. Touche une personne pour reprendre la discussion." } },
        "he": { "stringUnit": { "state": "translated", "value": "„אחרונים” מציג אנשים שאינם מחוברים וששוחחת איתם בפרטי אך לא הוספת כחברים, כשהשיחה החדשה ביותר ראשונה. הקישו על אדם כדי להמשיך לשוחח." } },
        "hi": { "stringUnit": { "state": "translated", "value": "Recent में वे ऑफ़लाइन लोग दिखते हैं जिनसे आपने निजी चैट की है लेकिन दोस्त नहीं बनाया है; सबसे नई बातचीत पहले आती है। चैट जारी रखने के लिए किसी व्यक्ति पर टैप करें।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Terbaru menampilkan orang offline yang pernah Anda ajak mengobrol pribadi tetapi belum ditambahkan sebagai teman, dengan percakapan terbaru di atas. Ketuk seseorang untuk melanjutkan obrolan." } },
        "it": { "stringUnit": { "state": "translated", "value": "Recenti mostra le persone offline con cui hai chattato in privato ma che non hai aggiunto come amici, partendo dalla conversazione più recente. Tocca una persona per continuare a chattare." } },
        "ja": { "stringUnit": { "state": "translated", "value": "「最近」には、個別チャットをしたものの友達には追加していないオフラインの相手が、新しい会話順に表示されます。相手をタップすると会話を続けられます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "최근 목록에는 비공개로 대화했지만 친구로 추가하지 않은 오프라인 사용자가 최신 대화순으로 표시됩니다. 사용자를 탭하면 대화를 이어갈 수 있습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Terbaharu menyenaraikan orang luar talian yang pernah anda sembang secara peribadi tetapi belum ditambah sebagai rakan, dengan perbualan terbaru dahulu. Ketik seseorang untuk meneruskan sembang." } },
        "ne": { "stringUnit": { "state": "translated", "value": "हालैमा तपाईंले निजी कुराकानी गरेका तर साथी नबनाएका अफलाइन व्यक्तिहरू सबैभन्दा नयाँ कुराकानी पहिले देखिन्छन्। कुराकानी जारी राख्न व्यक्तिलाई ट्याप गर्नुहोस्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Recent toont offline personen met wie je privé hebt gechat maar die je niet als vriend hebt toegevoegd, met het nieuwste gesprek bovenaan. Tik op iemand om verder te chatten." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ostatnie pokazuje osoby offline, z którymi prowadzono prywatny czat, ale których nie dodano do znajomych; najnowsza rozmowa jest pierwsza. Stuknij osobę, aby kontynuować czat." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Recentes apresenta pessoas offline com quem falou em privado mas que não adicionou como amigos, com a conversa mais recente primeiro. Toque numa pessoa para continuar a conversar." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Recentes mostra pessoas offline com quem você conversou em particular, mas não adicionou como amigas, com a conversa mais recente primeiro. Toque em alguém para continuar a conversa." } },
        "ru": { "stringUnit": { "state": "translated", "value": "В разделе «Недавние» показаны офлайн-пользователи, с которыми вы общались лично, но не добавили в друзья; новые беседы идут первыми. Нажмите на человека, чтобы продолжить чат." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Senaste visar offlinepersoner som du har chattat privat med men inte lagt till som vänner, med den senaste konversationen först. Tryck på en person för att fortsätta chatta." } },
        "ta": { "stringUnit": { "state": "translated", "value": "நீங்கள் தனிப்பட்ட முறையில் உரையாடிய, ஆனால் நண்பராகச் சேர்க்காத ஆஃப்லைன் நபர்களை சமீபத்திய உரையாடல் முதலில் வருமாறு Recent காட்டும். உரையாடலைத் தொடர ஒருவரைத் தட்டுங்கள்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ล่าสุดจะแสดงผู้ใช้ออฟไลน์ที่คุณเคยแชทส่วนตัวด้วยแต่ยังไม่ได้เพิ่มเป็นเพื่อน โดยเรียงบทสนทนาใหม่สุดก่อน แตะบุคคลเพื่อแชทต่อ" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Son Kullanılanlar, özel olarak sohbet ettiğiniz ancak arkadaş olarak eklemediğiniz çevrimdışı kişileri en yeni konuşma önce olacak şekilde listeler. Sohbete devam etmek için kişiye dokunun." } },
        "uk": { "stringUnit": { "state": "translated", "value": "У «Нещодавніх» показано офлайн-користувачів, з якими ви спілкувалися приватно, але не додали в друзі; нові розмови йдуть першими. Торкніться людини, щоб продовжити чат." } },
        "ur": { "stringUnit": { "state": "translated", "value": "Recent میں وہ آف لائن لوگ دکھائی دیتے ہیں جن سے آپ نے نجی گفتگو کی لیکن دوست کے طور پر شامل نہیں کیا، اور نئی گفتگو پہلے آتی ہے۔ بات جاری رکھنے کے لیے کسی شخص پر ٹیپ کریں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Gần đây liệt kê những người đang ngoại tuyến mà bạn đã trò chuyện riêng nhưng chưa thêm làm bạn, với cuộc trò chuyện mới nhất ở đầu. Chạm vào một người để tiếp tục trò chuyện." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "“最近”会按最新会话优先的顺序，显示你聊过私信、尚未添加为好友且当前离线的人。轻点联系人即可继续聊天。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "「最近」會按最新對話優先的順序，顯示你聊過私訊、尚未加入為好友且目前離線的人。點一下聯絡人即可繼續聊天。" } }
      }
    },
    "meshchat.help.friends.description": {
      "comment": "Help text distinguishing friends, local nicknames, and blocking",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إضافة صديق اختيارية ومنفصلة عن تعيين اسم مستعار محلي. يمكنك تسمية أي شخص معروف أو حظره؛ وتبقى الأسماء المستعارة المحلية على هذا الجهاز فقط." } },
        "bn": { "stringUnit": { "state": "translated", "value": "বন্ধু হিসেবে যোগ করা ঐচ্ছিক এবং স্থানীয় ডাকনাম দেওয়া থেকে আলাদা। পরিচিত যেকোনো ব্যক্তিকে ডাকনাম দিতে বা ব্লক করতে পারেন; স্থানীয় ডাকনাম শুধু এই ডিভাইসেই থাকে।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Jemanden als Freund hinzuzufügen ist optional und unabhängig von einem lokalen Spitznamen. Du kannst jede bekannte Person benennen oder blockieren; lokale Spitznamen bleiben nur auf diesem Gerät." } },
        "en": { "stringUnit": { "state": "translated", "value": "Adding a friend is optional and separate from assigning a local nickname. You can nickname or block any known person; local nicknames stay only on this device." } },
        "es": { "stringUnit": { "state": "translated", "value": "Añadir a alguien como amigo es opcional e independiente de asignarle un apodo local. Puedes poner un apodo o bloquear a cualquier persona conocida; los apodos locales solo permanecen en este dispositivo." } },
        "fa": { "stringUnit": { "state": "translated", "value": "افزودن دوست اختیاری و جدا از تعیین نام مستعار محلی است. می‌توانید برای هر فرد شناخته‌شده نام بگذارید یا او را مسدود کنید؛ نام‌های محلی فقط روی این دستگاه می‌مانند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Opsyonal ang pagdagdag ng kaibigan at hiwalay ito sa pagtakda ng lokal na palayaw. Maaari mong bigyan ng palayaw o i-block ang sinumang kilalang tao; sa device na ito lang nananatili ang mga lokal na palayaw." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ajouter un ami est facultatif et distinct de l'attribution d'un surnom local. Tu peux renommer ou bloquer toute personne connue ; les surnoms locaux restent uniquement sur cet appareil." } },
        "he": { "stringUnit": { "state": "translated", "value": "הוספת חבר היא אופציונלית ונפרדת מהגדרת כינוי מקומי. אפשר לתת כינוי או לחסום כל אדם מוכר; כינויים מקומיים נשארים רק במכשיר הזה." } },
        "hi": { "stringUnit": { "state": "translated", "value": "किसी को दोस्त बनाना वैकल्पिक है और स्थानीय उपनाम देने से अलग है। आप किसी भी ज्ञात व्यक्ति को उपनाम दे सकते हैं या ब्लॉक कर सकते हैं; स्थानीय उपनाम केवल इसी डिवाइस पर रहते हैं।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Menambahkan teman bersifat opsional dan terpisah dari pemberian nama panggilan lokal. Anda dapat memberi nama panggilan atau memblokir siapa pun yang dikenal; nama panggilan lokal hanya tersimpan di perangkat ini." } },
        "it": { "stringUnit": { "state": "translated", "value": "Aggiungere un amico è facoltativo e distinto dall'assegnazione di un soprannome locale. Puoi rinominare o bloccare qualsiasi persona nota; i soprannomi locali restano solo su questo dispositivo." } },
        "ja": { "stringUnit": { "state": "translated", "value": "友達への追加は任意で、ローカルのニックネーム設定とは別の操作です。既知の相手には誰でもニックネームを付けたりブロックしたりできます。ローカルのニックネームはこの端末にだけ保存されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "친구 추가는 선택 사항이며 로컬 별명 지정과 별개입니다. 알고 있는 누구에게나 별명을 지정하거나 차단할 수 있으며, 로컬 별명은 이 기기에만 저장됩니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Menambah rakan adalah pilihan dan berasingan daripada menetapkan nama panggilan tempatan. Anda boleh menamakan atau menyekat sesiapa yang dikenali; nama panggilan tempatan kekal pada peranti ini sahaja." } },
        "ne": { "stringUnit": { "state": "translated", "value": "साथी थप्नु ऐच्छिक हो र स्थानीय उपनाम राख्नुभन्दा अलग हो। तपाईं कुनै पनि परिचित व्यक्तिलाई उपनाम दिन वा ब्लक गर्न सक्नुहुन्छ; स्थानीय उपनाम यही उपकरणमा मात्र रहन्छ।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Een vriend toevoegen is optioneel en staat los van een lokale bijnaam. Je kunt elke bekende persoon een bijnaam geven of blokkeren; lokale bijnamen blijven alleen op dit apparaat." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dodanie znajomego jest opcjonalne i niezależne od nadania lokalnego pseudonimu. Każdej znanej osobie można nadać pseudonim lub ją zablokować; lokalne pseudonimy pozostają tylko na tym urządzeniu." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Adicionar um amigo é opcional e independente de atribuir uma alcunha local. Pode dar uma alcunha ou bloquear qualquer pessoa conhecida; as alcunhas locais ficam apenas neste dispositivo." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Adicionar um amigo é opcional e independente de definir um apelido local. Você pode dar um apelido ou bloquear qualquer pessoa conhecida; os apelidos locais ficam somente neste dispositivo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Добавлять человека в друзья необязательно, и это не связано с локальным псевдонимом. Любому известному человеку можно дать псевдоним или заблокировать его; локальные псевдонимы хранятся только на этом устройстве." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Det är valfritt att lägga till en vän och det är skilt från att ange ett lokalt smeknamn. Du kan ge smeknamn åt eller blockera alla kända personer; lokala smeknamn stannar bara på den här enheten." } },
        "ta": { "stringUnit": { "state": "translated", "value": "நண்பரைச் சேர்ப்பது விருப்பமானது; உள்ளூர் புனைப்பெயர் அமைப்பதிலிருந்து தனியானது. தெரிந்த எந்த நபருக்கும் புனைப்பெயர் வைக்கலாம் அல்லது தடுக்கலாம்; உள்ளூர் புனைப்பெயர்கள் இந்தச் சாதனத்தில் மட்டுமே இருக்கும்." } },
        "th": { "stringUnit": { "state": "translated", "value": "การเพิ่มเพื่อนเป็นตัวเลือกและแยกจากการตั้งชื่อเล่นในเครื่อง คุณตั้งชื่อเล่นหรือบล็อกบุคคลที่รู้จักได้ทุกคน โดยชื่อเล่นในเครื่องจะอยู่บนอุปกรณ์นี้เท่านั้น" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Arkadaş eklemek isteğe bağlıdır ve yerel takma ad vermekten ayrıdır. Tanınan herkese takma ad verebilir veya kişiyi engelleyebilirsiniz; yerel takma adlar yalnızca bu cihazda kalır." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Додавати людину в друзі необов’язково, і це не пов’язано з локальним псевдонімом. Будь-якій відомій людині можна дати псевдонім або заблокувати її; локальні псевдоніми зберігаються лише на цьому пристрої." } },
        "ur": { "stringUnit": { "state": "translated", "value": "کسی کو دوست بنانا اختیاری ہے اور مقامی عرف دینے سے الگ ہے۔ آپ کسی بھی معلوم شخص کو عرف دے یا بلاک کر سکتے ہیں؛ مقامی عرف صرف اسی ڈیوائس پر رہتے ہیں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thêm bạn là tùy chọn và tách biệt với việc đặt biệt danh cục bộ. Bạn có thể đặt biệt danh hoặc chặn bất kỳ người nào đã biết; biệt danh cục bộ chỉ lưu trên thiết bị này." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "添加好友是可选操作，与设置本地昵称相互独立。你可以为任何已知用户设置昵称或将其拉黑；本地昵称仅保存在这台设备上。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "加入好友是選用操作，與設定本機暱稱互相獨立。你可以為任何已知使用者設定暱稱或將其封鎖；本機暱稱只會儲存在這部裝置上。" } }
      }
    },
    "meshchat.help.qr.description": {
      "comment": "Help text explaining the global QR scanner and its relationship to friend and verification actions",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "استخدم الماسح العام للتعرّف على رمز QR من MeshChat. يمكن للمسح العثور على شخص، لكن إضافته كصديق والتحقق من تشفيره إجراءان منفصلان واختياريان." } },
        "bn": { "stringUnit": { "state": "translated", "value": "MeshChat QR কোড চিনতে সামগ্রিক স্ক্যানার ব্যবহার করুন। স্ক্যান করে কাউকে খুঁজে পাওয়া যায়, তবে বন্ধু হিসেবে যোগ করা ও তার এনক্রিপশন যাচাই করা আলাদা ও ঐচ্ছিক কাজ।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Nutze den allgemeinen Scanner, um einen MeshChat-QR-Code zu erkennen. Ein Scan kann eine Person finden; sie als Freund hinzuzufügen und ihre Verschlüsselung zu verifizieren sind jedoch getrennte, optionale Aktionen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Use the global scanner to recognize a MeshChat QR code. Scanning can find a person, but adding them as a friend and verifying their encryption are separate, optional actions." } },
        "es": { "stringUnit": { "state": "translated", "value": "Usa el escáner general para reconocer un código QR de MeshChat. Escanear puede encontrar a una persona, pero añadirla como amiga y verificar su cifrado son acciones separadas y opcionales." } },
        "fa": { "stringUnit": { "state": "translated", "value": "برای شناسایی کد QR مربوط به MeshChat از اسکنر سراسری استفاده کنید. اسکن می‌تواند فرد را پیدا کند، اما افزودن او به دوستان و تأیید رمزنگاری‌اش دو کار جدا و اختیاری هستند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Gamitin ang pangkalahatang scanner para makilala ang MeshChat QR code. Makakahanap ng tao ang pag-scan, pero magkahiwalay at opsyonal ang pagdagdag sa kanya bilang kaibigan at pag-verify ng kanyang encryption." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Utilise le scanner général pour reconnaître un code QR MeshChat. Le scan peut retrouver une personne, mais l'ajouter comme ami et vérifier son chiffrement sont deux actions distinctes et facultatives." } },
        "he": { "stringUnit": { "state": "translated", "value": "השתמשו בסורק הכללי כדי לזהות קוד QR של MeshChat. סריקה יכולה למצוא אדם, אך הוספתו כחבר ואימות ההצפנה שלו הן פעולות נפרדות ואופציונליות." } },
        "hi": { "stringUnit": { "state": "translated", "value": "MeshChat QR कोड पहचानने के लिए सामान्य स्कैनर का उपयोग करें। स्कैन से व्यक्ति मिल सकता है, लेकिन उसे दोस्त बनाना और उसके एन्क्रिप्शन को सत्यापित करना अलग और वैकल्पिक काम हैं।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan pemindai global untuk mengenali kode QR MeshChat. Pemindaian dapat menemukan seseorang, tetapi menambahkannya sebagai teman dan memverifikasi enkripsinya adalah tindakan terpisah dan opsional." } },
        "it": { "stringUnit": { "state": "translated", "value": "Usa lo scanner generale per riconoscere un codice QR MeshChat. La scansione può trovare una persona, ma aggiungerla come amico e verificarne la crittografia sono azioni separate e facoltative." } },
        "ja": { "stringUnit": { "state": "translated", "value": "共通スキャナーでMeshChatのQRコードを読み取れます。スキャンで相手を見つけられますが、友達への追加と暗号化の検証は、それぞれ別の任意操作です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "공용 스캐너로 MeshChat QR 코드를 인식할 수 있습니다. 스캔으로 사용자를 찾을 수 있지만 친구 추가와 암호화 확인은 서로 별개의 선택 작업입니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Gunakan pengimbas umum untuk mengenal pasti kod QR MeshChat. Imbasan boleh mencari seseorang, tetapi menambahnya sebagai rakan dan mengesahkan penyulitannya ialah tindakan berasingan dan pilihan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "MeshChat QR कोड पहिचान गर्न साझा स्क्यानर प्रयोग गर्नुहोस्। स्क्यानले व्यक्ति फेला पार्न सक्छ, तर साथी थप्नु र उसको इन्क्रिप्सन प्रमाणित गर्नु अलग र ऐच्छिक कार्य हुन्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Gebruik de algemene scanner om een MeshChat-QR-code te herkennen. Scannen kan iemand vinden, maar die persoon als vriend toevoegen en diens versleuteling verifiëren zijn afzonderlijke, optionele acties." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Użyj ogólnego skanera, aby rozpoznać kod QR MeshChat. Skanowanie może znaleźć osobę, ale dodanie jej do znajomych i weryfikacja szyfrowania to oddzielne, opcjonalne działania." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Use o leitor geral para reconhecer um código QR do MeshChat. A leitura pode encontrar uma pessoa, mas adicioná-la como amigo e verificar a respetiva encriptação são ações separadas e opcionais." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Use o leitor geral para reconhecer um código QR do MeshChat. A leitura pode encontrar uma pessoa, mas adicioná-la como amiga e verificar sua criptografia são ações separadas e opcionais." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Используйте общий сканер для распознавания QR-кода MeshChat. Сканирование может найти человека, но добавление в друзья и проверка его шифрования — отдельные необязательные действия." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Använd den allmänna skannern för att känna igen en MeshChat-QR-kod. Skanning kan hitta en person, men att lägga till personen som vän och verifiera krypteringen är separata, valfria åtgärder." } },
        "ta": { "stringUnit": { "state": "translated", "value": "MeshChat QR குறியீட்டை அறிய பொது ஸ்கேனரைப் பயன்படுத்துங்கள். ஸ்கேன் செய்வது ஒருவரைக் கண்டறியலாம்; ஆனால் அவரை நண்பராகச் சேர்ப்பதும் குறியாக்கத்தைச் சரிபார்ப்பதும் தனித்தனி, விருப்பமான செயல்கள்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ใช้เครื่องสแกนส่วนกลางเพื่ออ่าน QR ของ MeshChat การสแกนช่วยค้นหาบุคคลได้ แต่การเพิ่มเป็นเพื่อนและการยืนยันการเข้ารหัสเป็นการทำงานแยกกันและเลือกทำได้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "MeshChat QR kodunu tanımak için genel tarayıcıyı kullanın. Tarama bir kişiyi bulabilir; ancak arkadaş eklemek ve şifrelemesini doğrulamak ayrı, isteğe bağlı işlemlerdir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Скористайтеся загальним сканером, щоб розпізнати QR-код MeshChat. Сканування може знайти людину, але додавання в друзі та перевірка її шифрування — окремі необов’язкові дії." } },
        "ur": { "stringUnit": { "state": "translated", "value": "MeshChat QR کوڈ پہچاننے کے لیے عمومی اسکینر استعمال کریں۔ اسکین سے شخص مل سکتا ہے، لیکن اسے دوست بنانا اور اس کی انکرپشن کی تصدیق الگ اور اختیاری اقدامات ہیں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Dùng trình quét chung để nhận diện mã QR MeshChat. Việc quét có thể tìm một người, nhưng thêm họ làm bạn và xác minh mã hóa của họ là hai thao tác riêng biệt, không bắt buộc." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "使用全局扫码入口识别 MeshChat 二维码。扫码可以找到联系人，但添加好友和验证对方的加密身份是相互独立的可选操作。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "使用全域掃碼入口識別 MeshChat QR Code。掃碼可以找到聯絡人，但加入好友和驗證對方的加密身分是互相獨立的選用操作。" } }
      }
    },
    "meshchat.help.verification.description": {
      "comment": "Help text explaining Bitchat-compatible QR verification and permanent fingerprint-bound lock states",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "قارن البصمات أو أكمل تحدي QR المتوافق مع Bitchat عبر الاتصال المشفّر المباشر. الرمادي يعني غير موثّق، والأخضر موثّق. الأصفر يعني تسجيل تعارض منسوب إلى بصمة المفتاح الدقيقة، لا إلى معرّف النظير المؤقت. لا تمحوه الحركة العادية أو إعادة التحقق؛ إعادة ضبط الهوية تنشئ مفاتيح جديدة منفصلة تبدأ بالرمادي." } },
        "bn": { "stringUnit": { "state": "translated", "value": "ফিঙ্গারপ্রিন্ট তুলনা করুন বা সক্রিয় এনক্রিপ্টেড সংযোগে Bitchat-সামঞ্জস্যপূর্ণ QR চ্যালেঞ্জ সম্পন্ন করুন। ধূসর মানে যাচাইহীন, সবুজ মানে যাচাইকৃত। হলুদ মানে অস্থায়ী peer ID নয়, ঠিক ওই কী-ফিঙ্গারপ্রিন্টে নির্ভরযোগ্য দ্বন্দ্ব নথিভুক্ত হয়েছে। স্বাভাবিক ট্র্যাফিক বা পুনরায় যাচাই এটি মুছে না; পরিচয় রিসেট করলে নতুন পৃথক কী ধূসর অবস্থায় শুরু হয়।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Vergleiche Fingerabdrücke oder schließe die Bitchat-kompatible QR-Prüfung über die aktive verschlüsselte Verbindung ab. Grau bedeutet nicht verifiziert, Grün verifiziert. Gelb bedeutet, dass für genau diesen Schlüssel-Fingerabdruck – nicht für eine temporäre Peer-ID – ein zurechenbarer Konflikt gespeichert wurde. Normaler Verkehr und erneute Verifizierung löschen ihn nicht; ein Identitätsreset erzeugt separate neue Schlüssel, die grau beginnen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Compare fingerprints or complete the Bitchat-compatible QR challenge over the live encrypted link. Gray means unverified; green means verified. Yellow means an attributable conflict was recorded for that exact key fingerprint, not its temporary peer ID. Normal traffic and reverification never clear it; an identity reset creates separate new keys that start gray." } },
        "es": { "stringUnit": { "state": "translated", "value": "Compara las huellas o completa el desafío QR compatible con Bitchat mediante el enlace cifrado activo. Gris significa sin verificar y verde, verificado. Amarillo indica que se registró un conflicto atribuible a esa huella de clave exacta, no a su ID temporal. El tráfico normal y una nueva verificación no lo borran; restablecer la identidad crea claves nuevas e independientes que empiezan en gris." } },
        "fa": { "stringUnit": { "state": "translated", "value": "اثر انگشت‌ها را مقایسه کنید یا چالش QR سازگار با Bitchat را روی پیوند رمزگذاری‌شده فعال انجام دهید. خاکستری یعنی تأییدنشده و سبز یعنی تأییدشده. زرد یعنی برای همان اثر انگشت دقیق کلید، نه شناسه موقت همتا، تعارضی قابل انتساب ثبت شده است. ترافیک عادی یا تأیید دوباره آن را پاک نمی‌کند؛ بازنشانی هویت کلیدهای جداگانه جدیدی می‌سازد که خاکستری شروع می‌شوند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Ihambing ang mga fingerprint o kumpletuhin ang Bitchat-compatible QR challenge sa aktibong encrypted link. Gray ang hindi verified at green ang verified. Yellow kapag may naitalang maipapanagot na conflict sa eksaktong key fingerprint, hindi sa pansamantalang peer ID. Hindi ito inaalis ng normal na traffic o muling verification; gumagawa ang identity reset ng hiwalay na bagong keys na nagsisimulang gray." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Compare les empreintes ou termine le défi QR compatible avec Bitchat via la liaison chiffrée active. Gris signifie non vérifié, vert vérifié. Jaune signifie qu’un conflit attribuable a été enregistré pour cette empreinte de clé exacte, et non pour son ID temporaire. Le trafic normal et une nouvelle vérification ne l’effacent pas ; une réinitialisation d’identité crée de nouvelles clés distinctes qui commencent en gris." } },
        "he": { "stringUnit": { "state": "translated", "value": "השוו טביעות אצבע או השלימו את אתגר ה-QR התואם ל-Bitchat דרך החיבור המוצפן הפעיל. אפור פירושו לא מאומת וירוק מאומת. צהוב פירושו שנרשמה התנגשות שניתן לייחס לטביעת המפתח המדויקת, ולא למזהה עמית זמני. תעבורה רגילה או אימות מחדש אינם מוחקים אותה; איפוס זהות יוצר מפתחות חדשים ונפרדים שמתחילים באפור." } },
        "hi": { "stringUnit": { "state": "translated", "value": "फ़िंगरप्रिंट मिलाएँ या सक्रिय एन्क्रिप्टेड लिंक पर Bitchat-संगत QR चुनौती पूरी करें। धूसर का अर्थ अप्रमाणित और हरे का प्रमाणित है। पीला बताता है कि अस्थायी peer ID नहीं, उसी सटीक कुंजी फ़िंगरप्रिंट के लिए आरोपण योग्य विरोध दर्ज हुआ। सामान्य ट्रैफ़िक या पुनः सत्यापन इसे नहीं मिटाते; पहचान रीसेट अलग नई कुंजियाँ बनाता है जो धूसर से शुरू होती हैं।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Bandingkan sidik jari atau selesaikan tantangan QR yang kompatibel dengan Bitchat melalui tautan terenkripsi aktif. Abu-abu berarti belum diverifikasi dan hijau berarti terverifikasi. Kuning berarti konflik yang dapat diatribusikan tercatat untuk sidik jari kunci yang tepat, bukan ID peer sementara. Lalu lintas biasa atau verifikasi ulang tidak menghapusnya; reset identitas membuat kunci baru terpisah yang dimulai dari abu-abu." } },
        "it": { "stringUnit": { "state": "translated", "value": "Confronta le impronte o completa la verifica QR compatibile con Bitchat tramite il collegamento cifrato attivo. Grigio significa non verificato, verde verificato. Giallo indica un conflitto attribuibile registrato per l’esatta impronta della chiave, non per l’ID peer temporaneo. Il traffico normale e una nuova verifica non lo eliminano; il ripristino dell’identità crea nuove chiavi separate che iniziano in grigio." } },
        "ja": { "stringUnit": { "state": "translated", "value": "フィンガープリントを比較するか、現在の暗号化接続でBitchat互換のQRチャレンジを完了します。灰色は未検証、緑色は検証済みです。黄色は一時的なPeer IDではなく、その正確な鍵フィンガープリントに帰属可能な競合が記録されたことを示します。通常通信や再検証では消えず、IDをリセットすると別の新しい鍵が灰色から始まります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "지문을 비교하거나 현재 암호화 연결에서 Bitchat 호환 QR 확인을 완료하세요. 회색은 미확인, 초록색은 확인 완료입니다. 노란색은 임시 Peer ID가 아니라 정확한 키 지문에 귀속 가능한 충돌이 기록되었음을 뜻합니다. 일반 통신이나 재확인으로 지워지지 않으며, 신원 재설정은 회색으로 시작하는 별도의 새 키를 만듭니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Bandingkan cap jari atau lengkapkan cabaran QR serasi Bitchat melalui pautan disulitkan aktif. Kelabu bermaksud belum disahkan dan hijau bermaksud disahkan. Kuning bermaksud konflik yang boleh dikaitkan direkodkan pada cap jari kunci tepat itu, bukan ID rakan sementara. Trafik biasa atau pengesahan semula tidak memadamkannya; tetapan semula identiti menghasilkan kunci baharu berasingan yang bermula kelabu." } },
        "ne": { "stringUnit": { "state": "translated", "value": "फिङ्गरप्रिन्ट तुलना गर्नुहोस् वा सक्रिय इन्क्रिप्टेड लिङ्कमा Bitchat-संगत QR चुनौती पूरा गर्नुहोस्। खैरोले अप्रमाणित र हरियोले प्रमाणित जनाउँछ। पहेँलोले अस्थायी peer ID होइन, त्यही सटीक कुञ्जी फिङ्गरप्रिन्टमा जिम्मेवार ठहरिने द्वन्द्व रेकर्ड भएको जनाउँछ। सामान्य ट्राफिक वा पुनःप्रमाणीकरणले यसलाई हटाउँदैन; पहिचान रिसेटले खैरोबाट सुरु हुने अलग नयाँ कुञ्जी बनाउँछ।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Vergelijk vingerafdrukken of voltooi de Bitchat-compatibele QR-controle via de actieve versleutelde verbinding. Grijs betekent niet geverifieerd, groen geverifieerd. Geel betekent dat voor precies die sleutelvingerafdruk, niet voor een tijdelijke peer-ID, een toerekenbaar conflict is vastgelegd. Normaal verkeer en herverificatie wissen dit niet; een identiteitsreset maakt afzonderlijke nieuwe sleutels die grijs beginnen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Porównaj odciski lub ukończ zgodne z Bitchat wyzwanie QR przez aktywne szyfrowane połączenie. Szary oznacza brak weryfikacji, zielony — weryfikację. Żółty oznacza konflikt przypisany dokładnie do tego odcisku klucza, a nie do tymczasowego ID peera. Zwykły ruch ani ponowna weryfikacja go nie usuwają; reset tożsamości tworzy oddzielne nowe klucze zaczynające jako szare." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Compare as impressões digitais ou conclua o desafio QR compatível com Bitchat através da ligação encriptada ativa. Cinzento significa não verificado e verde verificado. Amarelo significa que foi registado um conflito atribuível à impressão exata dessa chave, não ao ID temporário. O tráfego normal e nova verificação não o apagam; repor a identidade cria chaves novas e separadas que começam a cinzento." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Compare as impressões digitais ou conclua o desafio QR compatível com Bitchat pelo vínculo criptografado ativo. Cinza significa não verificado e verde, verificado. Amarelo indica um conflito atribuível à impressão exata dessa chave, não ao ID temporário. Tráfego normal e nova verificação não o apagam; redefinir a identidade cria chaves novas e separadas que começam em cinza." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сравните отпечатки или выполните совместимую с Bitchat QR-проверку по активному зашифрованному соединению. Серый означает, что личность не проверена, зелёный — проверена. Жёлтый означает, что конфликт надёжно отнесён к точному отпечатку ключа, а не временному ID узла. Обычный трафик и повторная проверка его не удаляют; сброс личности создаёт отдельные новые ключи, начинающие с серого." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Jämför fingeravtryck eller slutför den Bitchat-kompatibla QR-kontrollen via den aktiva krypterade länken. Grått betyder overifierad och grönt verifierad. Gult betyder att en hänförbar konflikt registrerats för exakt det nyckelfingeravtrycket, inte ett tillfälligt peer-ID. Normal trafik och ny verifiering tar inte bort den; en identitetsåterställning skapar separata nya nycklar som börjar grå." } },
        "ta": { "stringUnit": { "state": "translated", "value": "கைரேகைகளை ஒப்பிடுங்கள் அல்லது செயலில் உள்ள மறைகுறியாக்க இணைப்பில் Bitchat-இணக்க QR சவாலை முடிக்கவும். சாம்பல் சரிபார்க்கப்படாதது, பச்சை சரிபார்க்கப்பட்டது. மஞ்சள் என்பது தற்காலிக peer ID-க்கு அல்ல, அந்தத் துல்லியமான சாவிக் கைரேகைக்கே பொறுப்புடன் இணைக்கப்பட்ட முரண்பாடு பதிவானது. இயல்பான போக்குவரத்து அல்லது மறுசரிபார்ப்பு இதை நீக்காது; அடையாள மீட்டமைப்பு சாம்பலாகத் தொடங்கும் தனிப் புதிய சாவிகளை உருவாக்கும்." } },
        "th": { "stringUnit": { "state": "translated", "value": "เปรียบเทียบลายนิ้วมือหรือทำคำท้า QR ที่เข้ากันได้กับ Bitchat ผ่านลิงก์เข้ารหัสที่ใช้งานอยู่ สีเทาหมายถึงยังไม่ยืนยัน สีเขียวหมายถึงยืนยันแล้ว สีเหลืองหมายถึงบันทึกข้อขัดแย้งที่ระบุแหล่งที่มาได้กับลายนิ้วมือของคีย์นั้นโดยตรง ไม่ใช่ Peer ID ชั่วคราว การสื่อสารปกติหรือยืนยันซ้ำจะไม่ลบสถานะนี้ การรีเซ็ตตัวตนจะสร้างคีย์ใหม่แยกต่างหากและเริ่มเป็นสีเทา" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Parmak izlerini karşılaştırın veya etkin şifreli bağlantı üzerinden Bitchat uyumlu QR doğrulamasını tamamlayın. Gri doğrulanmamış, yeşil doğrulanmış demektir. Sarı, geçici peer kimliğine değil tam o anahtar parmak izine atfedilebilen bir çakışma kaydedildiğini gösterir. Normal trafik ve yeniden doğrulama bunu temizlemez; kimlik sıfırlama gri başlayan ayrı yeni anahtarlar oluşturur." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Порівняйте відбитки або виконайте сумісну з Bitchat QR-перевірку через активне зашифроване з’єднання. Сірий означає неперевірену особу, зелений — перевірену. Жовтий означає, що конфлікт надійно віднесено до точного відбитка ключа, а не тимчасового ID вузла. Звичайний трафік і повторна перевірка його не стирають; скидання особи створює окремі нові ключі, що починають із сірого." } },
        "ur": { "stringUnit": { "state": "translated", "value": "فنگر پرنٹس کا موازنہ کریں یا فعال انکرپٹڈ لنک پر Bitchat سے مطابقت رکھنے والا QR چیلنج مکمل کریں۔ سرمئی غیر تصدیق شدہ اور سبز تصدیق شدہ ہے۔ پیلا بتاتا ہے کہ عارضی peer ID نہیں بلکہ اسی درست کلیدی فنگر پرنٹ کے لیے قابلِ نسبت تضاد درج ہوا۔ عام ٹریفک یا دوبارہ تصدیق اسے نہیں مٹاتی؛ شناخت ری سیٹ الگ نئی کلیدیں بناتا ہے جو سرمئی سے شروع ہوتی ہیں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "So sánh dấu vân tay hoặc hoàn tất thử thách QR tương thích Bitchat qua liên kết mã hóa đang hoạt động. Xám là chưa xác minh, xanh là đã xác minh. Vàng nghĩa là một xung đột có thể quy kết đã được ghi cho đúng dấu vân tay khóa đó, không phải ID ngang hàng tạm thời. Lưu lượng bình thường hay xác minh lại không xóa trạng thái này; đặt lại danh tính tạo bộ khóa mới riêng biệt bắt đầu ở màu xám." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请对比安全指纹，或通过当前加密连接完成兼容 Bitchat 的二维码挑战。灰色闭锁表示未验证，绿色表示已验证。黄色闭锁表示这个确切的密钥指纹（而非临时 Peer ID）已有可可靠归因的冲突记录。正常通信或重新验证都不会清除；对方重置身份后会生成一套独立的新密钥，并从灰色状态开始。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請比對安全指紋，或透過目前的加密連線完成相容 Bitchat 的 QR Code 挑戰。灰色閉鎖表示未驗證，綠色表示已驗證。黃色閉鎖表示這個確切的密鑰指紋（而非暫時 Peer ID）已有可可靠歸因的衝突記錄。正常通訊或重新驗證都不會清除；對方重設身分後會產生一套獨立的新密鑰，並從灰色狀態開始。" } }
      }
    },
    "identity.status.mismatch": {
      "comment": "Permanent yellow-lock status for an exact identity-key fingerprint with an attributable conflict",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تم تسجيل تعارض في مفتاح الهوية" } },
        "bn": { "stringUnit": { "state": "translated", "value": "পরিচয়-কী দ্বন্দ্ব নথিভুক্ত" } },
        "de": { "stringUnit": { "state": "translated", "value": "Identitätsschlüssel-Konflikt gespeichert" } },
        "en": { "stringUnit": { "state": "translated", "value": "Identity-key conflict recorded" } },
        "es": { "stringUnit": { "state": "translated", "value": "Conflicto de clave de identidad registrado" } },
        "fa": { "stringUnit": { "state": "translated", "value": "تعارض کلید هویت ثبت شد" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Naitala ang salungatan sa identity key" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Conflit de clé d’identité enregistré" } },
        "he": { "stringUnit": { "state": "translated", "value": "נרשמה התנגשות במפתח הזהות" } },
        "hi": { "stringUnit": { "state": "translated", "value": "पहचान-कुंजी विरोध दर्ज हुआ" } },
        "id": { "stringUnit": { "state": "translated", "value": "Konflik kunci identitas tercatat" } },
        "it": { "stringUnit": { "state": "translated", "value": "Conflitto della chiave identità registrato" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ID鍵の競合を記録済み" } },
        "ko": { "stringUnit": { "state": "translated", "value": "신원 키 충돌 기록됨" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Konflik kunci identiti direkodkan" } },
        "ne": { "stringUnit": { "state": "translated", "value": "पहिचान कुञ्जी द्वन्द्व रेकर्ड गरियो" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Conflict met identiteitssleutel vastgelegd" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zapisano konflikt klucza tożsamości" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Conflito de chave de identidade registado" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Conflito de chave de identidade registrado" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Зафиксирован конфликт ключа личности" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Konflikt för identitetsnyckel registrerad" } },
        "ta": { "stringUnit": { "state": "translated", "value": "அடையாளச் சாவி முரண்பாடு பதிவானது" } },
        "th": { "stringUnit": { "state": "translated", "value": "บันทึกข้อขัดแย้งของคีย์ตัวตนแล้ว" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Kimlik anahtarı çakışması kaydedildi" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Зафіксовано конфлікт ключа особи" } },
        "ur": { "stringUnit": { "state": "translated", "value": "شناختی کلید کا تضاد ریکارڈ ہوا" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đã ghi nhận xung đột khóa danh tính" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已记录身份密钥冲突" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "已記錄身分密鑰衝突" } }
      }
    },
    "meshchat.help.notifications.description": {
      "comment": "Help text explaining per-topic notification choices and temporary global pauses",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "في الإعدادات، اختر التنبيهات بشكل منفصل للرسائل الخاصة والمجموعات ونشاط mesh وقنوات #location وأحداث الأمان. يمكنك إيقاف كل التنبيهات مؤقتًا أو استئنافها في أي وقت." } },
        "bn": { "stringUnit": { "state": "translated", "value": "Settings-এ ব্যক্তিগত/গ্রুপ বার্তা, mesh কার্যকলাপ, #location চ্যানেল ও নিরাপত্তা ঘটনার সতর্কতা আলাদাভাবে বেছে নিন। সব সতর্কতা সাময়িকভাবে বন্ধ করুন বা যেকোনো সময় আবার চালু করুন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wähle in den Einstellungen Benachrichtigungen getrennt für private und Gruppennachrichten, Mesh-Aktivität, #location-Kanäle und Sicherheitsereignisse. Pausiere alle Hinweise vorübergehend oder setze sie jederzeit fort." } },
        "en": { "stringUnit": { "state": "translated", "value": "In Settings, choose alerts separately for private and group messages, mesh activity, #location channels, and security events. Pause all alerts temporarily or resume them at any time." } },
        "es": { "stringUnit": { "state": "translated", "value": "En Ajustes, elige por separado los avisos de mensajes privados y grupos, actividad mesh, canales #location y eventos de seguridad. Pausa todos los avisos temporalmente o reanúdalos cuando quieras." } },
        "fa": { "stringUnit": { "state": "translated", "value": "در تنظیمات، هشدارهای پیام‌های خصوصی و گروهی، فعالیت mesh، کانال‌های #location و رویدادهای امنیتی را جداگانه انتخاب کنید. همه هشدارها را موقتاً متوقف کنید یا هر زمان خواستید از سر بگیرید." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Sa Settings, piliin nang hiwalay ang mga alerto para sa private at group message, mesh activity, #location channel, at security event. Pansamantalang i-pause ang lahat ng alerto o ipagpatuloy anumang oras." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Dans Réglages, choisis séparément les alertes pour les messages privés et de groupe, l'activité mesh, les canaux #location et les événements de sécurité. Suspends toutes les alertes temporairement ou réactive-les à tout moment." } },
        "he": { "stringUnit": { "state": "translated", "value": "בהגדרות אפשר לבחור בנפרד התראות להודעות פרטיות וקבוצתיות, לפעילות mesh, לערוצי #location ולאירועי אבטחה. אפשר להשהות את כל ההתראות זמנית או לחדש אותן בכל עת." } },
        "hi": { "stringUnit": { "state": "translated", "value": "Settings में निजी और ग्रुप संदेशों, mesh गतिविधि, #location चैनलों और सुरक्षा घटनाओं के अलर्ट अलग-अलग चुनें। सभी अलर्ट कुछ समय के लिए रोकें या कभी भी फिर शुरू करें।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Di Pengaturan, pilih peringatan secara terpisah untuk pesan pribadi dan grup, aktivitas mesh, kanal #location, dan peristiwa keamanan. Jeda semua peringatan sementara atau lanjutkan kapan saja." } },
        "it": { "stringUnit": { "state": "translated", "value": "In Impostazioni, scegli separatamente gli avvisi per messaggi privati e di gruppo, attività mesh, canali #location ed eventi di sicurezza. Sospendi temporaneamente tutti gli avvisi o riattivali in qualsiasi momento." } },
        "ja": { "stringUnit": { "state": "translated", "value": "設定では、個別・グループメッセージ、meshのアクティビティ、#locationチャンネル、セキュリティイベントごとに通知を選べます。すべての通知を一時停止し、いつでも再開できます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "설정에서 비공개 및 그룹 메시지, mesh 활동, #location 채널, 보안 이벤트 알림을 각각 선택할 수 있습니다. 모든 알림을 일시 중지하거나 언제든 다시 시작할 수 있습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Dalam Tetapan, pilih amaran secara berasingan untuk mesej peribadi dan kumpulan, aktiviti mesh, saluran #location dan peristiwa keselamatan. Jeda semua amaran buat sementara atau sambung semula pada bila-bila masa." } },
        "ne": { "stringUnit": { "state": "translated", "value": "सेटिङमा निजी र समूह सन्देश, mesh गतिविधि, #location च्यानल र सुरक्षा घटनाका सूचनाहरू छुट्टाछुट्टै छान्नुहोस्। सबै सूचना अस्थायी रूपमा रोक्नुहोस् वा जुनसुकै बेला पुनः सुरु गर्नुहोस्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Kies in Instellingen afzonderlijk meldingen voor privé- en groepsberichten, mesh-activiteit, #location-kanalen en beveiligingsgebeurtenissen. Pauzeer alle meldingen tijdelijk of hervat ze op elk moment." } },
        "pl": { "stringUnit": { "state": "translated", "value": "W Ustawieniach wybierz osobno powiadomienia o wiadomościach prywatnych i grupowych, aktywności mesh, kanałach #location oraz zdarzeniach bezpieczeństwa. Wstrzymaj wszystkie alerty tymczasowo lub wznów je w dowolnej chwili." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Em Definições, escolha separadamente os alertas para mensagens privadas e de grupo, atividade mesh, canais #location e eventos de segurança. Pause todos os alertas temporariamente ou retome-os a qualquer momento." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Em Ajustes, escolha separadamente os alertas de mensagens privadas e em grupo, atividade mesh, canais #location e eventos de segurança. Pause todos os alertas temporariamente ou retome-os quando quiser." } },
        "ru": { "stringUnit": { "state": "translated", "value": "В Настройках отдельно выберите уведомления для личных и групповых сообщений, активности mesh, каналов #location и событий безопасности. Временно приостановите все уведомления или возобновите их в любой момент." } },
        "sv": { "stringUnit": { "state": "translated", "value": "I Inställningar väljer du aviseringar separat för privata meddelanden och gruppmeddelanden, mesh-aktivitet, #location-kanaler och säkerhetshändelser. Pausa alla aviseringar tillfälligt eller återuppta dem när som helst." } },
        "ta": { "stringUnit": { "state": "translated", "value": "அமைப்புகளில் தனிப்பட்ட மற்றும் குழுச் செய்திகள், mesh செயல்பாடு, #location சேனல்கள் மற்றும் பாதுகாப்பு நிகழ்வுகளுக்கான அறிவிப்புகளைத் தனித்தனியாகத் தேர்ந்தெடுக்கவும். அனைத்து அறிவிப்புகளையும் தற்காலிகமாக நிறுத்தலாம் அல்லது எப்போது வேண்டுமானாலும் மீண்டும் தொடங்கலாம்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ในตั้งค่า คุณเลือกการแจ้งเตือนแยกกันได้สำหรับข้อความส่วนตัวและกลุ่ม กิจกรรม mesh ช่อง #location และเหตุการณ์ความปลอดภัย พักการแจ้งเตือนทั้งหมดชั่วคราวหรือเปิดต่อได้ทุกเมื่อ" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Ayarlar'da özel ve grup mesajları, mesh etkinliği, #location kanalları ve güvenlik olayları için bildirimleri ayrı ayrı seçin. Tüm bildirimleri geçici olarak duraklatın veya istediğiniz zaman sürdürün." } },
        "uk": { "stringUnit": { "state": "translated", "value": "У Налаштуваннях окремо виберіть сповіщення для приватних і групових повідомлень, активності mesh, каналів #location та подій безпеки. Тимчасово призупиніть усі сповіщення або відновіть їх будь-коли." } },
        "ur": { "stringUnit": { "state": "translated", "value": "Settings میں نجی و گروپ پیغامات، mesh سرگرمی، #location چینلز اور سکیورٹی واقعات کی اطلاعات الگ الگ منتخب کریں۔ تمام اطلاعات عارضی طور پر روکیں یا کسی بھی وقت دوبارہ شروع کریں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trong Cài đặt, chọn riêng cảnh báo cho tin nhắn riêng và nhóm, hoạt động mesh, kênh #location và sự kiện bảo mật. Tạm dừng mọi cảnh báo hoặc tiếp tục bất cứ lúc nào." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "你可以在“设置”中分别选择是否接收私聊与群聊、Mesh 动态、#location 频道和安全事件通知，也可以暂时关闭所有通知并随时恢复。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "你可以在「設定」中分別選擇是否接收私訊與群組、Mesh 動態、#location 頻道和安全事件通知，也可以暫時關閉所有通知並隨時恢復。" } }
      }
    },
    "meshchat.help.privacy.description": {
      "comment": "Help text explaining what is private, what is public, and why Tor should remain enabled",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تستخدم الرسائل النصية الخاصة والمجموعات الخاصة تشفيرًا من طرف إلى طرف. قبل إرسال وسائط إلى عميل قديم لا يدعم الوسائط الخاصة المشفّرة، يحذّرك MeshChat من أن الملف لن يكون مشفّرًا من طرف إلى طرف ويطلب التأكيد. رسائل mesh العامة وقنوات #location مرئية للمشاركين. أبقِ Tor مفعّلًا لإخفاء عنوان IP الخاص بك عن مرحّلات الإنترنت." } },
        "bn": { "stringUnit": { "state": "translated", "value": "ব্যক্তিগত টেক্সট বার্তা ও ব্যক্তিগত গ্রুপ এন্ড-টু-এন্ড এনক্রিপশন ব্যবহার করে। এনক্রিপ্টেড ব্যক্তিগত মিডিয়া সমর্থন করে না এমন পুরোনো ক্লায়েন্টে মিডিয়া পাঠানোর আগে MeshChat জানায় যে ফাইলটি এন্ড-টু-এন্ড এনক্রিপ্টেড হবে না এবং আপনার সম্মতি চায়। প্রকাশ্য mesh ও #location চ্যানেলের বার্তা অংশগ্রহণকারীরা দেখতে পান। ইন্টারনেট relay থেকে আপনার IP লুকাতে Tor চালু রাখুন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Private Textnachrichten und private Gruppen nutzen Ende-zu-Ende-Verschlüsselung. Bevor Medien an einen älteren Client gesendet werden, der verschlüsselte private Medien nicht unterstützt, warnt MeshChat, dass die Datei nicht Ende-zu-Ende verschlüsselt sein wird, und bittet um Bestätigung. Öffentliche Mesh- und #location-Nachrichten sind für Teilnehmende sichtbar. Lass Tor aktiviert, um deine IP-Adresse vor Internet-Relays zu verbergen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Private text messages and private groups use end-to-end encryption. Before sending media to a legacy client that does not support encrypted private media, MeshChat warns that the file will not be end-to-end encrypted and asks for confirmation. Public mesh and #location channel messages are visible to participants. Keep Tor enabled to hide your IP address from internet relays." } },
        "es": { "stringUnit": { "state": "translated", "value": "Los mensajes de texto privados y los grupos privados usan cifrado de extremo a extremo. Antes de enviar contenido multimedia a un cliente antiguo que no admite contenido privado cifrado, MeshChat advierte que el archivo no tendrá cifrado de extremo a extremo y pide confirmación. Los mensajes del mesh público y de los canales #location son visibles para sus participantes. Mantén Tor activado para ocultar tu dirección IP a los relays de internet." } },
        "fa": { "stringUnit": { "state": "translated", "value": "پیام‌های متنی خصوصی و گروه‌های خصوصی از رمزنگاری سرتاسری استفاده می‌کنند. پیش از ارسال رسانه به یک کلاینت قدیمی که از رسانه خصوصی رمزگذاری‌شده پشتیبانی نمی‌کند، MeshChat هشدار می‌دهد که فایل سرتاسری رمزگذاری نخواهد شد و تأیید می‌خواهد. پیام‌های mesh عمومی و کانال‌های #location برای شرکت‌کنندگان قابل مشاهده‌اند. برای پنهان کردن نشانی IP خود از relayهای اینترنتی، Tor را روشن نگه دارید." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Gumagamit ng end-to-end encryption ang private text message at private group. Bago magpadala ng media sa lumang client na hindi sumusuporta sa encrypted private media, nagbababala ang MeshChat na hindi end-to-end encrypted ang file at humihingi ng kumpirmasyon. Nakikita ng mga kalahok ang public mesh at #location channel message. Panatilihing naka-on ang Tor para maitago ang iyong IP address sa mga internet relay." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les messages texte privés et les groupes privés utilisent le chiffrement de bout en bout. Avant d'envoyer un média à un ancien client qui ne prend pas en charge les médias privés chiffrés, MeshChat avertit que le fichier ne sera pas chiffré de bout en bout et demande confirmation. Les messages du mesh public et des canaux #location sont visibles par les participants. Garde Tor activé pour masquer ton adresse IP aux relais internet." } },
        "he": { "stringUnit": { "state": "translated", "value": "הודעות טקסט פרטיות וקבוצות פרטיות משתמשות בהצפנה מקצה לקצה. לפני שליחת מדיה ללקוח ישן שאינו תומך במדיה פרטית מוצפנת, MeshChat מזהיר שהקובץ לא יהיה מוצפן מקצה לקצה ומבקש אישור. הודעות mesh ציבוריות והודעות בערוצי #location גלויות למשתתפים. השאירו את Tor פעיל כדי להסתיר את כתובת ה-IP מממסרי אינטרנט." } },
        "hi": { "stringUnit": { "state": "translated", "value": "निजी टेक्स्ट संदेश और निजी ग्रुप एंड-टू-एंड एन्क्रिप्शन का उपयोग करते हैं। ऐसे पुराने क्लाइंट को मीडिया भेजने से पहले जो एन्क्रिप्टेड निजी मीडिया का समर्थन नहीं करता, MeshChat चेतावनी देता है कि फ़ाइल एंड-टू-एंड एन्क्रिप्टेड नहीं होगी और पुष्टि माँगता है। सार्वजनिक mesh और #location चैनल संदेश प्रतिभागियों को दिखाई देते हैं। इंटरनेट relay से अपना IP पता छिपाने के लिए Tor चालू रखें।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pesan teks pribadi dan grup privat memakai enkripsi ujung ke ujung. Sebelum mengirim media ke klien lama yang tidak mendukung media pribadi terenkripsi, MeshChat memperingatkan bahwa berkas tidak akan dienkripsi ujung ke ujung dan meminta konfirmasi. Pesan mesh publik dan kanal #location terlihat oleh peserta. Biarkan Tor aktif untuk menyembunyikan alamat IP Anda dari relay internet." } },
        "it": { "stringUnit": { "state": "translated", "value": "I messaggi di testo privati e i gruppi privati usano la cifratura end-to-end. Prima di inviare contenuti multimediali a un client precedente che non supporta contenuti privati cifrati, MeshChat avvisa che il file non sarà cifrato end-to-end e chiede conferma. I messaggi del mesh pubblico e dei canali #location sono visibili ai partecipanti. Mantieni Tor attivo per nascondere il tuo indirizzo IP ai relay internet." } },
        "ja": { "stringUnit": { "state": "translated", "value": "個別テキストメッセージと非公開グループはE2E暗号化されます。暗号化された個別メディアに対応していない旧クライアントへメディアを送る前に、ファイルがE2E暗号化されないことをMeshChatが警告し、確認を求めます。公開meshと#locationチャンネルのメッセージは参加者に表示されます。インターネットrelayからIPアドレスを隠すため、Torをオンにしてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "비공개 텍스트 메시지와 비공개 그룹은 종단 간 암호화를 사용합니다. 암호화된 비공개 미디어를 지원하지 않는 구형 클라이언트로 미디어를 보내기 전에 MeshChat은 파일이 종단 간 암호화되지 않는다고 경고하고 확인을 요청합니다. 공개 mesh 및 #location 채널 메시지는 참여자에게 표시됩니다. 인터넷 relay로부터 IP 주소를 숨기려면 Tor를 켜 두세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Mesej teks peribadi dan kumpulan peribadi menggunakan penyulitan hujung ke hujung. Sebelum menghantar media kepada klien lama yang tidak menyokong media peribadi disulitkan, MeshChat memberi amaran bahawa fail itu tidak akan disulitkan hujung ke hujung dan meminta pengesahan. Mesej mesh awam dan saluran #location boleh dilihat oleh peserta. Kekalkan Tor dihidupkan untuk menyembunyikan alamat IP anda daripada relay internet." } },
        "ne": { "stringUnit": { "state": "translated", "value": "निजी टेक्स्ट सन्देश र निजी समूहले अन्त्यदेखि अन्त्यसम्मको इन्क्रिप्सन प्रयोग गर्छन्। इन्क्रिप्टेड निजी मिडिया समर्थन नगर्ने पुरानो क्लाइन्टमा मिडिया पठाउनुअघि MeshChat ले फाइल अन्त्यदेखि अन्त्यसम्म इन्क्रिप्ट नहुने चेतावनी दिन्छ र पुष्टि माग्छ। सार्वजनिक mesh र #location च्यानलका सन्देश सहभागीहरूले देख्न सक्छन्। इन्टरनेट relay बाट आफ्नो IP ठेगाना लुकाउन Tor चालु राख्नुहोस्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Privétekstberichten en privégroepen gebruiken end-to-endversleuteling. Voordat media naar een oudere client worden gestuurd die geen versleutelde privémedia ondersteunt, waarschuwt MeshChat dat het bestand niet end-to-end versleuteld zal zijn en vraagt het om bevestiging. Berichten in de openbare mesh en #location-kanalen zijn zichtbaar voor deelnemers. Laat Tor ingeschakeld om je IP-adres voor internetrelays te verbergen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Prywatne wiadomości tekstowe i prywatne grupy używają szyfrowania end-to-end. Przed wysłaniem multimediów do starszego klienta, który nie obsługuje szyfrowanych prywatnych multimediów, MeshChat ostrzega, że plik nie będzie zaszyfrowany end-to-end, i prosi o potwierdzenie. Wiadomości publicznego mesh i kanałów #location są widoczne dla uczestników. Pozostaw Tor włączony, aby ukryć adres IP przed przekaźnikami internetowymi." } },
        "pt": { "stringUnit": { "state": "translated", "value": "As mensagens de texto privadas e os grupos privados usam encriptação ponto a ponto. Antes de enviar conteúdos multimédia para um cliente antigo que não suporta multimédia privada encriptada, o MeshChat avisa que o ficheiro não será encriptado ponto a ponto e pede confirmação. As mensagens do mesh público e dos canais #location são visíveis para os participantes. Mantenha o Tor ativado para ocultar o seu endereço IP dos relays da internet." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Mensagens de texto privadas e grupos privados usam criptografia de ponta a ponta. Antes de enviar mídia para um cliente antigo que não aceita mídia privada criptografada, o MeshChat avisa que o arquivo não terá criptografia de ponta a ponta e pede confirmação. As mensagens do mesh público e dos canais #location ficam visíveis aos participantes. Mantenha o Tor ativado para ocultar seu endereço IP dos relays da internet." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Личные текстовые сообщения и закрытые группы используют сквозное шифрование. Перед отправкой медиа устаревшему клиенту без поддержки зашифрованных личных медиа MeshChat предупреждает, что файл не будет защищён сквозным шифрованием, и просит подтверждение. Сообщения публичной mesh-сети и каналов #location видны участникам. Оставьте Tor включённым, чтобы скрыть свой IP-адрес от интернет-релеев." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Privata textmeddelanden och privata grupper använder totalsträckskryptering. Innan media skickas till en äldre klient som inte stöder krypterade privata media varnar MeshChat att filen inte kommer att vara totalsträckskrypterad och ber om bekräftelse. Meddelanden i offentlig mesh och #location-kanaler är synliga för deltagarna. Låt Tor vara aktiverat för att dölja din IP-adress för internetreläer." } },
        "ta": { "stringUnit": { "state": "translated", "value": "தனிப்பட்ட உரைச் செய்திகள் மற்றும் தனிப்பட்ட குழுக்கள் முனை முதல் முனை மறைகுறியாக்கத்தைப் பயன்படுத்துகின்றன. மறைகுறியாக்கப்பட்ட தனிப்பட்ட ஊடகத்தை ஆதரிக்காத பழைய கிளையண்டிற்கு ஊடகத்தை அனுப்பும் முன், கோப்பு முனை முதல் முனை மறைகுறியாக்கப்படாது என்று MeshChat எச்சரித்து உறுதிப்படுத்தலைக் கேட்கும். பொது mesh மற்றும் #location சேனல் செய்திகள் பங்கேற்பாளர்களுக்குத் தெரியும். இணைய relay-களிடமிருந்து உங்கள் IP முகவரியை மறைக்க Tor-ஐ இயக்கி வையுங்கள்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ข้อความตัวอักษรส่วนตัวและกลุ่มส่วนตัวใช้การเข้ารหัสแบบต้นทางถึงปลายทาง ก่อนส่งสื่อไปยังไคลเอนต์รุ่นเก่าที่ไม่รองรับสื่อส่วนตัวแบบเข้ารหัส MeshChat จะเตือนว่าไฟล์จะไม่ได้รับการเข้ารหัสแบบต้นทางถึงปลายทางและขอการยืนยัน ข้อความใน mesh สาธารณะและช่อง #location ผู้เข้าร่วมสามารถมองเห็นได้ โปรดเปิด Tor ไว้เพื่อซ่อนที่อยู่ IP จาก relay อินเทอร์เน็ต" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Özel metin mesajları ve özel gruplar uçtan uca şifreleme kullanır. Şifreli özel medyayı desteklemeyen eski bir istemciye medya göndermeden önce MeshChat dosyanın uçtan uca şifrelenmeyeceği konusunda uyarır ve onay ister. Herkese açık mesh ve #location kanalı mesajları katılımcılar tarafından görülebilir. IP adresinizi internet relay'lerinden gizlemek için Tor'u açık tutun." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Приватні текстові повідомлення та приватні групи використовують наскрізне шифрування. Перед надсиланням медіа застарілому клієнту без підтримки зашифрованих приватних медіа MeshChat попереджає, що файл не матиме наскрізного шифрування, і просить підтвердження. Повідомлення публічної mesh-мережі й каналів #location видимі учасникам. Залиште Tor увімкненим, щоб приховати свою IP-адресу від інтернет-релеїв." } },
        "ur": { "stringUnit": { "state": "translated", "value": "نجی متنی پیغامات اور نجی گروپس اینڈ ٹو اینڈ انکرپشن استعمال کرتے ہیں۔ ایسے پرانے کلائنٹ کو میڈیا بھیجنے سے پہلے جو انکرپٹڈ نجی میڈیا سپورٹ نہیں کرتا، MeshChat خبردار کرتا ہے کہ فائل اینڈ ٹو اینڈ انکرپٹڈ نہیں ہوگی اور تصدیق مانگتا ہے۔ عوامی mesh اور #location چینل کے پیغامات شرکاء کو نظر آتے ہیں۔ انٹرنیٹ relay سے اپنا IP پتہ چھپانے کے لیے Tor فعال رکھیں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tin nhắn văn bản riêng và nhóm riêng dùng mã hóa đầu cuối. Trước khi gửi nội dung đa phương tiện tới một ứng dụng cũ không hỗ trợ nội dung riêng được mã hóa, MeshChat cảnh báo rằng tệp sẽ không được mã hóa đầu cuối và yêu cầu xác nhận. Tin nhắn mesh công khai và kênh #location hiển thị với người tham gia. Hãy bật Tor để ẩn địa chỉ IP của bạn khỏi các relay internet." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "私聊文字消息和私密群聊采用端到端加密。向不支持私聊媒体加密的旧版客户端发送媒体前，MeshChat 会明确警告该文件不会经过端到端加密，并要求你确认。公共 Mesh 与 #location 频道的消息对参与者可见。请保持 Tor 开启，以免互联网 Relay 看到你的 IP 地址。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "私訊文字和私人群組採用端對端加密。向不支援私訊媒體加密的舊版用戶端傳送媒體前，MeshChat 會明確警告該檔案不會經過端對端加密，並要求你確認。公開 Mesh 與 #location 頻道的訊息會讓參與者看見。請保持 Tor 開啟，以免網際網路 Relay 看到你的 IP 位址。" } }
      }
    },
