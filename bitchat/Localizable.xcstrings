    "board.empty_subtitle": {
      "comment": "Subtitle shown when the board has no posts",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "ثبّت أول إشعار للأشخاص القريبين." } },
        "bn": { "stringUnit": { "state": "translated", "value": "আশেপাশের মানুষের জন্য প্রথম নোটিশটি পিন করুন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Hefte den ersten Hinweis für Menschen in der Nähe an." } },
        "en": { "stringUnit": { "state": "translated", "value": "Pin the first notice for people around here." } },
        "es": { "stringUnit": { "state": "translated", "value": "Fija el primer aviso para la gente de la zona." } },
        "fa": { "stringUnit": { "state": "translated", "value": "اولین اعلان را برای افراد نزدیک سنجاق کنید." } },
        "fil": { "stringUnit": { "state": "translated", "value": "I-pin ang unang abiso para sa mga tao sa paligid." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Épingle le premier avis pour les personnes à proximité." } },
        "he": { "stringUnit": { "state": "translated", "value": "נעצו את ההודעה הראשונה עבור אנשים בסביבה." } },
        "hi": { "stringUnit": { "state": "translated", "value": "आस-पास के लोगों के लिए पहली सूचना पिन करें।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sematkan pengumuman pertama untuk orang di sekitar sini." } },
        "it": { "stringUnit": { "state": "translated", "value": "Fissa il primo avviso per le persone qui vicino." } },
        "ja": { "stringUnit": { "state": "translated", "value": "近くの人向けに最初のお知らせを固定しましょう。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "주변 사람들을 위한 첫 공지를 고정하세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Sematkan notis pertama untuk orang di sekitar sini." } },
        "ne": { "stringUnit": { "state": "translated", "value": "वरपरका मानिसहरूका लागि पहिलो सूचना पिन गर्नुहोस्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Zet het eerste bericht vast voor mensen in de buurt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przypnij pierwsze ogłoszenie dla osób w pobliżu." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Afixa o primeiro aviso para as pessoas por perto." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Fixe o primeiro aviso para as pessoas por perto." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Закрепите первое объявление для людей поблизости." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Fäst det första anslaget för personer i närheten." } },
        "ta": { "stringUnit": { "state": "translated", "value": "அருகிலுள்ளவர்களுக்கான முதல் அறிவிப்பைப் பொருத்துங்கள்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ปักหมุดประกาศแรกสำหรับผู้คนในบริเวณนี้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Yakındaki kişiler için ilk duyuruyu sabitleyin." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Закріпіть перше оголошення для людей поблизу." } },
        "ur": { "stringUnit": { "state": "translated", "value": "آس پاس کے لوگوں کے لیے پہلی اطلاع پن کریں۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ghim thông báo đầu tiên cho những người quanh đây." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "为附近的人发布第一条置顶公告。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "為附近的人發布第一則置頂公告。" } }
      }
    },
