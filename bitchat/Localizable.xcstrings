          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте цю людину перед додаванням у друзі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوست بنانے سے پہلے اس شخص کو ان بلاک کریں۔"
