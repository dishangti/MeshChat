    "friends.add.nickname_optional_hint": {"comment":"Explains that the local nickname field is optional while adding a friend","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"اختياري. اتركه فارغًا لاستخدام الاسم الحالي."}},"bn":{"stringUnit":{"state":"translated","value":"ঐচ্ছিক। বর্তমান নাম ব্যবহার করতে ফাঁকা রাখুন।"}},"de":{"stringUnit":{"state":"translated","value":"Optional. Leer lassen, um den aktuellen Namen zu verwenden."}},"en":{"stringUnit":{"state":"translated","value":"Optional. Leave blank to use their current name."}},"es":{"stringUnit":{"state":"translated","value":"Opcional. Déjalo en blanco para usar su nombre actual."}},"fa":{"stringUnit":{"state":"translated","value":"اختیاری است. برای استفاده از نام فعلی خالی بگذارید."}},"fil":{"stringUnit":{"state":"translated","value":"Opsyonal. Iwanang blangko para gamitin ang kasalukuyang pangalan."}},"fr":{"stringUnit":{"state":"translated","value":"Facultatif. Laissez vide pour utiliser son nom actuel."}},"he":{"stringUnit":{"state":"translated","value":"אופציונלי. אפשר להשאיר ריק כדי להשתמש בשם הנוכחי."}},"hi":{"stringUnit":{"state":"translated","value":"वैकल्पिक। उनका मौजूदा नाम इस्तेमाल करने के लिए खाली छोड़ें।"}},"id":{"stringUnit":{"state":"translated","value":"Opsional. Biarkan kosong untuk memakai nama saat ini."}},"it":{"stringUnit":{"state":"translated","value":"Facoltativo. Lascia vuoto per usare il nome attuale."}},"ja":{"stringUnit":{"state":"translated","value":"任意です。空欄の場合は現在の名前を使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"선택 사항입니다. 비워 두면 현재 이름을 사용합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pilihan. Biarkan kosong untuk menggunakan nama semasa."}},"ne":{"stringUnit":{"state":"translated","value":"वैकल्पिक। हालको नाम प्रयोग गर्न खाली छोड्नुहोस्।"}},"nl":{"stringUnit":{"state":"translated","value":"Optioneel. Laat leeg om de huidige naam te gebruiken."}},"pl":{"stringUnit":{"state":"translated","value":"Opcjonalnie. Pozostaw puste, aby użyć obecnej nazwy."}},"pt":{"stringUnit":{"state":"translated","value":"Opcional. Deixe em branco para usar o nome atual."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Opcional. Deixe em branco para usar o nome atual."}},"ru":{"stringUnit":{"state":"translated","value":"Необязательно. Оставьте пустым, чтобы использовать текущее имя."}},"sv":{"stringUnit":{"state":"translated","value":"Valfritt. Lämna tomt för att använda det nuvarande namnet."}},"ta":{"stringUnit":{"state":"translated","value":"விருப்பமானது. தற்போதைய பெயரைப் பயன்படுத்த காலியாக விடவும்."}},"th":{"stringUnit":{"state":"translated","value":"ไม่บังคับ เว้นว่างเพื่อใช้ชื่อปัจจุบัน"}},"tr":{"stringUnit":{"state":"translated","value":"İsteğe bağlı. Mevcut adı kullanmak için boş bırakın."}},"uk":{"stringUnit":{"state":"translated","value":"Необов’язково. Залиште порожнім, щоб використовувати поточне ім’я."}},"ur":{"stringUnit":{"state":"translated","value":"اختیاری۔ موجودہ نام استعمال کرنے کے لیے خالی چھوڑ دیں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Không bắt buộc. Để trống để dùng tên hiện tại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选。留空则使用对方当前名称。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可選。留空則使用對方目前的名稱。"}}}},
