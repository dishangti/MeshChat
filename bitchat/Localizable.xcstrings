          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "گپ شپ کی گئی پڑوسیوں کی فہرستوں سے اندازہ (فی ہم منصب 10 تک) — آپ کی ڈیوائس نمایاں ہے"
