          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka tetapan untuk menghidupkan atau mematikan gateway"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे खोल्न वा बन्द गर्न सेटिङहरू खोल्छ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent instellingen om de gateway aan of uit te zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera ustawienia, aby włączyć lub wyłączyć bramę"
          }
        },
        "pt": {
