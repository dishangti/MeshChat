    "content.delivery.reason.legacy_media_consent_required": {
      "comment": "Failure reason when a legacy private-media send lacks per-send consent",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يلزم التأكيد قبل الإرسال دون تشفير شامل" } },
        "bn": { "stringUnit": { "state": "translated", "value": "প্রান্ত-থেকে-প্রান্ত এনক্রিপশন ছাড়া পাঠানোর আগে নিশ্চিতকরণ প্রয়োজন" } },
        "de": { "stringUnit": { "state": "translated", "value": "Vor dem Senden ohne Ende-zu-Ende-Verschlüsselung ist eine Bestätigung erforderlich" } },
        "en": { "stringUnit": { "state": "translated", "value": "Confirmation required before sending without end-to-end encryption" } },
        "es": { "stringUnit": { "state": "translated", "value": "Se requiere confirmación antes de enviar sin cifrado de extremo a extremo" } },
        "fa": { "stringUnit": { "state": "translated", "value": "پیش از ارسال بدون رمزگذاری سرتاسری تأیید لازم است" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Kailangan ng kumpirmasyon bago magpadala nang walang end-to-end encryption" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Confirmation requise avant l’envoi sans chiffrement de bout en bout" } },
        "he": { "stringUnit": { "state": "translated", "value": "נדרש אישור לפני שליחה ללא הצפנה מקצה לקצה" } },
        "hi": { "stringUnit": { "state": "translated", "value": "एंड-टू-एंड एन्क्रिप्शन के बिना भेजने से पहले पुष्टि आवश्यक है" } },
        "id": { "stringUnit": { "state": "translated", "value": "Konfirmasi diperlukan sebelum mengirim tanpa enkripsi end-to-end" } },
        "it": { "stringUnit": { "state": "translated", "value": "Conferma necessaria prima dell’invio senza crittografia end-to-end" } },
        "ja": { "stringUnit": { "state": "translated", "value": "エンドツーエンド暗号化なしで送信する前に確認が必要です" } },
        "ko": { "stringUnit": { "state": "translated", "value": "종단 간 암호화 없이 전송하기 전에 확인이 필요합니다" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Pengesahan diperlukan sebelum menghantar tanpa penyulitan hujung ke hujung" } },
        "ne": { "stringUnit": { "state": "translated", "value": "अन्त्यदेखि-अन्त्य इन्क्रिप्सनबिना पठाउनुअघि पुष्टि आवश्यक छ" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Bevestiging vereist vóór verzenden zonder end-to-end-encryptie" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przed wysłaniem bez szyfrowania end-to-end wymagane jest potwierdzenie" } },
        "pt": { "stringUnit": { "state": "translated", "value": "É necessária confirmação antes de enviar sem encriptação ponto a ponto" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "É necessária confirmação antes de enviar sem criptografia de ponta a ponta" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Требуется подтверждение перед отправкой без сквозного шифрования" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Bekräftelse krävs före sändning utan totalsträckskryptering" } },
        "ta": { "stringUnit": { "state": "translated", "value": "முனைமுதல் முனைவரை மறையாக்கமின்றி அனுப்புவதற்கு முன் உறுதிப்படுத்தல் தேவை" } },
        "th": { "stringUnit": { "state": "translated", "value": "ต้องยืนยันก่อนส่งโดยไม่มีการเข้ารหัสจากต้นทางถึงปลายทาง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Uçtan uca şifreleme olmadan göndermeden önce onay gerekli" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Потрібне підтвердження перед надсиланням без наскрізного шифрування" } },
        "ur": { "stringUnit": { "state": "translated", "value": "اینڈ ٹو اینڈ خفیہ کاری کے بغیر بھیجنے سے پہلے تصدیق ضروری ہے" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cần xác nhận trước khi gửi mà không có mã hóa đầu cuối" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "以非端到端加密方式发送前需要确认" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "使用非端對端加密傳送前需要確認" } }
      }
    },
