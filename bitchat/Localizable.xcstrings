    "system.mesh.blocked": {
      "comment": "System message shown when a mesh peer is blocked",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم حظر %@. لن تتلقى رسائل منه بعد الآن"
