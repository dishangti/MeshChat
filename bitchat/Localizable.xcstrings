          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "as notas dependem de relés geográficos. verifica a ligação e tenta de novo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "notas dependem de relays geográficos. verifique a conexão e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
