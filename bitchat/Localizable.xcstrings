    "content.delivery.reason.private_media_admission_expired": {
      "comment": "Failure reason when private-media admission expires before scheduling",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "انتهت مهلة نقل الوسائط قبل أن يبدأ" } },
        "bn": { "stringUnit": { "state": "translated", "value": "মিডিয়া স্থানান্তর শুরু হওয়ার আগেই সময় শেষ হয়েছে" } },
        "de": { "stringUnit": { "state": "translated", "value": "Zeitüberschreitung vor Beginn der Medienübertragung" } },
        "en": { "stringUnit": { "state": "translated", "value": "Media transfer timed out before it could start" } },
        "es": { "stringUnit": { "state": "translated", "value": "La transferencia multimedia agotó el tiempo antes de empezar" } },
        "fa": { "stringUnit": { "state": "translated", "value": "مهلت انتقال رسانه پیش از شروع پایان یافت" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Nag-time out ang paglilipat ng media bago ito makapagsimula" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le transfert du média a expiré avant de commencer" } },
        "he": { "stringUnit": { "state": "translated", "value": "הזמן להעברת המדיה פג לפני שהחלה" } },
        "hi": { "stringUnit": { "state": "translated", "value": "मीडिया ट्रांसफ़र शुरू होने से पहले समय समाप्त हो गया" } },
        "id": { "stringUnit": { "state": "translated", "value": "Transfer media kehabisan waktu sebelum dimulai" } },
        "it": { "stringUnit": { "state": "translated", "value": "Il trasferimento multimediale è scaduto prima di iniziare" } },
        "ja": { "stringUnit": { "state": "translated", "value": "メディア転送の開始前にタイムアウトしました" } },
        "ko": { "stringUnit": { "state": "translated", "value": "미디어 전송이 시작되기 전에 시간이 초과되었습니다" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Pemindahan media tamat masa sebelum sempat bermula" } },
        "ne": { "stringUnit": { "state": "translated", "value": "मिडिया स्थानान्तरण सुरु हुनुअघि समय सकियो" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Time-out voordat de mediaoverdracht kon beginnen" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Limit czasu transferu multimediów minął przed rozpoczęciem" } },
        "pt": { "stringUnit": { "state": "translated", "value": "A transferência multimédia expirou antes de começar" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A transferência de mídia expirou antes de começar" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Время передачи медиафайла истекло до её начала" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Tidsgränsen löpte ut innan medieöverföringen kunde starta" } },
        "ta": { "stringUnit": { "state": "translated", "value": "ஊடகப் பரிமாற்றம் தொடங்குவதற்கு முன் நேரம் முடிந்தது" } },
        "th": { "stringUnit": { "state": "translated", "value": "หมดเวลาก่อนเริ่มถ่ายโอนสื่อ" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Medya aktarımı başlayamadan zaman aşımına uğradı" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Час передавання медіафайла минув до початку" } },
        "ur": { "stringUnit": { "state": "translated", "value": "میڈیا منتقلی شروع ہونے سے پہلے وقت ختم ہو گیا" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Quá thời gian trước khi truyền nội dung đa phương tiện" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "媒体传输在开始前超时" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "媒體傳輸在開始前逾時" } }
      }
    },
    "content.delivery.reason.private_media_admission_full": {
      "comment": "Failure reason when too many private-media transfers await admission",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "توجد عمليات نقل وسائط كثيرة قيد الانتظار؛ حاول مجددًا بعد قليل" } },
        "bn": { "stringUnit": { "state": "translated", "value": "অনেক মিডিয়া স্থানান্তর অপেক্ষায় আছে; একটু পরে আবার চেষ্টা করুন" } },
        "de": { "stringUnit": { "state": "translated", "value": "Zu viele Medienübertragungen warten; bitte gleich erneut versuchen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Too many media transfers are waiting; try again shortly" } },
        "es": { "stringUnit": { "state": "translated", "value": "Hay demasiadas transferencias multimedia en espera; inténtalo de nuevo en breve" } },
        "fa": { "stringUnit": { "state": "translated", "value": "انتقال‌های رسانه‌ای زیادی در انتظارند؛ کمی بعد دوباره تلاش کنید" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Napakaraming paglilipat ng media ang naghihintay; subukan muli maya-maya" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Trop de transferts de médias sont en attente ; réessaie bientôt" } },
        "he": { "stringUnit": { "state": "translated", "value": "יותר מדי העברות מדיה ממתינות; נסו שוב בעוד זמן קצר" } },
        "hi": { "stringUnit": { "state": "translated", "value": "बहुत अधिक मीडिया ट्रांसफ़र प्रतीक्षा में हैं; थोड़ी देर में फिर प्रयास करें" } },
        "id": { "stringUnit": { "state": "translated", "value": "Terlalu banyak transfer media menunggu; coba lagi sebentar lagi" } },
        "it": { "stringUnit": { "state": "translated", "value": "Troppe trasmissioni multimediali in attesa; riprova tra poco" } },
        "ja": { "stringUnit": { "state": "translated", "value": "待機中のメディア転送が多すぎます。しばらくしてから再試行してください" } },
        "ko": { "stringUnit": { "state": "translated", "value": "대기 중인 미디어 전송이 너무 많습니다. 잠시 후 다시 시도하세요" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Terlalu banyak pemindahan media sedang menunggu; cuba lagi sebentar lagi" } },
        "ne": { "stringUnit": { "state": "translated", "value": "धेरै मिडिया स्थानान्तरण पर्खिरहेका छन्; केही बेरमा फेरि प्रयास गर्नुहोस्" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Er wachten te veel mediaoverdrachten; probeer het zo opnieuw" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zbyt wiele transferów multimediów oczekuje; spróbuj ponownie za chwilę" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Há demasiadas transferências multimédia em espera; tenta novamente em breve" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Há muitas transferências de mídia aguardando; tente novamente em instantes" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Слишком много передач медиафайлов ожидают; повторите попытку чуть позже" } },
        "sv": { "stringUnit": { "state": "translated", "value": "För många medieöverföringar väntar; försök igen om en stund" } },
        "ta": { "stringUnit": { "state": "translated", "value": "பல ஊடகப் பரிமாற்றங்கள் காத்திருக்கின்றன; சிறிது நேரத்தில் மீண்டும் முயலுங்கள்" } },
        "th": { "stringUnit": { "state": "translated", "value": "มีการถ่ายโอนสื่อรออยู่มากเกินไป โปรดลองอีกครั้งในอีกสักครู่" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Çok fazla medya aktarımı bekliyor; kısa süre sonra tekrar deneyin" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Забагато передавань медіафайлів очікують; повторіть спробу трохи пізніше" } },
        "ur": { "stringUnit": { "state": "translated", "value": "بہت زیادہ میڈیا منتقلیاں منتظر ہیں؛ تھوڑی دیر بعد دوبارہ کوشش کریں" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Có quá nhiều lượt truyền nội dung đa phương tiện đang chờ; hãy thử lại sau" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "等待中的媒体传输过多，请稍后重试" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "等待中的媒體傳輸過多，請稍後重試" } }
      }
    },
    "content.delivery.reason.private_media_downgrade_blocked": {
      "comment": "Failure reason when a peer that supported encrypted media appears to downgrade",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الوسائط المشفرة مطلوبة؛ اطلب من جهة الاتصال الترقية" } },
        "bn": { "stringUnit": { "state": "translated", "value": "এনক্রিপ্ট করা মিডিয়া প্রয়োজন; এই পরিচিতিকে আপগ্রেড করতে বলুন" } },
        "de": { "stringUnit": { "state": "translated", "value": "Verschlüsselte Medien erforderlich; bitte diesen Kontakt um ein Upgrade" } },
        "en": { "stringUnit": { "state": "translated", "value": "Encrypted media required; ask this contact to upgrade" } },
        "es": { "stringUnit": { "state": "translated", "value": "Se requieren archivos cifrados; pide a este contacto que actualice" } },
        "fa": { "stringUnit": { "state": "translated", "value": "رسانه رمزگذاری‌شده لازم است؛ از این مخاطب بخواهید ارتقا دهد" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Kailangan ang encrypted media; hilingin sa contact na ito na mag-upgrade" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Média chiffré requis ; demande à ce contact de mettre à jour son application" } },
        "he": { "stringUnit": { "state": "translated", "value": "נדרשת מדיה מוצפנת; בקשו מאיש הקשר לשדרג" } },
        "hi": { "stringUnit": { "state": "translated", "value": "एन्क्रिप्टेड मीडिया आवश्यक है; इस संपर्क से अपग्रेड करने को कहें" } },
        "id": { "stringUnit": { "state": "translated", "value": "Media terenkripsi diperlukan; minta kontak ini memperbarui aplikasi" } },
        "it": { "stringUnit": { "state": "translated", "value": "Contenuto multimediale crittografato richiesto; chiedi al contatto di aggiornare" } },
        "ja": { "stringUnit": { "state": "translated", "value": "暗号化メディアが必要です。この連絡先にアップグレードを依頼してください" } },
        "ko": { "stringUnit": { "state": "translated", "value": "암호화된 미디어가 필요합니다. 이 연락처에 업그레이드를 요청하세요" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Media disulitkan diperlukan; minta kenalan ini menaik taraf" } },
        "ne": { "stringUnit": { "state": "translated", "value": "इन्क्रिप्ट गरिएको मिडिया आवश्यक छ; यो सम्पर्कलाई अपग्रेड गर्न भन्नुहोस्" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Versleutelde media vereist; vraag deze contactpersoon om te upgraden" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Wymagane są zaszyfrowane multimedia; poproś ten kontakt o aktualizację" } },
        "pt": { "stringUnit": { "state": "translated", "value": "É necessário conteúdo multimédia encriptado; pede a este contacto para atualizar" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "É necessária mídia criptografada; peça a este contato para atualizar" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Требуются зашифрованные медиафайлы; попросите контакт обновить приложение" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Krypterad media krävs; be kontakten att uppgradera" } },
        "ta": { "stringUnit": { "state": "translated", "value": "மறையாக்கப்பட்ட ஊடகம் தேவை; இந்தத் தொடர்பை மேம்படுத்தச் சொல்லுங்கள்" } },
        "th": { "stringUnit": { "state": "translated", "value": "ต้องใช้สื่อที่เข้ารหัส โปรดขอให้ผู้ติดต่อนี้อัปเกรด" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Şifreli medya gerekli; bu kişiden yükseltme yapmasını isteyin" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Потрібні зашифровані медіафайли; попросіть контакт оновити застосунок" } },
        "ur": { "stringUnit": { "state": "translated", "value": "خفیہ کردہ میڈیا ضروری ہے؛ اس رابطے سے اپ گریڈ کرنے کو کہیں" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cần nội dung đa phương tiện được mã hóa; hãy đề nghị liên hệ này nâng cấp" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要加密媒体，请让该联系人升级客户端" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "需要加密媒體，請讓該聯絡人升級用戶端" } }
      }
    },
    "content.delivery.reason.private_media_too_many_fragments": {
      "comment": "Failure reason when private media exceeds the compatible fragment limit",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الملف أكبر مما يدعمه عميل جهة الاتصال (أكثر من 256 جزءًا شبكيًا)" } },
        "bn": { "stringUnit": { "state": "translated", "value": "এই পরিচিতির ক্লায়েন্টের জন্য ফাইলটি খুব বড় (২৫৬টির বেশি মেশ খণ্ড)" } },
        "de": { "stringUnit": { "state": "translated", "value": "Datei ist für den Client dieses Kontakts zu groß (mehr als 256 Mesh-Fragmente)" } },
        "en": { "stringUnit": { "state": "translated", "value": "File is too large for this contact's client (more than 256 mesh fragments)" } },
        "es": { "stringUnit": { "state": "translated", "value": "El archivo es demasiado grande para el cliente de este contacto (más de 256 fragmentos mesh)" } },
        "fa": { "stringUnit": { "state": "translated", "value": "فایل برای کارخواه این مخاطب بسیار بزرگ است (بیش از ۲۵۶ قطعه مش)" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Masyadong malaki ang file para sa client ng contact na ito (mahigit 256 mesh fragment)" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le fichier est trop volumineux pour le client de ce contact (plus de 256 fragments mesh)" } },
        "he": { "stringUnit": { "state": "translated", "value": "הקובץ גדול מדי עבור הלקוח של איש הקשר (יותר מ־256 מקטעי רשת)" } },
        "hi": { "stringUnit": { "state": "translated", "value": "इस संपर्क के क्लाइंट के लिए फ़ाइल बहुत बड़ी है (256 से अधिक मेश खंड)" } },
        "id": { "stringUnit": { "state": "translated", "value": "File terlalu besar untuk klien kontak ini (lebih dari 256 fragmen mesh)" } },
        "it": { "stringUnit": { "state": "translated", "value": "Il file è troppo grande per il client di questo contatto (oltre 256 frammenti mesh)" } },
        "ja": { "stringUnit": { "state": "translated", "value": "この連絡先のクライアントにはファイルが大きすぎます（256個を超えるメッシュ断片）" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 연락처의 클라이언트에서 처리하기에는 파일이 너무 큽니다(메시 조각 256개 초과)" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Fail terlalu besar untuk klien kenalan ini (lebih daripada 256 serpihan mesh)" } },
        "ne": { "stringUnit": { "state": "translated", "value": "यो सम्पर्कको क्लाइन्टका लागि फाइल धेरै ठूलो छ (२५६ भन्दा बढी मेस खण्ड)" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Bestand is te groot voor de client van deze contactpersoon (meer dan 256 meshfragmenten)" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Plik jest zbyt duży dla klienta tego kontaktu (ponad 256 fragmentów mesh)" } },
        "pt": { "stringUnit": { "state": "translated", "value": "O ficheiro é demasiado grande para o cliente deste contacto (mais de 256 fragmentos mesh)" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O arquivo é grande demais para o cliente deste contato (mais de 256 fragmentos mesh)" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Файл слишком велик для клиента этого контакта (более 256 mesh-фрагментов)" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Filen är för stor för kontaktens klient (fler än 256 meshfragment)" } },
        "ta": { "stringUnit": { "state": "translated", "value": "இந்தத் தொடர்பின் பயன்பாட்டிற்கு கோப்பு மிகப் பெரியது (256-க்கும் மேற்பட்ட மெஷ் துண்டுகள்)" } },
        "th": { "stringUnit": { "state": "translated", "value": "ไฟล์ใหญ่เกินไปสำหรับไคลเอนต์ของผู้ติดต่อนี้ (มากกว่า 256 ส่วนของเมช)" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Dosya bu kişinin istemcisi için çok büyük (256'dan fazla mesh parçası)" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Файл завеликий для клієнта цього контакту (понад 256 mesh-фрагментів)" } },
        "ur": { "stringUnit": { "state": "translated", "value": "فائل اس رابطے کے کلائنٹ کے لیے بہت بڑی ہے (256 سے زیادہ میش حصے)" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tệp quá lớn đối với ứng dụng của liên hệ này (hơn 256 mảnh mesh)" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "文件对于该联系人的客户端过大（超过 256 个 Mesh 分片）" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "檔案對該聯絡人的用戶端過大（超過 256 個 Mesh 分片）" } }
      }
    },
    "content.private_media.legacy_warning.message": {
      "comment": "Warning shown before sending private media without end-to-end encryption; %@ is the recipient name",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "عميل %@ لا يعلن دعمه للوسائط الخاصة المشفرة. سيُوقّع هذا الملف لكنه لن يكون مشفرًا من طرف إلى طرف، لذا يمكن لمرحّلات الشبكة رؤيته. هل تريد إرسال الملف رغم ذلك؟" } },
        "bn": { "stringUnit": { "state": "translated", "value": "%@-এর ক্লায়েন্ট এনক্রিপ্ট করা ব্যক্তিগত মিডিয়া সমর্থনের ঘোষণা দেয় না। ফাইলটি স্বাক্ষরিত হবে, তবে প্রান্ত-থেকে-প্রান্ত এনক্রিপ্ট করা হবে না, তাই মেশ রিলে এটি দেখতে পারবে। তবুও ফাইলটি পাঠাবেন?" } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Client von %@ unterstützt keine verschlüsselten privaten Medien. Diese Datei wird signiert, aber nicht Ende-zu-Ende verschlüsselt, sodass Mesh-Relays sie sehen können. Trotzdem senden?" } },
        "en": { "stringUnit": { "state": "translated", "value": "%@'s client does not advertise encrypted private media. This file will be signed but not end-to-end encrypted, so mesh relays can see it. Send this file anyway?" } },
        "es": { "stringUnit": { "state": "translated", "value": "El cliente de %@ no anuncia compatibilidad con archivos privados cifrados. Este archivo se firmará, pero no tendrá cifrado de extremo a extremo, por lo que los relés mesh podrán verlo. ¿Enviar de todos modos?" } },
        "fa": { "stringUnit": { "state": "translated", "value": "کارخواه %@ پشتیبانی از رسانه خصوصی رمزگذاری‌شده را اعلام نمی‌کند. این فایل امضا می‌شود اما رمزگذاری سرتاسری نخواهد داشت، بنابراین رله‌های مش می‌توانند آن را ببینند. با این حال ارسال شود؟" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Hindi ipinapahayag ng client ni %@ na sinusuportahan nito ang encrypted private media. Lalagdaan ang file pero hindi ito end-to-end encrypted, kaya makikita ito ng mga mesh relay. Ipadala pa rin?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le client de %@ n’annonce pas la prise en charge des médias privés chiffrés. Ce fichier sera signé, mais pas chiffré de bout en bout ; les relais mesh pourront donc le voir. L’envoyer quand même ?" } },
        "he": { "stringUnit": { "state": "translated", "value": "הלקוח של %@ אינו מצהיר על תמיכה במדיה פרטית מוצפנת. הקובץ ייחתם אך לא יוצפן מקצה לקצה, ולכן ממסרי הרשת יוכלו לראות אותו. לשלוח בכל זאת?" } },
        "hi": { "stringUnit": { "state": "translated", "value": "%@ का क्लाइंट एन्क्रिप्टेड निजी मीडिया समर्थन की घोषणा नहीं करता। फ़ाइल हस्ताक्षरित होगी, लेकिन एंड-टू-एंड एन्क्रिप्टेड नहीं होगी, इसलिए मेश रिले इसे देख सकते हैं। फिर भी भेजें?" } },
        "id": { "stringUnit": { "state": "translated", "value": "Klien %@ tidak menyatakan dukungan media pribadi terenkripsi. File ini akan ditandatangani tetapi tidak dienkripsi end-to-end, sehingga relai mesh dapat melihatnya. Tetap kirim?" } },
        "it": { "stringUnit": { "state": "translated", "value": "Il client di %@ non dichiara il supporto per i contenuti privati crittografati. Il file sarà firmato ma non crittografato end-to-end, quindi i relay mesh potranno vederlo. Inviarlo comunque?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@ のクライアントは暗号化されたプライベートメディアへの対応を通知していません。このファイルは署名されますがエンドツーエンド暗号化されないため、メッシュリレーから見えます。それでも送信しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@의 클라이언트가 암호화된 비공개 미디어 지원을 알리지 않습니다. 이 파일은 서명되지만 종단 간 암호화되지 않아 메시 릴레이에서 볼 수 있습니다. 그래도 전송할까요?" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Klien %@ tidak mengiklankan sokongan media peribadi disulitkan. Fail ini akan ditandatangani tetapi tidak disulitkan hujung ke hujung, jadi geganti mesh boleh melihatnya. Hantar juga?" } },
        "ne": { "stringUnit": { "state": "translated", "value": "%@ को क्लाइन्टले इन्क्रिप्ट गरिएको निजी मिडिया समर्थन जनाउँदैन। फाइलमा हस्ताक्षर हुनेछ तर अन्त्यदेखि-अन्त्य इन्क्रिप्ट हुने छैन, त्यसैले मेस रिलेहरूले यसलाई देख्न सक्छन्। तैपनि पठाउने?" } },
        "nl": { "stringUnit": { "state": "translated", "value": "De client van %@ meldt geen ondersteuning voor versleutelde privémedia. Dit bestand wordt ondertekend maar niet end-to-end versleuteld, zodat meshrelays het kunnen zien. Toch verzenden?" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Klient %@ nie zgłasza obsługi zaszyfrowanych prywatnych multimediów. Plik zostanie podpisany, ale nie będzie szyfrowany end-to-end, więc przekaźniki mesh będą mogły go zobaczyć. Wysłać mimo to?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "O cliente de %@ não anuncia suporte para conteúdo multimédia privado encriptado. O ficheiro será assinado, mas não terá encriptação ponto a ponto, pelo que os relays mesh poderão vê-lo. Enviar mesmo assim?" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O cliente de %@ não anuncia suporte a mídia privada criptografada. O arquivo será assinado, mas não terá criptografia de ponta a ponta, portanto os relays mesh poderão vê-lo. Enviar mesmo assim?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Клиент %@ не сообщает о поддержке зашифрованных личных медиафайлов. Файл будет подписан, но не защищён сквозным шифрованием, поэтому mesh-ретрансляторы смогут его увидеть. Всё равно отправить?" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Klienten för %@ anger inget stöd för krypterad privat media. Filen signeras men totalsträckskrypteras inte, så meshreläer kan se den. Skicka ändå?" } },
        "ta": { "stringUnit": { "state": "translated", "value": "%@-இன் பயன்பாடு மறையாக்கப்பட்ட தனிப்பட்ட ஊடக ஆதரவை அறிவிக்கவில்லை. கோப்பு கையொப்பமிடப்படும், ஆனால் முனைமுதல் முனைவரை மறையாக்கப்படாது; எனவே மெஷ் ரிலேக்கள் அதைப் பார்க்கலாம். இருந்தும் அனுப்பவா?" } },
        "th": { "stringUnit": { "state": "translated", "value": "ไคลเอนต์ของ %@ ไม่ได้ระบุว่ารองรับสื่อส่วนตัวที่เข้ารหัส ไฟล์นี้จะมีลายเซ็นแต่ไม่เข้ารหัสจากต้นทางถึงปลายทาง รีเลย์เมชจึงมองเห็นได้ ยังคงส่งหรือไม่" } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ istemcisi şifreli özel medya desteği bildirmiyor. Dosya imzalanacak ancak uçtan uca şifrelenmeyecek; bu nedenle mesh aktarıcıları dosyayı görebilir. Yine de gönderilsin mi?" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Клієнт %@ не повідомляє про підтримку зашифрованих приватних медіафайлів. Файл буде підписано, але не захищено наскрізним шифруванням, тому mesh-ретранслятори зможуть його бачити. Усе одно надіслати?" } },
        "ur": { "stringUnit": { "state": "translated", "value": "%@ کا کلائنٹ خفیہ کردہ نجی میڈیا کی معاونت ظاہر نہیں کرتا۔ فائل پر دستخط ہوں گے مگر یہ اینڈ ٹو اینڈ خفیہ نہیں ہوگی، اس لیے میش ریلے اسے دیکھ سکتے ہیں۔ پھر بھی بھیجیں؟" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Ứng dụng của %@ không thông báo hỗ trợ nội dung riêng tư được mã hóa. Tệp sẽ được ký nhưng không được mã hóa đầu cuối, nên các trạm chuyển tiếp mesh có thể xem được. Vẫn gửi?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 的客户端未表明支持加密私密媒体。该文件会被签名，但不会进行端到端加密，因此 Mesh 中继可以看到它。仍要发送吗？" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "%@ 的用戶端未表明支援加密私密媒體。該檔案會被簽署，但不會進行端對端加密，因此 Mesh 中繼可以看到它。仍要傳送嗎？" } }
      }
    },
    "content.private_media.legacy_warning.send": {
      "comment": "Confirmation action for sending a private-media file that mesh relays can see",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إرسال ملف مرئي" } },
        "bn": { "stringUnit": { "state": "translated", "value": "দৃশ্যমান ফাইল পাঠান" } },
        "de": { "stringUnit": { "state": "translated", "value": "Sichtbare Datei senden" } },
        "en": { "stringUnit": { "state": "translated", "value": "Send Visible File" } },
        "es": { "stringUnit": { "state": "translated", "value": "Enviar archivo visible" } },
        "fa": { "stringUnit": { "state": "translated", "value": "ارسال فایل قابل مشاهده" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Ipadala ang Nakikitang File" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Envoyer le fichier visible" } },
        "he": { "stringUnit": { "state": "translated", "value": "שליחת קובץ גלוי" } },
        "hi": { "stringUnit": { "state": "translated", "value": "दृश्यमान फ़ाइल भेजें" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kirim File Terlihat" } },
        "it": { "stringUnit": { "state": "translated", "value": "Invia file visibile" } },
        "ja": { "stringUnit": { "state": "translated", "value": "閲覧可能なファイルを送信" } },
        "ko": { "stringUnit": { "state": "translated", "value": "보이는 파일 전송" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Hantar Fail Terlihat" } },
        "ne": { "stringUnit": { "state": "translated", "value": "देखिने फाइल पठाउनुहोस्" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Zichtbaar bestand verzenden" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Wyślij widoczny plik" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Enviar ficheiro visível" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Enviar arquivo visível" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отправить видимый файл" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Skicka synlig fil" } },
        "ta": { "stringUnit": { "state": "translated", "value": "காணக்கூடிய கோப்பை அனுப்பு" } },
        "th": { "stringUnit": { "state": "translated", "value": "ส่งไฟล์ที่มองเห็นได้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Görünür Dosyayı Gönder" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Надіслати видимий файл" } },
        "ur": { "stringUnit": { "state": "translated", "value": "نظر آنے والی فائل بھیجیں" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Gửi tệp hiển thị" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "发送可见文件" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "傳送可見檔案" } }
      }
    },
    "content.private_media.legacy_warning.title": {
      "comment": "Title for the warning shown before sending private media without end-to-end encryption",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "الإرسال دون تشفير شامل؟" } },
        "bn": { "stringUnit": { "state": "translated", "value": "প্রান্ত-থেকে-প্রান্ত এনক্রিপশন ছাড়া পাঠাবেন?" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ohne Ende-zu-Ende-Verschlüsselung senden?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Send without end-to-end encryption?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Enviar sin cifrado de extremo a extremo?" } },
        "fa": { "stringUnit": { "state": "translated", "value": "بدون رمزگذاری سرتاسری ارسال شود؟" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Ipadala nang walang end-to-end encryption?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Envoyer sans chiffrement de bout en bout ?" } },
        "he": { "stringUnit": { "state": "translated", "value": "לשלוח ללא הצפנה מקצה לקצה?" } },
        "hi": { "stringUnit": { "state": "translated", "value": "एंड-टू-एंड एन्क्रिप्शन के बिना भेजें?" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kirim tanpa enkripsi end-to-end?" } },
        "it": { "stringUnit": { "state": "translated", "value": "Inviare senza crittografia end-to-end?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "エンドツーエンド暗号化なしで送信しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "종단 간 암호화 없이 전송할까요?" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Hantar tanpa penyulitan hujung ke hujung?" } },
        "ne": { "stringUnit": { "state": "translated", "value": "अन्त्यदेखि-अन्त्य इन्क्रिप्सनबिना पठाउने?" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Verzenden zonder end-to-end-encryptie?" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Wysłać bez szyfrowania end-to-end?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Enviar sem encriptação ponto a ponto?" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Enviar sem criptografia de ponta a ponta?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отправить без сквозного шифрования?" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Skicka utan totalsträckskryptering?" } },
        "ta": { "stringUnit": { "state": "translated", "value": "முனைமுதல் முனைவரை மறையாக்கமின்றி அனுப்பவா?" } },
        "th": { "stringUnit": { "state": "translated", "value": "ส่งโดยไม่มีการเข้ารหัสจากต้นทางถึงปลายทางหรือไม่" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Uçtan uca şifreleme olmadan gönderilsin mi?" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Надіслати без наскрізного шифрування?" } },
        "ur": { "stringUnit": { "state": "translated", "value": "اینڈ ٹو اینڈ خفیہ کاری کے بغیر بھیجیں؟" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Gửi mà không có mã hóa đầu cuối?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "不使用端到端加密发送？" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "不使用端對端加密傳送？" } }
      }
    },
    "app_info.settings.outer_proxy.subtitle_apple": {"comment":"Description of how the outer proxy and optional Tor routing are ordered on Apple platforms","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يوجّه حركة المرحّلات عبر توجيه النظام أو وكيل مخصّص. المسار: الوكيل ← Tor اختياري ← المرحّل، لذلك يبقى الوكيل خارج Tor."}},"bn":{"stringUnit":{"state":"translated","value":"রিলে ট্রাফিক সিস্টেম রাউটিং বা কাস্টম প্রক্সির মাধ্যমে পাঠায়। পথ: প্রক্সি → ঐচ্ছিক Tor → রিলে, তাই প্রক্সি Tor-এর বাইরে থাকে।"}},"de":{"stringUnit":{"state":"translated","value":"Leitet Relay-Datenverkehr über die Systemroute oder einen eigenen Proxy. Pfad: Proxy → optional Tor → Relay; der Proxy bleibt außerhalb von Tor."}},"en":{"stringUnit":{"state":"translated","value":"Routes relay traffic through system routing or a custom proxy. The path is Proxy → optional Tor → relay, so turning Tor on still keeps this proxy on the outside."}},"es":{"stringUnit":{"state":"translated","value":"Enruta el tráfico de los relays mediante el sistema o un proxy personalizado. Ruta: proxy → Tor opcional → relay; el proxy permanece fuera de Tor."}},"fa":{"stringUnit":{"state":"translated","value":"ترافیک رله را از مسیر سیستم یا پراکسی سفارشی عبور می‌دهد. مسیر: پراکسی ← Tor اختیاری ← رله؛ پس پراکسی بیرون از Tor می‌ماند."}},"fil":{"stringUnit":{"state":"translated","value":"Dinadaan ang relay traffic sa system routing o custom proxy. Landas: Proxy → opsyonal na Tor → relay, kaya nananatili ang proxy sa labas ng Tor."}},"fr":{"stringUnit":{"state":"translated","value":"Achemine le trafic des relais via le routage système ou un proxy personnalisé. Chemin : proxy → Tor facultatif → relais ; le proxy reste à l’extérieur de Tor."}},"he":{"stringUnit":{"state":"translated","value":"מנתב תעבורת ממסרים דרך ניתוב המערכת או מתווך מותאם. הנתיב: מתווך ← Tor אופציונלי ← ממסר, ולכן המתווך נשאר מחוץ ל‑Tor."}},"hi":{"stringUnit":{"state":"translated","value":"रिले ट्रैफ़िक को सिस्टम रूटिंग या कस्टम प्रॉक्सी से भेजता है। रास्ता: प्रॉक्सी → वैकल्पिक Tor → रिले, इसलिए प्रॉक्सी Tor के बाहर रहता है।"}},"id":{"stringUnit":{"state":"translated","value":"Merutekan lalu lintas relay melalui perutean sistem atau proxy khusus. Jalur: Proxy → Tor opsional → relay, sehingga proxy tetap berada di luar Tor."}},"it":{"stringUnit":{"state":"translated","value":"Instrada il traffico dei relay tramite il sistema o un proxy personalizzato. Percorso: proxy → Tor facoltativo → relay; il proxy resta all’esterno di Tor."}},"ja":{"stringUnit":{"state":"translated","value":"リレー通信をシステム経路またはカスタムプロキシ経由にします。経路は「プロキシ → 任意のTor → リレー」で、プロキシはTorの外側にあります。"}},"ko":{"stringUnit":{"state":"translated","value":"릴레이 트래픽을 시스템 경로 또는 사용자 지정 프록시로 보냅니다. 경로는 프록시 → 선택적 Tor → 릴레이이므로 프록시는 Tor 바깥쪽에 유지됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Menghalakan trafik relay melalui penghalaan sistem atau proksi tersuai. Laluan: Proksi → Tor pilihan → relay, jadi proksi kekal di luar Tor."}},"ne":{"stringUnit":{"state":"translated","value":"रिले ट्राफिकलाई प्रणाली रुटिङ वा आफ्नै प्रोक्सीमार्फत पठाउँछ। बाटो: प्रोक्सी → वैकल्पिक Tor → रिले, त्यसैले प्रोक्सी Tor बाहिर रहन्छ।"}},"nl":{"stringUnit":{"state":"translated","value":"Leidt relayverkeer via de systeemroute of een aangepaste proxy. Pad: proxy → optioneel Tor → relay; de proxy blijft buiten Tor."}},"pl":{"stringUnit":{"state":"translated","value":"Kieruje ruch przekaźników przez trasę systemową lub własny serwer proxy. Ścieżka: proxy → opcjonalnie Tor → przekaźnik, więc proxy pozostaje na zewnątrz Tor."}},"pt":{"stringUnit":{"state":"translated","value":"Encaminha o tráfego dos relays pelo sistema ou por um proxy personalizado. Caminho: proxy → Tor opcional → relay; o proxy mantém-se fora do Tor."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Encaminha o tráfego dos relays pelo sistema ou por um proxy personalizado. Caminho: proxy → Tor opcional → relay; o proxy permanece fora do Tor."}},"ru":{"stringUnit":{"state":"translated","value":"Направляет трафик ретрансляторов по системному маршруту или через заданный прокси. Путь: прокси → при необходимости Tor → ретранслятор; прокси остаётся снаружи Tor."}},"sv":{"stringUnit":{"state":"translated","value":"Dirigerar relaytrafik via systemrutten eller en egen proxy. Sökväg: proxy → valfri Tor → relay, så proxyn ligger kvar utanför Tor."}},"ta":{"stringUnit":{"state":"translated","value":"ரிலே போக்குவரத்தை கணினி வழிப்படுத்தல் அல்லது தனிப்பயன் பதிலி வழியாக அனுப்பும். பாதை: பதிலி → விருப்பமான Tor → ரிலே; பதிலி Tor-க்கு வெளியே இருக்கும்."}},"th":{"stringUnit":{"state":"translated","value":"กำหนดเส้นทางทราฟฟิกรีเลย์ผ่านเส้นทางของระบบหรือพร็อกซีที่กำหนดเอง เส้นทางคือ พร็อกซี → Tor (ถ้าเปิด) → รีเลย์ พร็อกซีจึงอยู่ชั้นนอกของ Tor"}},"tr":{"stringUnit":{"state":"translated","value":"Relay trafiğini sistem yönlendirmesi veya özel bir proxy üzerinden iletir. Yol: Proxy → isteğe bağlı Tor → relay; proxy Tor’un dışında kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Спрямовує трафік ретрансляторів системним маршрутом або через власний проксі. Шлях: проксі → за потреби Tor → ретранслятор; проксі залишається зовні Tor."}},"ur":{"stringUnit":{"state":"translated","value":"ریلے ٹریفک کو سسٹم روٹنگ یا کسٹم پراکسی سے گزارتا ہے۔ راستہ: پراکسی ← اختیاری Tor ← ریلے، اس لیے پراکسی Tor سے باہر رہتی ہے۔"}},"vi":{"stringUnit":{"state":"translated","value":"Định tuyến lưu lượng relay qua tuyến hệ thống hoặc proxy tùy chỉnh. Đường đi: Proxy → Tor tùy chọn → relay, nên proxy vẫn nằm ngoài Tor."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过系统路由或自定义代理转发中继流量。链路为“代理 → 可选的 Tor → 中继”，因此代理位于 Tor 的最外层。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"透過系統路由或自訂代理轉送中繼流量。路徑為「代理 → 可選的 Tor → 中繼」，因此代理位於 Tor 的最外層。"}}}},
    "app_info.settings.outer_proxy.ios_system": {"comment":"Explanation of system proxy behavior on iOS and iPadOS","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يتبع الإعداد الافتراضي توجيه شبكة iOS. تنقل شبكة VPN النشطة حركة MeshChat وTor بالفعل؛ اختر مخصّصًا فقط لاستخدام وكيل HTTP أو SOCKS5 منفصل."}},"bn":{"stringUnit":{"state":"translated","value":"সিস্টেম ডিফল্ট iOS নেটওয়ার্ক রাউটিং অনুসরণ করে। সক্রিয় VPN ইতিমধ্যেই MeshChat ও Tor ট্রাফিক বহন করে; আলাদা HTTP বা SOCKS5 প্রক্সির জন্যই শুধু কাস্টম বেছে নিন।"}},"de":{"stringUnit":{"state":"translated","value":"Systemstandard folgt der iOS-Netzwerkroute. Ein aktives VPN transportiert MeshChat- und Tor-Daten bereits; wählen Sie Eigener nur für einen separaten HTTP- oder SOCKS5-Proxy."}},"en":{"stringUnit":{"state":"translated","value":"System Default follows iOS network routing. An active VPN already carries MeshChat and Tor traffic; choose Custom only for a separate HTTP or SOCKS5 proxy."}},"es":{"stringUnit":{"state":"translated","value":"Predeterminado del sistema sigue el enrutamiento de iOS. Una VPN activa ya transporta el tráfico de MeshChat y Tor; elige Personalizado solo para un proxy HTTP o SOCKS5 independiente."}},"fa":{"stringUnit":{"state":"translated","value":"حالت پیش‌فرض از مسیریابی شبکه iOS پیروی می‌کند. VPN فعال ترافیک MeshChat و Tor را نیز عبور می‌دهد؛ فقط برای پراکسی جداگانه HTTP یا SOCKS5 حالت سفارشی را انتخاب کنید."}},"fil":{"stringUnit":{"state":"translated","value":"Sinusunod ng System Default ang network routing ng iOS. Dinadala na ng aktibong VPN ang traffic ng MeshChat at Tor; piliin lang ang Custom para sa hiwalay na HTTP o SOCKS5 proxy."}},"fr":{"stringUnit":{"state":"translated","value":"Par défaut suit le routage réseau d’iOS. Un VPN actif transporte déjà le trafic de MeshChat et de Tor ; choisissez Personnalisé uniquement pour un proxy HTTP ou SOCKS5 distinct."}},"he":{"stringUnit":{"state":"translated","value":"ברירת המחדל פועלת לפי ניתוב הרשת של iOS. ‏VPN פעיל כבר מעביר את תעבורת MeshChat ו‑Tor; יש לבחור מותאם רק עבור מתווך HTTP או SOCKS5 נפרד."}},"hi":{"stringUnit":{"state":"translated","value":"सिस्टम डिफ़ॉल्ट iOS नेटवर्क रूटिंग का अनुसरण करता है। सक्रिय VPN पहले से MeshChat और Tor ट्रैफ़िक ले जाता है; अलग HTTP या SOCKS5 प्रॉक्सी के लिए ही कस्टम चुनें।"}},"id":{"stringUnit":{"state":"translated","value":"Default Sistem mengikuti perutean jaringan iOS. VPN aktif sudah membawa lalu lintas MeshChat dan Tor; pilih Khusus hanya untuk proxy HTTP atau SOCKS5 terpisah."}},"it":{"stringUnit":{"state":"translated","value":"Predefinito di sistema segue l’instradamento di rete di iOS. Una VPN attiva trasporta già il traffico MeshChat e Tor; scegli Personalizzato solo per un proxy HTTP o SOCKS5 separato."}},"ja":{"stringUnit":{"state":"translated","value":"システムデフォルトはiOSのネットワーク経路に従います。VPNが有効ならMeshChatとTorの通信もすでにVPNを通るため、別のHTTPまたはSOCKS5プロキシを使う場合だけカスタムを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"시스템 기본값은 iOS 네트워크 경로를 따릅니다. 활성 VPN은 이미 MeshChat과 Tor 트래픽을 전달하므로 별도의 HTTP 또는 SOCKS5 프록시에만 사용자 지정을 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Lalai Sistem mengikut penghalaan rangkaian iOS. VPN aktif sudah membawa trafik MeshChat dan Tor; pilih Tersuai hanya untuk proksi HTTP atau SOCKS5 yang berasingan."}},"ne":{"stringUnit":{"state":"translated","value":"प्रणाली पूर्वनिर्धारितले iOS नेटवर्क रुटिङ पछ्याउँछ। सक्रिय VPN ले MeshChat र Tor ट्राफिक पहिले नै बोक्छ; छुट्टै HTTP वा SOCKS5 प्रोक्सीका लागि मात्र आफ्नै रोज्नुहोस्।"}},"nl":{"stringUnit":{"state":"translated","value":"Systeemstandaard volgt de netwerkroutering van iOS. Een actieve VPN vervoert MeshChat- en Tor-verkeer al; kies Aangepast alleen voor een afzonderlijke HTTP- of SOCKS5-proxy."}},"pl":{"stringUnit":{"state":"translated","value":"Ustawienie systemowe korzysta z routingu sieciowego iOS. Aktywna sieć VPN już przenosi ruch MeshChat i Tor; wybierz Własny tylko dla osobnego proxy HTTP lub SOCKS5."}},"pt":{"stringUnit":{"state":"translated","value":"A predefinição do sistema segue o encaminhamento de rede do iOS. Uma VPN ativa já transporta o tráfego do MeshChat e Tor; escolha Personalizado apenas para um proxy HTTP ou SOCKS5 separado."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O padrão do sistema segue o roteamento de rede do iOS. Uma VPN ativa já transporta o tráfego do MeshChat e do Tor; escolha Personalizado apenas para um proxy HTTP ou SOCKS5 separado."}},"ru":{"stringUnit":{"state":"translated","value":"Системный режим использует маршрутизацию iOS. Активный VPN уже передаёт трафик MeshChat и Tor; выбирайте свой режим только для отдельного HTTP- или SOCKS5-прокси."}},"sv":{"stringUnit":{"state":"translated","value":"Systemstandard följer iOS nätverksrutt. Ett aktivt VPN transporterar redan MeshChat- och Tor-trafik; välj Egen endast för en separat HTTP- eller SOCKS5-proxy."}},"ta":{"stringUnit":{"state":"translated","value":"கணினி இயல்புநிலை iOS வலையமைப்பு வழிப்படுத்தலைப் பின்பற்றும். செயலில் உள்ள VPN ஏற்கனவே MeshChat மற்றும் Tor போக்குவரத்தை எடுத்துச் செல்லும்; தனி HTTP அல்லது SOCKS5 பதிலிக்காக மட்டும் தனிப்பயனைத் தேர்ந்தெடுக்கவும்."}},"th":{"stringUnit":{"state":"translated","value":"ค่าเริ่มต้นของระบบใช้เส้นทางเครือข่ายของ iOS โดย VPN ที่ทำงานอยู่จะส่งทราฟฟิกของ MeshChat และ Tor อยู่แล้ว เลือกกำหนดเองเฉพาะเมื่อต้องการพร็อกซี HTTP หรือ SOCKS5 แยกต่างหาก"}},"tr":{"stringUnit":{"state":"translated","value":"Sistem Varsayılanı iOS ağ yönlendirmesini izler. Etkin bir VPN, MeshChat ve Tor trafiğini zaten taşır; yalnızca ayrı bir HTTP veya SOCKS5 proxy için Özel’i seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Системний режим використовує маршрутизацію iOS. Активний VPN уже передає трафік MeshChat і Tor; вибирайте власний режим лише для окремого HTTP- або SOCKS5-проксі."}},"ur":{"stringUnit":{"state":"translated","value":"سسٹم ڈیفالٹ iOS نیٹ ورک روٹنگ کی پیروی کرتا ہے۔ فعال VPN پہلے ہی MeshChat اور Tor ٹریفک لے جاتا ہے؛ علیحدہ HTTP یا SOCKS5 پراکسی کے لیے ہی کسٹم منتخب کریں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Mặc định hệ thống đi theo định tuyến mạng của iOS. VPN đang hoạt động đã chuyển cả lưu lượng MeshChat và Tor; chỉ chọn Tùy chỉnh khi cần proxy HTTP hoặc SOCKS5 riêng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统默认会遵循 iOS 网络路由。启用 VPN 后，MeshChat 和 Tor 流量已经会经过 VPN；只有需要单独的 HTTP 或 SOCKS5 代理时才选择“自定义”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統預設會遵循 iOS 網路路由。啟用 VPN 後，MeshChat 和 Tor 流量已經會經過 VPN；只有需要獨立的 HTTP 或 SOCKS5 代理時才選擇「自訂」。"}}}},
    "app_info.settings.outer_proxy.title": {"comment":"Title of the macOS proxy configuration card","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"الوكيل الخارجي"}},"bn":{"stringUnit":{"state":"translated","value":"বাইরের প্রক্সি"}},"de":{"stringUnit":{"state":"translated","value":"Äußerer Proxy"}},"en":{"stringUnit":{"state":"translated","value":"Outer Proxy"}},"es":{"stringUnit":{"state":"translated","value":"Proxy externo"}},"fa":{"stringUnit":{"state":"translated","value":"پراکسی بیرونی"}},"fil":{"stringUnit":{"state":"translated","value":"Panlabas na Proxy"}},"fr":{"stringUnit":{"state":"translated","value":"Proxy externe"}},"he":{"stringUnit":{"state":"translated","value":"מתווך חיצוני"}},"hi":{"stringUnit":{"state":"translated","value":"बाहरी प्रॉक्सी"}},"id":{"stringUnit":{"state":"translated","value":"Proxy Luar"}},"it":{"stringUnit":{"state":"translated","value":"Proxy esterno"}},"ja":{"stringUnit":{"state":"translated","value":"外部プロキシ"}},"ko":{"stringUnit":{"state":"translated","value":"외부 프록시"}},"ms":{"stringUnit":{"state":"translated","value":"Proksi Luar"}},"ne":{"stringUnit":{"state":"translated","value":"बाहिरी प्रोक्सी"}},"nl":{"stringUnit":{"state":"translated","value":"Externe proxy"}},"pl":{"stringUnit":{"state":"translated","value":"Zewnętrzny serwer proxy"}},"pt":{"stringUnit":{"state":"translated","value":"Proxy externo"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Proxy externo"}},"ru":{"stringUnit":{"state":"translated","value":"Внешний прокси"}},"sv":{"stringUnit":{"state":"translated","value":"Yttre proxy"}},"ta":{"stringUnit":{"state":"translated","value":"வெளிப்புற பதிலி"}},"th":{"stringUnit":{"state":"translated","value":"พร็อกซีชั้นนอก"}},"tr":{"stringUnit":{"state":"translated","value":"Dış Proxy"}},"uk":{"stringUnit":{"state":"translated","value":"Зовнішній проксі"}},"ur":{"stringUnit":{"state":"translated","value":"بیرونی پراکسی"}},"vi":{"stringUnit":{"state":"translated","value":"Proxy ngoài"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外层代理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"外層代理"}}}},
    "app_info.settings.outer_proxy.subtitle": {"comment":"Description of how the outer proxy and optional Tor routing are ordered","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"يوجّه حركة المرحّلات عبر وكيل macOS أو وكيل مخصّص. المسار: الوكيل ← Tor اختياري ← المرحّل، لذلك يبقى الوكيل خارج Tor."}},"bn":{"stringUnit":{"state":"translated","value":"রিলে ট্রাফিক macOS বা কাস্টম প্রক্সির মাধ্যমে পাঠায়। পথ: প্রক্সি → ঐচ্ছিক Tor → রিলে, তাই প্রক্সি Tor-এর বাইরে থাকে।"}},"de":{"stringUnit":{"state":"translated","value":"Leitet Relay-Datenverkehr über den macOS- oder einen eigenen Proxy. Pfad: Proxy → optional Tor → Relay; der Proxy bleibt außerhalb von Tor."}},"en":{"stringUnit":{"state":"translated","value":"Routes relay traffic through a macOS or custom proxy. The path is Proxy → optional Tor → relay, so turning Tor on still keeps this proxy on the outside."}},"es":{"stringUnit":{"state":"translated","value":"Enruta el tráfico de los relays por el proxy de macOS o uno personalizado. Ruta: proxy → Tor opcional → relay; el proxy permanece fuera de Tor."}},"fa":{"stringUnit":{"state":"translated","value":"ترافیک رله را از پراکسی macOS یا پراکسی سفارشی عبور می‌دهد. مسیر: پراکسی ← Tor اختیاری ← رله؛ پس پراکسی بیرون از Tor می‌ماند."}},"fil":{"stringUnit":{"state":"translated","value":"Dinadaan ang relay traffic sa proxy ng macOS o sa custom proxy. Landas: Proxy → opsyonal na Tor → relay, kaya nananatili ang proxy sa labas ng Tor."}},"fr":{"stringUnit":{"state":"translated","value":"Achemine le trafic des relais via le proxy de macOS ou un proxy personnalisé. Chemin : proxy → Tor facultatif → relais ; le proxy reste à l’extérieur de Tor."}},"he":{"stringUnit":{"state":"translated","value":"מנתב תעבורת ממסרים דרך המתווך של macOS או מתווך מותאם. הנתיב: מתווך ← Tor אופציונלי ← ממסר, לכן המתווך נשאר מחוץ ל‑Tor."}},"hi":{"stringUnit":{"state":"translated","value":"रिले ट्रैफ़िक को macOS या कस्टम प्रॉक्सी से भेजता है। रास्ता: प्रॉक्सी → वैकल्पिक Tor → रिले, इसलिए प्रॉक्सी Tor के बाहर रहता है।"}},"id":{"stringUnit":{"state":"translated","value":"Merutekan lalu lintas relay melalui proxy macOS atau proxy khusus. Jalur: Proxy → Tor opsional → relay, sehingga proxy tetap berada di luar Tor."}},"it":{"stringUnit":{"state":"translated","value":"Instrada il traffico dei relay tramite il proxy di macOS o uno personalizzato. Percorso: proxy → Tor facoltativo → relay; il proxy resta all’esterno di Tor."}},"ja":{"stringUnit":{"state":"translated","value":"リレー通信をmacOSまたはカスタムプロキシ経由にします。経路は「プロキシ → 任意のTor → リレー」で、プロキシはTorの外側にあります。"}},"ko":{"stringUnit":{"state":"translated","value":"릴레이 트래픽을 macOS 또는 사용자 지정 프록시로 보냅니다. 경로는 프록시 → 선택적 Tor → 릴레이이므로 프록시는 Tor 바깥쪽에 유지됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Menghalakan trafik relay melalui proksi macOS atau proksi tersuai. Laluan: Proksi → Tor pilihan → relay, jadi proksi kekal di luar Tor."}},"ne":{"stringUnit":{"state":"translated","value":"रिले ट्राफिकलाई macOS वा आफ्नै प्रोक्सीमार्फत पठाउँछ। बाटो: प्रोक्सी → वैकल्पिक Tor → रिले, त्यसैले प्रोक्सी Tor बाहिर रहन्छ।"}},"nl":{"stringUnit":{"state":"translated","value":"Leidt relayverkeer via de macOS-proxy of een aangepaste proxy. Pad: proxy → optioneel Tor → relay; de proxy blijft buiten Tor."}},"pl":{"stringUnit":{"state":"translated","value":"Kieruje ruch przekaźników przez proxy macOS lub własny serwer proxy. Ścieżka: proxy → opcjonalnie Tor → przekaźnik, więc proxy pozostaje na zewnątrz Tor."}},"pt":{"stringUnit":{"state":"translated","value":"Encaminha o tráfego dos relays pelo proxy do macOS ou por um proxy personalizado. Caminho: proxy → Tor opcional → relay; o proxy mantém-se fora do Tor."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Encaminha o tráfego dos relays pelo proxy do macOS ou por um proxy personalizado. Caminho: proxy → Tor opcional → relay; o proxy permanece fora do Tor."}},"ru":{"stringUnit":{"state":"translated","value":"Направляет трафик ретрансляторов через прокси macOS или заданный прокси. Путь: прокси → при необходимости Tor → ретранслятор, поэтому прокси остаётся снаружи Tor."}},"sv":{"stringUnit":{"state":"translated","value":"Dirigerar relaytrafik via macOS-proxyn eller en egen proxy. Sökväg: proxy → valfri Tor → relay, så proxyn ligger kvar utanför Tor."}},"ta":{"stringUnit":{"state":"translated","value":"ரிலே போக்குவரத்தை macOS அல்லது தனிப்பயன் பதிலி வழியாக அனுப்பும். பாதை: பதிலி → விருப்பமான Tor → ரிலே; பதிலி Tor-க்கு வெளியே இருக்கும்."}},"th":{"stringUnit":{"state":"translated","value":"กำหนดเส้นทางทราฟฟิกรีเลย์ผ่านพร็อกซีของ macOS หรือพร็อกซีที่กำหนดเอง เส้นทางคือ พร็อกซี → Tor (ถ้าเปิด) → รีเลย์ พร็อกซีจึงอยู่ชั้นนอกของ Tor"}},"tr":{"stringUnit":{"state":"translated","value":"Relay trafiğini macOS proxy’si veya özel bir proxy üzerinden yönlendirir. Yol: Proxy → isteğe bağlı Tor → relay; proxy Tor’un dışında kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Спрямовує трафік ретрансляторів через проксі macOS або власний проксі. Шлях: проксі → за потреби Tor → ретранслятор, тому проксі залишається зовні Tor."}},"ur":{"stringUnit":{"state":"translated","value":"ریلے ٹریفک کو macOS یا کسٹم پراکسی سے گزارتا ہے۔ راستہ: پراکسی ← اختیاری Tor ← ریلے، اس لیے پراکسی Tor سے باہر رہتی ہے۔"}},"vi":{"stringUnit":{"state":"translated","value":"Định tuyến lưu lượng relay qua proxy của macOS hoặc proxy tùy chỉnh. Đường đi: Proxy → Tor tùy chọn → relay, nên proxy vẫn nằm ngoài Tor."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 macOS 系统代理或自定义代理转发中继流量。链路为“代理 → 可选的 Tor → 中继”，因此代理位于 Tor 的最外层。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"透過 macOS 系統代理或自訂代理轉送中繼流量。路徑為「代理 → 可選的 Tor → 中繼」，因此代理位於 Tor 的最外層。"}}}},
    "app_info.settings.outer_proxy.custom": {"comment":"Proxy mode configured separately inside MeshChat","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"مخصّص"}},"bn":{"stringUnit":{"state":"translated","value":"কাস্টম"}},"de":{"stringUnit":{"state":"translated","value":"Eigener"}},"en":{"stringUnit":{"state":"translated","value":"Custom"}},"es":{"stringUnit":{"state":"translated","value":"Personalizado"}},"fa":{"stringUnit":{"state":"translated","value":"سفارشی"}},"fil":{"stringUnit":{"state":"translated","value":"Custom"}},"fr":{"stringUnit":{"state":"translated","value":"Personnalisé"}},"he":{"stringUnit":{"state":"translated","value":"מותאם"}},"hi":{"stringUnit":{"state":"translated","value":"कस्टम"}},"id":{"stringUnit":{"state":"translated","value":"Khusus"}},"it":{"stringUnit":{"state":"translated","value":"Personalizzato"}},"ja":{"stringUnit":{"state":"translated","value":"カスタム"}},"ko":{"stringUnit":{"state":"translated","value":"사용자 지정"}},"ms":{"stringUnit":{"state":"translated","value":"Tersuai"}},"ne":{"stringUnit":{"state":"translated","value":"आफ्नै"}},"nl":{"stringUnit":{"state":"translated","value":"Aangepast"}},"pl":{"stringUnit":{"state":"translated","value":"Własny"}},"pt":{"stringUnit":{"state":"translated","value":"Personalizado"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Personalizado"}},"ru":{"stringUnit":{"state":"translated","value":"Свой"}},"sv":{"stringUnit":{"state":"translated","value":"Egen"}},"ta":{"stringUnit":{"state":"translated","value":"தனிப்பயன்"}},"th":{"stringUnit":{"state":"translated","value":"กำหนดเอง"}},"tr":{"stringUnit":{"state":"translated","value":"Özel"}},"uk":{"stringUnit":{"state":"translated","value":"Власний"}},"ur":{"stringUnit":{"state":"translated","value":"کسٹم"}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chỉnh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自訂"}}}},
    "app_info.settings.outer_proxy.detected": {"comment":"Status showing the static proxy detected in macOS settings; %@ is the proxy description","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم الاكتشاف: %@"}},"bn":{"stringUnit":{"state":"translated","value":"শনাক্ত হয়েছে: %@"}},"de":{"stringUnit":{"state":"translated","value":"Erkannt: %@"}},"en":{"stringUnit":{"state":"translated","value":"Detected: %@"}},"es":{"stringUnit":{"state":"translated","value":"Detectado: %@"}},"fa":{"stringUnit":{"state":"translated","value":"شناسایی شد: %@"}},"fil":{"stringUnit":{"state":"translated","value":"Natukoy: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Détecté : %@"}},"he":{"stringUnit":{"state":"translated","value":"זוהה: %@"}},"hi":{"stringUnit":{"state":"translated","value":"मिला: %@"}},"id":{"stringUnit":{"state":"translated","value":"Terdeteksi: %@"}},"it":{"stringUnit":{"state":"translated","value":"Rilevato: %@"}},"ja":{"stringUnit":{"state":"translated","value":"検出: %@"}},"ko":{"stringUnit":{"state":"translated","value":"감지됨: %@"}},"ms":{"stringUnit":{"state":"translated","value":"Dikesan: %@"}},"ne":{"stringUnit":{"state":"translated","value":"पत्ता लाग्यो: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Gedetecteerd: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Wykryto: %@"}},"pt":{"stringUnit":{"state":"translated","value":"Detetado: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detectado: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Обнаружено: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Identifierad: %@"}},"ta":{"stringUnit":{"state":"translated","value":"கண்டறியப்பட்டது: %@"}},"th":{"stringUnit":{"state":"translated","value":"ตรวจพบ: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Algılandı: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Виявлено: %@"}},"ur":{"stringUnit":{"state":"translated","value":"دریافت ہوا: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Đã phát hiện: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已检测：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已偵測：%@"}}}},
    "app_info.settings.outer_proxy.not_detected": {"comment":"Status shown when macOS has no static HTTP or SOCKS proxy available for the embedded Tor client","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"لم يُكتشف وكيل نظام ثابت. تظل الاتصالات المباشرة تتبع macOS، بينما يتصل Tor مباشرة ما لم تضبط وكيلاً مخصّصًا."}},"bn":{"stringUnit":{"state":"translated","value":"কোনো স্থির সিস্টেম প্রক্সি পাওয়া যায়নি। সরাসরি সংযোগ macOS অনুসরণ করবে; কাস্টম প্রক্সি না দিলে Tor সরাসরি সংযুক্ত হবে।"}},"de":{"stringUnit":{"state":"translated","value":"Kein statischer Systemproxy erkannt. Direkte Verbindungen folgen weiterhin macOS; Tor verbindet sich direkt, sofern kein eigener Proxy festgelegt ist."}},"en":{"stringUnit":{"state":"translated","value":"No static system proxy detected. Direct connections still follow macOS, while Tor connects directly unless a Custom proxy is configured."}},"es":{"stringUnit":{"state":"translated","value":"No se detectó un proxy estático del sistema. Las conexiones directas siguen a macOS; Tor se conecta directamente salvo que configures un proxy personalizado."}},"fa":{"stringUnit":{"state":"translated","value":"پراکسی ثابت سیستم پیدا نشد. اتصال‌های مستقیم همچنان از تنظیمات macOS پیروی می‌کنند؛ Tor بدون پراکسی وصل می‌شود مگر پراکسی سفارشی تنظیم کنید."}},"fil":{"stringUnit":{"state":"translated","value":"Walang natukoy na static system proxy. Susunod pa rin sa macOS ang direktang koneksyon; direktang kokonekta ang Tor maliban kung may Custom proxy."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun proxy système statique détecté. Les connexions directes suivent toujours macOS ; Tor se connecte directement sauf si un proxy personnalisé est configuré."}},"he":{"stringUnit":{"state":"translated","value":"לא זוהה מתווך מערכת קבוע. חיבורים ישירים עדיין פועלים לפי macOS; ‏Tor מתחבר ישירות אלא אם הוגדר מתווך מותאם."}},"hi":{"stringUnit":{"state":"translated","value":"कोई स्थिर सिस्टम प्रॉक्सी नहीं मिला। सीधे कनेक्शन macOS का अनुसरण करेंगे; कस्टम प्रॉक्सी न होने पर Tor सीधे जुड़ेगा।"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada proxy sistem statis yang terdeteksi. Koneksi langsung tetap mengikuti macOS; Tor terhubung langsung kecuali proxy khusus dikonfigurasi."}},"it":{"stringUnit":{"state":"translated","value":"Nessun proxy di sistema statico rilevato. Le connessioni dirette seguono comunque macOS; Tor si connette direttamente se non configuri un proxy personalizzato."}},"ja":{"stringUnit":{"state":"translated","value":"固定のシステムプロキシは検出されませんでした。直接接続は引き続きmacOSに従い、カスタムプロキシがなければTorは直接接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"고정 시스템 프록시가 감지되지 않았습니다. 직접 연결은 계속 macOS를 따르며, 사용자 지정 프록시가 없으면 Tor는 직접 연결합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Tiada proksi sistem statik dikesan. Sambungan terus tetap mengikut macOS; Tor bersambung terus melainkan proksi tersuai ditetapkan."}},"ne":{"stringUnit":{"state":"translated","value":"स्थिर प्रणाली प्रोक्सी भेटिएन। प्रत्यक्ष जडानले macOS पछ्याउँछ; आफ्नै प्रोक्सी नभए Tor प्रत्यक्ष जडान हुन्छ।"}},"nl":{"stringUnit":{"state":"translated","value":"Geen statische systeemproxy gedetecteerd. Directe verbindingen blijven macOS volgen; Tor maakt rechtstreeks verbinding tenzij een aangepaste proxy is ingesteld."}},"pl":{"stringUnit":{"state":"translated","value":"Nie wykryto statycznego systemowego proxy. Połączenia bezpośrednie nadal używają ustawień macOS; Tor łączy się bezpośrednio, chyba że skonfigurujesz własne proxy."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi detetado um proxy estático do sistema. As ligações diretas continuam a seguir o macOS; o Tor liga-se diretamente salvo se configurar um proxy personalizado."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum proxy estático do sistema foi detectado. As conexões diretas continuam seguindo o macOS; o Tor se conecta diretamente, a menos que um proxy personalizado seja configurado."}},"ru":{"stringUnit":{"state":"translated","value":"Статический системный прокси не обнаружен. Прямые подключения по-прежнему следуют настройкам macOS; Tor подключается напрямую, если свой прокси не задан."}},"sv":{"stringUnit":{"state":"translated","value":"Ingen statisk systemproxy identifierades. Direktanslutningar följer fortfarande macOS; Tor ansluter direkt om ingen egen proxy har angetts."}},"ta":{"stringUnit":{"state":"translated","value":"நிலையான கணினி பதிலி எதுவும் கண்டறியப்படவில்லை. நேரடி இணைப்புகள் macOS-ஐப் பின்பற்றும்; தனிப்பயன் பதிலி இல்லையெனில் Tor நேரடியாக இணையும்."}},"th":{"stringUnit":{"state":"translated","value":"ไม่พบพร็อกซีระบบแบบคงที่ การเชื่อมต่อโดยตรงยังคงใช้การตั้งค่า macOS ส่วน Tor จะเชื่อมต่อโดยตรงหากไม่ได้ตั้งพร็อกซีแบบกำหนดเอง"}},"tr":{"stringUnit":{"state":"translated","value":"Statik sistem proxy’si algılanmadı. Doğrudan bağlantılar macOS’u izlemeye devam eder; özel proxy ayarlanmazsa Tor doğrudan bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Статичний системний проксі не виявлено. Прямі з’єднання й далі використовують macOS; Tor з’єднується напряму, якщо власний проксі не налаштовано."}},"ur":{"stringUnit":{"state":"translated","value":"کوئی مستقل سسٹم پراکسی نہیں ملی۔ براہ راست کنکشن macOS کی پیروی کرتے ہیں؛ کسٹم پراکسی نہ ہو تو Tor براہ راست جڑتا ہے۔"}},"vi":{"stringUnit":{"state":"translated","value":"Không phát hiện proxy hệ thống tĩnh. Kết nối trực tiếp vẫn theo macOS; Tor kết nối trực tiếp trừ khi bạn cấu hình proxy tùy chỉnh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未检测到静态系统代理。直连仍会遵循 macOS 设置；除非配置自定义代理，否则 Tor 将直接连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未偵測到靜態系統代理。直接連線仍會遵循 macOS 設定；除非設定自訂代理，否則 Tor 將直接連線。"}}}},
    "app_info.settings.outer_proxy.type": {"comment":"Label for the custom proxy protocol picker","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"النوع"}},"bn":{"stringUnit":{"state":"translated","value":"ধরন"}},"de":{"stringUnit":{"state":"translated","value":"Typ"}},"en":{"stringUnit":{"state":"translated","value":"Type"}},"es":{"stringUnit":{"state":"translated","value":"Tipo"}},"fa":{"stringUnit":{"state":"translated","value":"نوع"}},"fil":{"stringUnit":{"state":"translated","value":"Uri"}},"fr":{"stringUnit":{"state":"translated","value":"Type"}},"he":{"stringUnit":{"state":"translated","value":"סוג"}},"hi":{"stringUnit":{"state":"translated","value":"प्रकार"}},"id":{"stringUnit":{"state":"translated","value":"Jenis"}},"it":{"stringUnit":{"state":"translated","value":"Tipo"}},"ja":{"stringUnit":{"state":"translated","value":"種類"}},"ko":{"stringUnit":{"state":"translated","value":"유형"}},"ms":{"stringUnit":{"state":"translated","value":"Jenis"}},"ne":{"stringUnit":{"state":"translated","value":"प्रकार"}},"nl":{"stringUnit":{"state":"translated","value":"Type"}},"pl":{"stringUnit":{"state":"translated","value":"Typ"}},"pt":{"stringUnit":{"state":"translated","value":"Tipo"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tipo"}},"ru":{"stringUnit":{"state":"translated","value":"Тип"}},"sv":{"stringUnit":{"state":"translated","value":"Typ"}},"ta":{"stringUnit":{"state":"translated","value":"வகை"}},"th":{"stringUnit":{"state":"translated","value":"ประเภท"}},"tr":{"stringUnit":{"state":"translated","value":"Tür"}},"uk":{"stringUnit":{"state":"translated","value":"Тип"}},"ur":{"stringUnit":{"state":"translated","value":"قسم"}},"vi":{"stringUnit":{"state":"translated","value":"Loại"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"类型"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"類型"}}}},
    "app_info.settings.outer_proxy.host": {"comment":"Label for the custom proxy host field","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"المضيف"}},"bn":{"stringUnit":{"state":"translated","value":"হোস্ট"}},"de":{"stringUnit":{"state":"translated","value":"Host"}},"en":{"stringUnit":{"state":"translated","value":"Host"}},"es":{"stringUnit":{"state":"translated","value":"Host"}},"fa":{"stringUnit":{"state":"translated","value":"میزبان"}},"fil":{"stringUnit":{"state":"translated","value":"Host"}},"fr":{"stringUnit":{"state":"translated","value":"Hôte"}},"he":{"stringUnit":{"state":"translated","value":"מארח"}},"hi":{"stringUnit":{"state":"translated","value":"होस्ट"}},"id":{"stringUnit":{"state":"translated","value":"Host"}},"it":{"stringUnit":{"state":"translated","value":"Host"}},"ja":{"stringUnit":{"state":"translated","value":"ホスト"}},"ko":{"stringUnit":{"state":"translated","value":"호스트"}},"ms":{"stringUnit":{"state":"translated","value":"Hos"}},"ne":{"stringUnit":{"state":"translated","value":"होस्ट"}},"nl":{"stringUnit":{"state":"translated","value":"Host"}},"pl":{"stringUnit":{"state":"translated","value":"Host"}},"pt":{"stringUnit":{"state":"translated","value":"Anfitrião"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Host"}},"ru":{"stringUnit":{"state":"translated","value":"Хост"}},"sv":{"stringUnit":{"state":"translated","value":"Värd"}},"ta":{"stringUnit":{"state":"translated","value":"ஹோஸ்ட்"}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์"}},"tr":{"stringUnit":{"state":"translated","value":"Sunucu"}},"uk":{"stringUnit":{"state":"translated","value":"Хост"}},"ur":{"stringUnit":{"state":"translated","value":"ہوسٹ"}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主机"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"主機"}}}},
    "app_info.settings.outer_proxy.port": {"comment":"Label for the custom proxy port field","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"المنفذ"}},"bn":{"stringUnit":{"state":"translated","value":"পোর্ট"}},"de":{"stringUnit":{"state":"translated","value":"Port"}},"en":{"stringUnit":{"state":"translated","value":"Port"}},"es":{"stringUnit":{"state":"translated","value":"Puerto"}},"fa":{"stringUnit":{"state":"translated","value":"درگاه"}},"fil":{"stringUnit":{"state":"translated","value":"Port"}},"fr":{"stringUnit":{"state":"translated","value":"Port"}},"he":{"stringUnit":{"state":"translated","value":"יציאה"}},"hi":{"stringUnit":{"state":"translated","value":"पोर्ट"}},"id":{"stringUnit":{"state":"translated","value":"Port"}},"it":{"stringUnit":{"state":"translated","value":"Porta"}},"ja":{"stringUnit":{"state":"translated","value":"ポート"}},"ko":{"stringUnit":{"state":"translated","value":"포트"}},"ms":{"stringUnit":{"state":"translated","value":"Port"}},"ne":{"stringUnit":{"state":"translated","value":"पोर्ट"}},"nl":{"stringUnit":{"state":"translated","value":"Poort"}},"pl":{"stringUnit":{"state":"translated","value":"Port"}},"pt":{"stringUnit":{"state":"translated","value":"Porta"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Porta"}},"ru":{"stringUnit":{"state":"translated","value":"Порт"}},"sv":{"stringUnit":{"state":"translated","value":"Port"}},"ta":{"stringUnit":{"state":"translated","value":"போர்ட்"}},"th":{"stringUnit":{"state":"translated","value":"พอร์ต"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantı Noktası"}},"uk":{"stringUnit":{"state":"translated","value":"Порт"}},"ur":{"stringUnit":{"state":"translated","value":"پورٹ"}},"vi":{"stringUnit":{"state":"translated","value":"Cổng"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"端口"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連接埠"}}}},
    "app_info.settings.outer_proxy.username": {"comment":"Label for the optional custom proxy username field","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"اسم المستخدم (اختياري)"}},"bn":{"stringUnit":{"state":"translated","value":"ব্যবহারকারীর নাম (ঐচ্ছিক)"}},"de":{"stringUnit":{"state":"translated","value":"Benutzername (optional)"}},"en":{"stringUnit":{"state":"translated","value":"Username (Optional)"}},"es":{"stringUnit":{"state":"translated","value":"Usuario (opcional)"}},"fa":{"stringUnit":{"state":"translated","value":"نام کاربری (اختیاری)"}},"fil":{"stringUnit":{"state":"translated","value":"Username (Opsyonal)"}},"fr":{"stringUnit":{"state":"translated","value":"Nom d’utilisateur (facultatif)"}},"he":{"stringUnit":{"state":"translated","value":"שם משתמש (אופציונלי)"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोगकर्ता नाम (वैकल्पिक)"}},"id":{"stringUnit":{"state":"translated","value":"Nama Pengguna (Opsional)"}},"it":{"stringUnit":{"state":"translated","value":"Nome utente (facoltativo)"}},"ja":{"stringUnit":{"state":"translated","value":"ユーザー名（任意）"}},"ko":{"stringUnit":{"state":"translated","value":"사용자 이름(선택 사항)"}},"ms":{"stringUnit":{"state":"translated","value":"Nama Pengguna (Pilihan)"}},"ne":{"stringUnit":{"state":"translated","value":"प्रयोगकर्ता नाम (वैकल्पिक)"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikersnaam (optioneel)"}},"pl":{"stringUnit":{"state":"translated","value":"Nazwa użytkownika (opcjonalnie)"}},"pt":{"stringUnit":{"state":"translated","value":"Nome de utilizador (opcional)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nome de usuário (opcional)"}},"ru":{"stringUnit":{"state":"translated","value":"Имя пользователя (необязательно)"}},"sv":{"stringUnit":{"state":"translated","value":"Användarnamn (valfritt)"}},"ta":{"stringUnit":{"state":"translated","value":"பயனர் பெயர் (விருப்பம்)"}},"th":{"stringUnit":{"state":"translated","value":"ชื่อผู้ใช้ (ไม่บังคับ)"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanıcı Adı (İsteğe Bağlı)"}},"uk":{"stringUnit":{"state":"translated","value":"Ім’я користувача (необов’язково)"}},"ur":{"stringUnit":{"state":"translated","value":"صارف نام (اختیاری)"}},"vi":{"stringUnit":{"state":"translated","value":"Tên người dùng (Tùy chọn)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用户名（可选）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用者名稱（可選）"}}}},
    "app_info.settings.outer_proxy.password": {"comment":"Label for the optional custom proxy password field","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"كلمة المرور (اختيارية)"}},"bn":{"stringUnit":{"state":"translated","value":"পাসওয়ার্ড (ঐচ্ছিক)"}},"de":{"stringUnit":{"state":"translated","value":"Passwort (optional)"}},"en":{"stringUnit":{"state":"translated","value":"Password (Optional)"}},"es":{"stringUnit":{"state":"translated","value":"Contraseña (opcional)"}},"fa":{"stringUnit":{"state":"translated","value":"گذرواژه (اختیاری)"}},"fil":{"stringUnit":{"state":"translated","value":"Password (Opsyonal)"}},"fr":{"stringUnit":{"state":"translated","value":"Mot de passe (facultatif)"}},"he":{"stringUnit":{"state":"translated","value":"סיסמה (אופציונלית)"}},"hi":{"stringUnit":{"state":"translated","value":"पासवर्ड (वैकल्पिक)"}},"id":{"stringUnit":{"state":"translated","value":"Kata Sandi (Opsional)"}},"it":{"stringUnit":{"state":"translated","value":"Password (facoltativa)"}},"ja":{"stringUnit":{"state":"translated","value":"パスワード（任意）"}},"ko":{"stringUnit":{"state":"translated","value":"암호(선택 사항)"}},"ms":{"stringUnit":{"state":"translated","value":"Kata Laluan (Pilihan)"}},"ne":{"stringUnit":{"state":"translated","value":"पासवर्ड (वैकल्पिक)"}},"nl":{"stringUnit":{"state":"translated","value":"Wachtwoord (optioneel)"}},"pl":{"stringUnit":{"state":"translated","value":"Hasło (opcjonalnie)"}},"pt":{"stringUnit":{"state":"translated","value":"Palavra-passe (opcional)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Senha (opcional)"}},"ru":{"stringUnit":{"state":"translated","value":"Пароль (необязательно)"}},"sv":{"stringUnit":{"state":"translated","value":"Lösenord (valfritt)"}},"ta":{"stringUnit":{"state":"translated","value":"கடவுச்சொல் (விருப்பம்)"}},"th":{"stringUnit":{"state":"translated","value":"รหัสผ่าน (ไม่บังคับ)"}},"tr":{"stringUnit":{"state":"translated","value":"Parola (İsteğe Bağlı)"}},"uk":{"stringUnit":{"state":"translated","value":"Пароль (необов’язково)"}},"ur":{"stringUnit":{"state":"translated","value":"پاس ورڈ (اختیاری)"}},"vi":{"stringUnit":{"state":"translated","value":"Mật khẩu (Tùy chọn)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码（可选）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"密碼（可選）"}}}},
    "app_info.settings.outer_proxy.credentials_note": {"comment":"Security note below custom proxy credential fields","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تُستخدم بيانات الاعتماد للوصلة الخارجية وتُحفظ في سلسلة المفاتيح. وهي لا تحل محل Tor أو تشفير الرسائل."}},"bn":{"stringUnit":{"state":"translated","value":"প্রক্সি পরিচয়পত্র বাইরের হপে প্রমাণীকরণ করে এবং Keychain-এ থাকে। এটি Tor বা বার্তা এনক্রিপশনের বিকল্প নয়।"}},"de":{"stringUnit":{"state":"translated","value":"Proxy-Zugangsdaten authentifizieren den äußeren Hop und werden im Schlüsselbund gespeichert. Sie ersetzen weder Tor noch die Nachrichtenverschlüsselung."}},"en":{"stringUnit":{"state":"translated","value":"Proxy credentials authenticate the outer hop and are stored in Keychain. They do not replace Tor or message encryption."}},"es":{"stringUnit":{"state":"translated","value":"Las credenciales autentican el salto externo y se guardan en el Llavero. No sustituyen a Tor ni al cifrado de mensajes."}},"fa":{"stringUnit":{"state":"translated","value":"اعتبارنامه‌های پراکسی گام بیرونی را احراز هویت می‌کنند و در Keychain ذخیره می‌شوند. جایگزین Tor یا رمزنگاری پیام نیستند."}},"fil":{"stringUnit":{"state":"translated","value":"Pinapatunayan ng proxy credentials ang panlabas na hop at iniimbak sa Keychain. Hindi nito pinapalitan ang Tor o message encryption."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants authentifient le saut externe et sont stockés dans le Trousseau. Ils ne remplacent ni Tor ni le chiffrement des messages."}},"he":{"stringUnit":{"state":"translated","value":"פרטי המתווך מאמתים את הקפיצה החיצונית ונשמרים בצרור המפתחות. הם אינם מחליפים את Tor או את הצפנת ההודעות."}},"hi":{"stringUnit":{"state":"translated","value":"प्रॉक्सी क्रेडेंशियल बाहरी हॉप को प्रमाणित करते हैं और Keychain में रखे जाते हैं। वे Tor या संदेश एन्क्रिप्शन का विकल्प नहीं हैं।"}},"id":{"stringUnit":{"state":"translated","value":"Kredensial proxy mengautentikasi hop terluar dan disimpan di Keychain. Ini tidak menggantikan Tor atau enkripsi pesan."}},"it":{"stringUnit":{"state":"translated","value":"Le credenziali autenticano il passaggio esterno e sono salvate nel Portachiavi. Non sostituiscono Tor né la crittografia dei messaggi."}},"ja":{"stringUnit":{"state":"translated","value":"プロキシ認証情報は外側の接続を認証し、キーチェーンに保存されます。Torやメッセージ暗号化の代わりにはなりません。"}},"ko":{"stringUnit":{"state":"translated","value":"프록시 자격 증명은 외부 홉을 인증하며 키체인에 저장됩니다. Tor나 메시지 암호화를 대신하지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Kelayakan proksi mengesahkan hop luar dan disimpan dalam Keychain. Ia tidak menggantikan Tor atau penyulitan mesej."}},"ne":{"stringUnit":{"state":"translated","value":"प्रोक्सी प्रमाणले बाहिरी हप प्रमाणीकरण गर्छ र Keychain मा राखिन्छ। यसले Tor वा सन्देश गुप्तीकरणलाई प्रतिस्थापन गर्दैन।"}},"nl":{"stringUnit":{"state":"translated","value":"Proxyreferenties verifiëren de buitenste stap en worden in de Sleutelhanger bewaard. Ze vervangen Tor of berichtversleuteling niet."}},"pl":{"stringUnit":{"state":"translated","value":"Dane logowania uwierzytelniają zewnętrzny etap i są przechowywane w Pęku kluczy. Nie zastępują Tor ani szyfrowania wiadomości."}},"pt":{"stringUnit":{"state":"translated","value":"As credenciais autenticam o salto externo e são guardadas no Porta-chaves. Não substituem o Tor nem a encriptação das mensagens."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As credenciais autenticam o salto externo e ficam no Chaves. Elas não substituem o Tor nem a criptografia das mensagens."}},"ru":{"stringUnit":{"state":"translated","value":"Учётные данные подтверждают внешний переход и хранятся в Связке ключей. Они не заменяют Tor или шифрование сообщений."}},"sv":{"stringUnit":{"state":"translated","value":"Proxyuppgifter autentiserar det yttre hoppet och lagras i Nyckelhanterare. De ersätter inte Tor eller meddelandekryptering."}},"ta":{"stringUnit":{"state":"translated","value":"பதிலி சான்றுகள் வெளிப்புற இணைப்பை அங்கீகரித்து Keychain-இல் சேமிக்கப்படும். அவை Tor அல்லது செய்தி மறையாக்கத்திற்கு மாற்றல்ல."}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลรับรองใช้ยืนยันพร็อกซีชั้นนอกและเก็บในพวงกุญแจ โดยไม่แทนที่ Tor หรือการเข้ารหัสข้อความ"}},"tr":{"stringUnit":{"state":"translated","value":"Proxy kimlik bilgileri dış atlamayı doğrular ve Anahtar Zinciri’nde saklanır. Tor’un veya mesaj şifrelemesinin yerini almaz."}},"uk":{"stringUnit":{"state":"translated","value":"Облікові дані автентифікують зовнішній перехід і зберігаються у В’язці ключів. Вони не замінюють Tor чи шифрування повідомлень."}},"ur":{"stringUnit":{"state":"translated","value":"پراکسی اسناد بیرونی مرحلے کی تصدیق کرتی ہیں اور Keychain میں محفوظ ہوتی ہیں۔ یہ Tor یا پیغام کی خفیہ کاری کا بدل نہیں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin proxy xác thực chặng ngoài và được lưu trong Chuỗi khóa. Chúng không thay thế Tor hoặc mã hóa tin nhắn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"代理凭据用于验证最外层连接并存储在钥匙串中，不会取代 Tor 或消息加密。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"代理憑證用於驗證最外層連線並儲存在鑰匙圈中，不會取代 Tor 或訊息加密。"}}}},
    "app_info.settings.outer_proxy.apply": {"comment":"Button that saves and applies macOS proxy settings","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تطبيق الوكيل"}},"bn":{"stringUnit":{"state":"translated","value":"প্রক্সি প্রয়োগ করুন"}},"de":{"stringUnit":{"state":"translated","value":"Proxy anwenden"}},"en":{"stringUnit":{"state":"translated","value":"Apply Proxy"}},"es":{"stringUnit":{"state":"translated","value":"Aplicar proxy"}},"fa":{"stringUnit":{"state":"translated","value":"اعمال پراکسی"}},"fil":{"stringUnit":{"state":"translated","value":"Ilapat ang Proxy"}},"fr":{"stringUnit":{"state":"translated","value":"Appliquer le proxy"}},"he":{"stringUnit":{"state":"translated","value":"החל מתווך"}},"hi":{"stringUnit":{"state":"translated","value":"प्रॉक्सी लागू करें"}},"id":{"stringUnit":{"state":"translated","value":"Terapkan Proxy"}},"it":{"stringUnit":{"state":"translated","value":"Applica proxy"}},"ja":{"stringUnit":{"state":"translated","value":"プロキシを適用"}},"ko":{"stringUnit":{"state":"translated","value":"프록시 적용"}},"ms":{"stringUnit":{"state":"translated","value":"Gunakan Proksi"}},"ne":{"stringUnit":{"state":"translated","value":"प्रोक्सी लागू गर्नुहोस्"}},"nl":{"stringUnit":{"state":"translated","value":"Proxy toepassen"}},"pl":{"stringUnit":{"state":"translated","value":"Zastosuj proxy"}},"pt":{"stringUnit":{"state":"translated","value":"Aplicar proxy"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Aplicar proxy"}},"ru":{"stringUnit":{"state":"translated","value":"Применить прокси"}},"sv":{"stringUnit":{"state":"translated","value":"Använd proxy"}},"ta":{"stringUnit":{"state":"translated","value":"பதிலியைப் பயன்படுத்து"}},"th":{"stringUnit":{"state":"translated","value":"ใช้พร็อกซี"}},"tr":{"stringUnit":{"state":"translated","value":"Proxy’yi Uygula"}},"uk":{"stringUnit":{"state":"translated","value":"Застосувати проксі"}},"ur":{"stringUnit":{"state":"translated","value":"پراکسی لاگو کریں"}},"vi":{"stringUnit":{"state":"translated","value":"Áp dụng Proxy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用代理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"套用代理"}}}},
    "app_info.settings.outer_proxy.applied": {"comment":"Success status after applying proxy settings","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم تطبيق إعدادات الوكيل. تجري إعادة اتصال المرحّلات النشطة."}},"bn":{"stringUnit":{"state":"translated","value":"প্রক্সি সেটিংস প্রয়োগ হয়েছে। সক্রিয় রিলেগুলো পুনরায় সংযুক্ত হচ্ছে।"}},"de":{"stringUnit":{"state":"translated","value":"Proxy-Einstellungen angewendet. Aktive Relay-Verbindungen werden neu aufgebaut."}},"en":{"stringUnit":{"state":"translated","value":"Proxy settings applied. Active relay connections are reconnecting."}},"es":{"stringUnit":{"state":"translated","value":"Se aplicaron los ajustes del proxy. Los relays activos se están reconectando."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات پراکسی اعمال شد. رله‌های فعال دوباره متصل می‌شوند."}},"fil":{"stringUnit":{"state":"translated","value":"Nailapat ang proxy settings. Muling kumokonekta ang mga aktibong relay."}},"fr":{"stringUnit":{"state":"translated","value":"Réglages du proxy appliqués. Les relais actifs se reconnectent."}},"he":{"stringUnit":{"state":"translated","value":"הגדרות המתווך הוחלו. הממסרים הפעילים מתחברים מחדש."}},"hi":{"stringUnit":{"state":"translated","value":"प्रॉक्सी सेटिंग लागू हो गई। सक्रिय रिले फिर जुड़ रहे हैं।"}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan proxy diterapkan. Relay aktif sedang tersambung ulang."}},"it":{"stringUnit":{"state":"translated","value":"Impostazioni proxy applicate. I relay attivi si stanno riconnettendo."}},"ja":{"stringUnit":{"state":"translated","value":"プロキシ設定を適用しました。使用中のリレーに再接続しています。"}},"ko":{"stringUnit":{"state":"translated","value":"프록시 설정을 적용했습니다. 활성 릴레이에 다시 연결하고 있습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Tetapan proksi digunakan. Relay aktif sedang menyambung semula."}},"ne":{"stringUnit":{"state":"translated","value":"प्रोक्सी सेटिङ लागू भयो। सक्रिय रिलेहरू पुनः जडान हुँदैछन्।"}},"nl":{"stringUnit":{"state":"translated","value":"Proxy-instellingen toegepast. Actieve relays maken opnieuw verbinding."}},"pl":{"stringUnit":{"state":"translated","value":"Ustawienia proxy zastosowano. Aktywne przekaźniki łączą się ponownie."}},"pt":{"stringUnit":{"state":"translated","value":"Definições de proxy aplicadas. Os relays ativos estão a voltar a ligar-se."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Configurações de proxy aplicadas. Os relays ativos estão se reconectando."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки прокси применены. Активные ретрансляторы переподключаются."}},"sv":{"stringUnit":{"state":"translated","value":"Proxyinställningarna har tillämpats. Aktiva relayer återansluter."}},"ta":{"stringUnit":{"state":"translated","value":"பதிலி அமைப்புகள் பயன்படுத்தப்பட்டன. செயலில் உள்ள ரிலேக்கள் மீண்டும் இணைகின்றன."}},"th":{"stringUnit":{"state":"translated","value":"ใช้การตั้งค่าพร็อกซีแล้ว รีเลย์ที่ทำงานอยู่กำลังเชื่อมต่อใหม่"}},"tr":{"stringUnit":{"state":"translated","value":"Proxy ayarları uygulandı. Etkin relay’ler yeniden bağlanıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування проксі застосовано. Активні ретранслятори перепідключаються."}},"ur":{"stringUnit":{"state":"translated","value":"پراکسی ترتیبات لاگو ہو گئیں۔ فعال ریلے دوبارہ جڑ رہے ہیں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Đã áp dụng cài đặt proxy. Các relay đang kết nối lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"代理设置已应用，正在重新连接活动中继。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"代理設定已套用，正在重新連線使用中的中繼。"}}}},
    "app_info.settings.outer_proxy.error.settings": {"comment":"Validation error for an invalid custom proxy host or port","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تحقق من مضيف الوكيل وأدخل منفذًا من 1 إلى 65535."}},"bn":{"stringUnit":{"state":"translated","value":"প্রক্সি হোস্ট যাচাই করুন এবং 1 থেকে 65535 পর্যন্ত পোর্ট দিন।"}},"de":{"stringUnit":{"state":"translated","value":"Prüfe den Proxy-Host und gib einen Port von 1 bis 65535 ein."}},"en":{"stringUnit":{"state":"translated","value":"Check the proxy host and enter a port from 1 to 65535."}},"es":{"stringUnit":{"state":"translated","value":"Comprueba el host del proxy e introduce un puerto entre 1 y 65535."}},"fa":{"stringUnit":{"state":"translated","value":"میزبان پراکسی را بررسی و درگاهی بین ۱ تا ۶۵۵۳۵ وارد کنید."}},"fil":{"stringUnit":{"state":"translated","value":"Suriin ang proxy host at maglagay ng port mula 1 hanggang 65535."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez l’hôte du proxy et saisissez un port entre 1 et 65535."}},"he":{"stringUnit":{"state":"translated","value":"בדוק את מארח המתווך והזן יציאה בין 1 ל‑65535."}},"hi":{"stringUnit":{"state":"translated","value":"प्रॉक्सी होस्ट जाँचें और 1 से 65535 तक का पोर्ट दें।"}},"id":{"stringUnit":{"state":"translated","value":"Periksa host proxy dan masukkan port dari 1 hingga 65535."}},"it":{"stringUnit":{"state":"translated","value":"Controlla l’host del proxy e inserisci una porta da 1 a 65535."}},"ja":{"stringUnit":{"state":"translated","value":"プロキシのホストを確認し、1〜65535のポートを入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"프록시 호스트를 확인하고 1~65535 사이의 포트를 입력하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Semak hos proksi dan masukkan port antara 1 hingga 65535."}},"ne":{"stringUnit":{"state":"translated","value":"प्रोक्सी होस्ट जाँच्नुहोस् र 1 देखि 65535 सम्मको पोर्ट राख्नुहोस्।"}},"nl":{"stringUnit":{"state":"translated","value":"Controleer de proxyhost en voer een poort van 1 tot 65535 in."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź host proxy i podaj port od 1 do 65535."}},"pt":{"stringUnit":{"state":"translated","value":"Verifique o anfitrião do proxy e introduza uma porta entre 1 e 65535."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique o host do proxy e informe uma porta de 1 a 65535."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте хост прокси и укажите порт от 1 до 65535."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollera proxyvärden och ange en port mellan 1 och 65535."}},"ta":{"stringUnit":{"state":"translated","value":"பதிலி ஹோஸ்டைச் சரிபார்த்து 1 முதல் 65535 வரை போர்ட்டை உள்ளிடவும்."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบโฮสต์พร็อกซีและป้อนพอร์ตตั้งแต่ 1 ถึง 65535"}},"tr":{"stringUnit":{"state":"translated","value":"Proxy sunucusunu kontrol edin ve 1–65535 arasında bir bağlantı noktası girin."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірте хост проксі та введіть порт від 1 до 65535."}},"ur":{"stringUnit":{"state":"translated","value":"پراکسی ہوسٹ چیک کریں اور 1 سے 65535 تک پورٹ درج کریں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra máy chủ proxy và nhập cổng từ 1 đến 65535."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查代理主机，并输入 1 到 65535 之间的端口。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請檢查代理主機，並輸入 1 到 65535 之間的連接埠。"}}}},
    "app_info.settings.outer_proxy.error.credentials": {"comment":"Validation error for invalid custom proxy credentials","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"أدخل اسم المستخدم وكلمة المرور معًا، أو اتركهما فارغين."}},"bn":{"stringUnit":{"state":"translated","value":"ব্যবহারকারীর নাম ও পাসওয়ার্ড দুটিই দিন, অথবা দুটিই ফাঁকা রাখুন।"}},"de":{"stringUnit":{"state":"translated","value":"Gib Benutzername und Passwort ein oder lasse beide Felder leer."}},"en":{"stringUnit":{"state":"translated","value":"Enter both a username and password, or leave both empty."}},"es":{"stringUnit":{"state":"translated","value":"Introduce usuario y contraseña, o deja ambos campos vacíos."}},"fa":{"stringUnit":{"state":"translated","value":"نام کاربری و گذرواژه را هر دو وارد کنید یا هر دو را خالی بگذارید."}},"fil":{"stringUnit":{"state":"translated","value":"Ilagay ang username at password, o iwang walang laman ang pareho."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez le nom d’utilisateur et le mot de passe, ou laissez les deux vides."}},"he":{"stringUnit":{"state":"translated","value":"הזן שם משתמש וסיסמה, או השאר את שניהם ריקים."}},"hi":{"stringUnit":{"state":"translated","value":"उपयोगकर्ता नाम और पासवर्ड दोनों दें, या दोनों खाली छोड़ें।"}},"id":{"stringUnit":{"state":"translated","value":"Masukkan nama pengguna dan kata sandi, atau kosongkan keduanya."}},"it":{"stringUnit":{"state":"translated","value":"Inserisci nome utente e password oppure lascia vuoti entrambi."}},"ja":{"stringUnit":{"state":"translated","value":"ユーザー名とパスワードを両方入力するか、両方を空欄にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"사용자 이름과 암호를 모두 입력하거나 둘 다 비워 두세요."}},"ms":{"stringUnit":{"state":"translated","value":"Masukkan nama pengguna dan kata laluan, atau biarkan kedua-duanya kosong."}},"ne":{"stringUnit":{"state":"translated","value":"प्रयोगकर्ता नाम र पासवर्ड दुवै राख्नुहोस्, वा दुवै खाली छोड्नुहोस्।"}},"nl":{"stringUnit":{"state":"translated","value":"Voer zowel een gebruikersnaam als wachtwoord in, of laat beide leeg."}},"pl":{"stringUnit":{"state":"translated","value":"Podaj nazwę użytkownika i hasło albo pozostaw oba pola puste."}},"pt":{"stringUnit":{"state":"translated","value":"Introduza o nome de utilizador e a palavra-passe, ou deixe ambos vazios."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Informe o nome de usuário e a senha, ou deixe ambos vazios."}},"ru":{"stringUnit":{"state":"translated","value":"Введите имя пользователя и пароль или оставьте оба поля пустыми."}},"sv":{"stringUnit":{"state":"translated","value":"Ange både användarnamn och lösenord eller lämna båda tomma."}},"ta":{"stringUnit":{"state":"translated","value":"பயனர் பெயர் மற்றும் கடவுச்சொல் இரண்டையும் உள்ளிடவும் அல்லது இரண்டையும் காலியாக விடவும்."}},"th":{"stringUnit":{"state":"translated","value":"ป้อนทั้งชื่อผู้ใช้และรหัสผ่าน หรือเว้นทั้งสองช่อง"}},"tr":{"stringUnit":{"state":"translated","value":"Hem kullanıcı adını hem parolayı girin veya ikisini de boş bırakın."}},"uk":{"stringUnit":{"state":"translated","value":"Введіть ім’я користувача й пароль або залиште обидва поля порожніми."}},"ur":{"stringUnit":{"state":"translated","value":"صارف نام اور پاس ورڈ دونوں درج کریں، یا دونوں خالی چھوڑ دیں۔"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập cả tên người dùng và mật khẩu, hoặc để trống cả hai."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请同时输入用户名和密码，或将两者都留空。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請同時輸入使用者名稱和密碼，或將兩者都留空。"}}}},
    "app_info.settings.outer_proxy.error.save": {"comment":"Error shown when saving the proxy password fails","extractionState":"manual","localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعذر حفظ كلمة مرور الوكيل في سلسلة المفاتيح."}},"bn":{"stringUnit":{"state":"translated","value":"প্রক্সি পাসওয়ার্ড Keychain-এ সংরক্ষণ করা যায়নি।"}},"de":{"stringUnit":{"state":"translated","value":"Das Proxy-Passwort konnte nicht im Schlüsselbund gespeichert werden."}},"en":{"stringUnit":{"state":"translated","value":"The proxy password could not be saved to Keychain."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la contraseña del proxy en el Llavero."}},"fa":{"stringUnit":{"state":"translated","value":"گذرواژه پراکسی در Keychain ذخیره نشد."}},"fil":{"stringUnit":{"state":"translated","value":"Hindi ma-save sa Keychain ang proxy password."}},"fr":{"stringUnit":{"state":"translated","value":"Le mot de passe du proxy n’a pas pu être enregistré dans le Trousseau."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן לשמור את סיסמת המתווך בצרור המפתחות."}},"hi":{"stringUnit":{"state":"translated","value":"प्रॉक्सी पासवर्ड Keychain में सहेजा नहीं जा सका।"}},"id":{"stringUnit":{"state":"translated","value":"Kata sandi proxy tidak dapat disimpan ke Keychain."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare la password del proxy nel Portachiavi."}},"ja":{"stringUnit":{"state":"translated","value":"プロキシのパスワードをキーチェーンに保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"프록시 암호를 키체인에 저장할 수 없습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Kata laluan proksi tidak dapat disimpan dalam Keychain."}},"ne":{"stringUnit":{"state":"translated","value":"प्रोक्सी पासवर्ड Keychain मा सुरक्षित गर्न सकिएन।"}},"nl":{"stringUnit":{"state":"translated","value":"Het proxywachtwoord kon niet in de Sleutelhanger worden bewaard."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać hasła proxy w Pęku kluczy."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível guardar a palavra-passe do proxy no Porta-chaves."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a senha do proxy no Chaves."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить пароль прокси в Связке ключей."}},"sv":{"stringUnit":{"state":"translated","value":"Proxylösenordet kunde inte sparas i Nyckelhanterare."}},"ta":{"stringUnit":{"state":"translated","value":"பதிலி கடவுச்சொல்லை Keychain-இல் சேமிக்க முடியவில்லை."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกรหัสผ่านพร็อกซีในพวงกุญแจได้"}},"tr":{"stringUnit":{"state":"translated","value":"Proxy parolası Anahtar Zinciri’ne kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти пароль проксі у В’язці ключів."}},"ur":{"stringUnit":{"state":"translated","value":"پراکسی پاس ورڈ Keychain میں محفوظ نہیں ہو سکا۔"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu mật khẩu proxy vào Chuỗi khóa."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法将代理密码存储到钥匙串。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法將代理密碼儲存到鑰匙圈。"}}}},
