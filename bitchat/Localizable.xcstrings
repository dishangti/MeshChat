    "app_info.settings.notifications.denied.message": {
      "comment": "Explanation shown when system notification permission has been denied",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ MeshChat عرض التنبيهات حتى تسمح بالإشعارات في إعدادات النظام. ستدخل اختياراتك أدناه حيز التنفيذ عند استعادة الإذن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে বিজ্ঞপ্তির অনুমতি না দেওয়া পর্যন্ত MeshChat সতর্কতা দেখাতে পারবে না। অনুমতি ফিরলে নিচের পছন্দগুলো কার্যকর হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat kann keine Hinweise anzeigen, bis Mitteilungen in den Systemeinstellungen erlaubt sind. Deine Auswahl unten wird wirksam, sobald die Berechtigung wieder erteilt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat cannot show alerts until notifications are allowed in System Settings. Your choices below will take effect when permission is restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat no puede mostrar avisos hasta que permitas las notificaciones en Ajustes del sistema. Las opciones de abajo se aplicarán cuando restaures el permiso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که اعلان‌ها را در تنظیمات سیستم مجاز نکنید، MeshChat نمی‌تواند هشدارها را نمایش دهد. انتخاب‌های زیر پس از بازگرداندن مجوز اعمال می‌شوند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makapagpapakita ng alerto ang MeshChat hangga't hindi pinapayagan ang mga notification sa System Settings. Magkakabisa ang mga pagpili sa ibaba kapag naibalik ang pahintulot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat ne peut pas afficher d’alertes tant que les notifications ne sont pas autorisées dans Réglages système. Les choix ci-dessous prendront effet une fois l’autorisation rétablie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat לא יכול להציג התראות עד שהן יאושרו בהגדרות המערכת. הבחירות שלמטה ייכנסו לתוקף לאחר שחזור ההרשאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स में सूचनाओं की अनुमति मिलने तक MeshChat अलर्ट नहीं दिखा सकता। अनुमति बहाल होने पर नीचे के विकल्प लागू होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat tidak dapat menampilkan peringatan sampai notifikasi diizinkan di Pengaturan Sistem. Pilihan di bawah akan berlaku setelah izin dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat non può mostrare avvisi finché le notifiche non vengono consentite in Impostazioni di Sistema. Le scelte qui sotto avranno effetto quando ripristinerai il permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で通知を許可するまで、MeshChatは通知を表示できません。許可を元に戻すと、以下の選択が有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 알림을 허용할 때까지 MeshChat에서 알림을 표시할 수 없습니다. 권한을 복원하면 아래 선택 사항이 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat tidak boleh memaparkan amaran sehingga pemberitahuan dibenarkan dalam Tetapan Sistem. Pilihan di bawah akan berkuat kuasa apabila kebenaran dipulihkan."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रणाली सेटिङमा सूचनाको अनुमति नदिएसम्म MeshChat ले अलर्ट देखाउन सक्दैन। अनुमति पुनःस्थापित भएपछि तलका छनोटहरू लागू हुनेछन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat kan geen meldingen tonen totdat je ze toestaat in Systeeminstellingen. De keuzes hieronder worden actief zodra de toestemming is hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat nie może wyświetlać alertów, dopóki powiadomienia nie zostaną dozwolone w Ustawieniach systemowych. Poniższe wybory zaczną działać po przywróceniu uprawnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MeshChat não pode mostrar alertas até permitir as notificações nas Definições do Sistema. As escolhas abaixo terão efeito quando a permissão for restaurada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MeshChat não pode mostrar alertas até que as notificações sejam permitidas nos Ajustes do Sistema. As opções abaixo terão efeito quando a permissão for restaurada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat не может показывать оповещения, пока уведомления не разрешены в системных настройках. Выбранные ниже параметры начнут действовать после восстановления разрешения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat kan inte visa notiser förrän de tillåts i Systeminställningar. Valen nedan börjar gälla när behörigheten återställs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி அமைப்புகளில் அறிவிப்புகளை அனுமதிக்கும் வரை MeshChat விழிப்பூட்டல்களைக் காட்ட முடியாது. அனுமதி மீட்டமைக்கப்பட்டதும் கீழே உள்ள தேர்வுகள் செயல்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat ไม่สามารถแสดงการแจ้งเตือนได้จนกว่าจะอนุญาตในการตั้งค่าระบบ ตัวเลือกด้านล่างจะมีผลเมื่อคืนสิทธิ์แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nda bildirimlere izin verilene kadar MeshChat uyarı gösteremez. İzin geri verildiğinde aşağıdaki seçimler geçerli olacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat не може показувати сповіщення, доки їх не дозволено в системних параметрах. Вибрані нижче параметри почнуть діяти після відновлення дозволу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک سسٹم سیٹنگز میں اطلاعات کی اجازت نہیں دی جاتی، MeshChat انتباہات نہیں دکھا سکتا۔ اجازت بحال ہونے پر نیچے کے انتخابات لاگو ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat không thể hiển thị cảnh báo cho đến khi thông báo được cho phép trong Cài đặt hệ thống. Các lựa chọn bên dưới sẽ có hiệu lực khi quyền được khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中允许通知前，MeshChat 无法显示提醒。恢复权限后，下方选项将生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定」中允許通知前，MeshChat 無法顯示提醒。恢復權限後，下方選項將生效。"
          }
        }
      }
    },
