    "recent_chat.delete.confirm_message": {
      "comment": "Explanation shown before deleting a Recent chat and its local history",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يؤدي هذا إلى إزالة الدردشة من «الأخيرة» وحذف سجلها من هذا الجهاز. تظل إعدادات الهوية محفوظة، وقد تظهر الدردشة مجددًا عند وصول رسالة جديدة." } },
        "bn": { "stringUnit": { "state": "translated", "value": "এটি সাম্প্রতিক থেকে চ্যাটটি সরিয়ে এই ডিভাইসের ইতিহাস মুছে দেবে। পরিচয় সেটিংস সংরক্ষিত থাকবে, আর নতুন বার্তা এলে চ্যাটটি আবার দেখা যেতে পারে।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Dadurch wird der Chat aus „Zuletzt“ entfernt und sein Verlauf von diesem Gerät gelöscht. Identitätseinstellungen bleiben erhalten; bei einer neuen Nachricht kann der Chat wieder erscheinen." } },
        "en": { "stringUnit": { "state": "translated", "value": "This removes the chat from Recent and deletes its history from this device. Identity settings are preserved, and a new message may make the chat appear again." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esto quita el chat de Recientes y elimina su historial de este dispositivo. Se conservan los ajustes de identidad y un mensaje nuevo puede hacer que vuelva a aparecer." } },
        "fa": { "stringUnit": { "state": "translated", "value": "با این کار، گفت‌وگو از «اخیر» حذف و تاریخچه آن از این دستگاه پاک می‌شود. تنظیمات هویت حفظ می‌شوند و ممکن است با پیام جدید دوباره ظاهر شود." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Aalisin nito ang chat sa Kamakailan at buburahin ang history nito sa device na ito. Mananatili ang mga setting ng identity, at maaari itong lumitaw muli kapag may bagong mensahe." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cela retire la discussion de Récents et supprime son historique de cet appareil. Les réglages d’identité sont conservés et un nouveau message peut la faire réapparaître." } },
        "he": { "stringUnit": { "state": "translated", "value": "הפעולה תסיר את הצ׳אט מהאחרונים ותמחק את ההיסטוריה שלו מהמכשיר הזה. הגדרות הזהות יישמרו, והודעה חדשה עשויה להציג אותו שוב." } },
        "hi": { "stringUnit": { "state": "translated", "value": "यह चैट को हाल के चैट से हटाकर इसका इतिहास इस डिवाइस से मिटा देगा। पहचान सेटिंग सुरक्षित रहेंगी और नया संदेश आने पर चैट फिर दिखाई दे सकती है।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Ini menghapus chat dari Terbaru dan menghapus riwayatnya dari perangkat ini. Pengaturan identitas tetap disimpan, dan pesan baru dapat membuat chat muncul kembali." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa operazione rimuove la chat da Recenti e ne elimina la cronologia dal dispositivo. Le impostazioni dell’identità vengono conservate e un nuovo messaggio può farla ricomparire." } },
        "ja": { "stringUnit": { "state": "translated", "value": "「最近」からチャットを削除し、このデバイス上の履歴を消去します。ID設定は保持され、新しいメッセージが届くと再表示される場合があります。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "최근 목록에서 채팅을 제거하고 이 기기의 기록을 삭제합니다. 신원 설정은 유지되며 새 메시지가 오면 채팅이 다시 나타날 수 있습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Ini mengalih keluar sembang daripada Terbaharu dan memadamkan sejarahnya daripada peranti ini. Tetapan identiti dikekalkan dan mesej baharu mungkin memaparkannya semula." } },
        "ne": { "stringUnit": { "state": "translated", "value": "यसले च्याटलाई हालैका च्याटबाट हटाएर यसको इतिहास यस यन्त्रबाट मेटाउँछ। पहिचान सेटिङ सुरक्षित रहन्छन् र नयाँ सन्देश आएमा च्याट फेरि देखिन सक्छ।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Hiermee wordt de chat uit Recent verwijderd en de geschiedenis van dit apparaat gewist. Identiteitsinstellingen blijven behouden; een nieuw bericht kan de chat opnieuw laten verschijnen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Spowoduje to usunięcie czatu z Ostatnich i jego historii z tego urządzenia. Ustawienia tożsamości zostaną zachowane, a nowa wiadomość może przywrócić czat na listę." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Isto remove a conversa de Recentes e elimina o histórico deste dispositivo. As definições de identidade são preservadas e uma nova mensagem pode fazê-la reaparecer." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Isso remove a conversa de Recentes e exclui o histórico deste dispositivo. As configurações de identidade são preservadas, e uma nova mensagem pode fazê-la reaparecer." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Чат будет удалён из недавних, а его история — с этого устройства. Настройки личности сохранятся, и новое сообщение может вернуть чат в список." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Detta tar bort chatten från Senaste och raderar historiken från den här enheten. Identitetsinställningarna bevaras och ett nytt meddelande kan visa chatten igen." } },
        "ta": { "stringUnit": { "state": "translated", "value": "இது அண்மைய பட்டியலிலிருந்து அரட்டையை அகற்றி, இந்தச் சாதனத்திலுள்ள அதன் வரலாற்றை நீக்கும். அடையாள அமைப்புகள் பாதுகாக்கப்படும்; புதிய செய்தி வந்தால் அரட்டை மீண்டும் தோன்றலாம்." } },
        "th": { "stringUnit": { "state": "translated", "value": "การดำเนินการนี้จะนำแชทออกจากรายการล่าสุดและลบประวัติออกจากอุปกรณ์นี้ โดยยังคงการตั้งค่าข้อมูลประจำตัวไว้ และแชทอาจปรากฏอีกเมื่อมีข้อความใหม่" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu işlem sohbeti Son Kullanılanlar’dan kaldırır ve geçmişini bu cihazdan siler. Kimlik ayarları korunur; yeni bir mesaj sohbeti yeniden gösterebilir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Чат буде видалено з недавніх, а його історію — із цього пристрою. Налаштування особи збережуться, і нове повідомлення може повернути чат до списку." } },
        "ur": { "stringUnit": { "state": "translated", "value": "اس سے چیٹ حالیہ فہرست سے ہٹ جائے گی اور اس کی سرگزشت اس ڈیوائس سے حذف ہوگی۔ شناخت کی ترتیبات محفوظ رہیں گی، اور نیا پیغام چیٹ کو دوبارہ دکھا سکتا ہے۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thao tác này xóa cuộc trò chuyện khỏi Gần đây và xóa lịch sử trên thiết bị này. Các cài đặt danh tính vẫn được giữ lại, và tin nhắn mới có thể khiến cuộc trò chuyện xuất hiện lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这会从“最近”中移除该聊天，并删除此设备上的聊天记录。身份设置会保留；收到新消息后，该聊天可能会再次出现。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這會從「最近」中移除該聊天，並刪除此裝置上的聊天記錄。身分設定會保留；收到新訊息後，該聊天可能會再次出現。" } }
      }
    },
    "meshchat.help.chats.title": {
