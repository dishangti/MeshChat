    "channel.share.payload": {
      "comment": "Plain-text share payload for a location channel; %1$@ is the geohash, %2$@ is the App Store URL",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم إلى قناة #%1$@ على MeshChat: bitchat://geohash/%1$@ — جديد على MeshChat؟ حمّله من %2$@ ثم اكتب #%1$@ ضمن قنوات الموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat-এ #%1$@ চ্যানেলে যোগ দিন: bitchat://geohash/%1$@ — MeshChat-এ নতুন? %2$@ থেকে নিন, তারপর লোকেশন চ্যানেলে #%1$@ টাইপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tritt dem #%1$@-kanal auf MeshChat bei: bitchat://geohash/%1$@ — neu bei MeshChat? hole es unter %2$@ und tippe dann #%1$@ unter standort-kanäle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the #%1$@ channel on MeshChat: bitchat://geohash/%1$@ — new to MeshChat? Get it at %2$@ then type #%1$@ under location channels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "únete al canal #%1$@ en MeshChat: bitchat://geohash/%1$@ — ¿nuevo en MeshChat? consíguelo en %2$@ y luego escribe #%1$@ en canales de ubicación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به کانال #%1$@ در MeshChat بپیوندید: bitchat://geohash/%1$@ — تازه‌واردید؟ از %2$@ بگیرید و سپس #%1$@ را در کانال‌های موقعیت وارد کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "sumali sa #%1$@ channel sa MeshChat: bitchat://geohash/%1$@ — bago sa MeshChat? kunin ito sa %2$@ tapos i-type ang #%1$@ sa mga channel ng lokasyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "rejoins le canal #%1$@ sur MeshChat : bitchat://geohash/%1$@ — nouveau sur MeshChat ? télécharge-le sur %2$@ puis saisis #%1$@ dans les canaux localisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצטרף לערוץ #%1$@ ב-MeshChat: bitchat://geohash/%1$@ — חדש ב-MeshChat? הורד מ-%2$@ ואז הקלד #%1$@ תחת ערוצי מיקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat पर #%1$@ चैनल से जुड़ें: bitchat://geohash/%1$@ — MeshChat नए हैं? %2$@ से पाएँ, फिर लोकेशन चैनल में #%1$@ टाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "gabung ke kanal #%1$@ di MeshChat: bitchat://geohash/%1$@ — baru di MeshChat? unduh di %2$@ lalu ketik #%1$@ di kanal lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "entra nel canale #%1$@ su MeshChat: bitchat://geohash/%1$@ — nuovo su MeshChat? scaricalo da %2$@ e poi digita #%1$@ nei canali posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChatの#%1$@チャンネルに参加: bitchat://geohash/%1$@ — はじめてですか？ %2$@ から入手し、ロケーションチャンネルで #%1$@ と入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat의 #%1$@ 채널에 참여하세요: bitchat://geohash/%1$@ — MeshChat이 처음이신가요? %2$@에서 받은 뒤 위치 채널에서 #%1$@을(를) 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "sertai saluran #%1$@ di MeshChat: bitchat://geohash/%1$@ — baharu di MeshChat? dapatkannya di %2$@ kemudian taip #%1$@ di bawah kanal lokasi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat मा #%1$@ च्यानलमा सामेल हुनुहोस्: bitchat://geohash/%1$@ — MeshChat मा नयाँ? %2$@ बाट लिनुहोस्, त्यसपछि स्थान च्यानलमा #%1$@ टाइप गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "doe mee met het #%1$@-kanaal op MeshChat: bitchat://geohash/%1$@ — nieuw bij MeshChat? haal het op %2$@ en typ daarna #%1$@ onder locatiekanalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dołącz do kanału #%1$@ w MeshChat: bitchat://geohash/%1$@ — nowość w MeshChat? pobierz z %2$@, a potem wpisz #%1$@ w kanałach lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "junta-te ao canal #%1$@ no MeshChat: bitchat://geohash/%1$@ — novo no MeshChat? obtém-no em %2$@ e depois escreve #%1$@ em canais de localização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "entre no canal #%1$@ no MeshChat: bitchat://geohash/%1$@ — novo no MeshChat? baixe em %2$@ e depois digite #%1$@ em canais de localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "присоединяйся к каналу #%1$@ в MeshChat: bitchat://geohash/%1$@ — впервые в MeshChat? скачай на %2$@, затем введи #%1$@ в каналах локации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "gå med i #%1$@-kanalen på MeshChat: bitchat://geohash/%1$@ — ny på MeshChat? hämta den på %2$@ och skriv sedan #%1$@ under platskanaler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat-இல் #%1$@ சேனலில் சேரவும்: bitchat://geohash/%1$@ — MeshChat புதியவரா? %2$@ இல் பெற்று, பின்னர் இட சேனல்களில் #%1$@ என தட்டச்சு செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าร่วมช่อง #%1$@ บน MeshChat: bitchat://geohash/%1$@ — ใหม่กับ MeshChat? ดาวน์โหลดที่ %2$@ แล้วพิมพ์ #%1$@ ในช่องตามตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat'te #%1$@ kanalına katıl: bitchat://geohash/%1$@ — MeshChat'te yeni misin? %2$@ adresinden indir, sonra konum kanallarında #%1$@ yaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "приєднуйся до каналу #%1$@ у MeshChat: bitchat://geohash/%1$@ — вперше в MeshChat? завантаж на %2$@, потім введи #%1$@ у каналах локації."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat پر #%1$@ چینل میں شامل ہوں: bitchat://geohash/%1$@ — MeshChat نئے ہیں؟ %2$@ سے حاصل کریں، پھر لوکیشن چینلز میں #%1$@ ٹائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "tham gia kênh #%1$@ trên MeshChat: bitchat://geohash/%1$@ — mới dùng MeshChat? tải tại %2$@ rồi nhập #%1$@ trong kênh vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 MeshChat 上的 #%1$@ 频道：bitchat://geohash/%1$@ — 初次使用 MeshChat？前往 %2$@ 获取，然后在位置频道中输入 #%1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 MeshChat 上的 #%1$@ 頻道：bitchat://geohash/%1$@ — 初次使用 MeshChat？前往 %2$@ 取得，然後在位置頻道中輸入 #%1$@。"
          }
        }
      }
    },
