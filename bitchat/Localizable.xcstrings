    "app_info.settings.language.restart_note": {
      "comment": "Caption shown after the user picks a different app language; the change takes effect on next launch",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل MeshChat لتطبيق اللغة الجديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষা প্রয়োগ করতে MeshChat পুনরায় চালু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat neu starten, um die neue Sprache zu übernehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart MeshChat to apply the new language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "reinicia MeshChat para aplicar el nuevo idioma"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اعمال زبان جدید، MeshChat را دوباره باز کنید"
