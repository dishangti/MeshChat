        "ta": { "stringUnit": { "state": "translated", "value": "அரட்டையை நீக்கு" } },
        "th": { "stringUnit": { "state": "translated", "value": "ลบแชท" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sohbeti Sil" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Видалити чат" } },
        "ur": { "stringUnit": { "state": "translated", "value": "چیٹ حذف کریں" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Xóa cuộc trò chuyện" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除聊天" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除聊天" } }
      }
    },
    "recent_chat.delete.confirm_title": {
