    },
    "friends.remove.confirm_message": {
      "comment": "Explanation that removing a friend preserves local conversation and identity state",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "سيتم الاحتفاظ بسجل الدردشة والاسم المستعار المحلي والتحقق وإعداد الحظر." } },
        "bn": { "stringUnit": { "state": "translated", "value": "তাদের চ্যাটের ইতিহাস, স্থানীয় ডাকনাম, যাচাইকরণ ও ব্লক সেটিং সংরক্ষিত থাকবে।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Chatverlauf, lokaler Spitzname, Verifizierung und Blockierung bleiben erhalten." } },
        "en": { "stringUnit": { "state": "translated", "value": "Their chat history, local nickname, verification, and block setting will be preserved." } },
        "es": { "stringUnit": { "state": "translated", "value": "Se conservarán su historial de chat, apodo local, verificación y ajuste de bloqueo." } },
        "fa": { "stringUnit": { "state": "translated", "value": "تاریخچه گفت‌وگو، نام مستعار محلی، تأیید و تنظیم مسدودسازی او حفظ می‌شود." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Mananatili ang chat history, lokal na palayaw, verification, at block setting nila." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Son historique de discussion, son surnom local, sa vérification et son réglage de blocage seront conservés." } },
        "he": { "stringUnit": { "state": "translated", "value": "היסטוריית הצ׳אט, הכינוי המקומי, האימות והגדרת החסימה יישמרו." } },
        "hi": { "stringUnit": { "state": "translated", "value": "उनका चैट इतिहास, स्थानीय उपनाम, सत्यापन और ब्लॉक सेटिंग सुरक्षित रहेंगी।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Riwayat chat, nama panggilan lokal, verifikasi, dan pengaturan blokirnya tetap disimpan." } },
        "it": { "stringUnit": { "state": "translated", "value": "La cronologia chat, il soprannome locale, la verifica e l’impostazione di blocco saranno conservati." } },
        "ja": { "stringUnit": { "state": "translated", "value": "チャット履歴、ローカルニックネーム、認証、ブロック設定は保持されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "채팅 기록, 로컬 별명, 인증 및 차단 설정은 유지됩니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Sejarah sembang, nama panggilan setempat, pengesahan dan tetapan sekatan mereka akan dikekalkan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "उनीहरूको च्याट इतिहास, स्थानीय उपनाम, प्रमाणीकरण र ब्लक सेटिङ सुरक्षित रहनेछन्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "De chatgeschiedenis, lokale bijnaam, verificatie en blokkeerinstelling blijven behouden." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Historia czatu, lokalny pseudonim, weryfikacja i ustawienie blokady zostaną zachowane." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O histórico da conversa, a alcunha local, a verificação e a definição de bloqueio serão preservados." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O histórico da conversa, o apelido local, a verificação e a configuração de bloqueio serão preservados." } },
        "ru": { "stringUnit": { "state": "translated", "value": "История чата, локальное имя, проверка и настройка блокировки сохранятся." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Chatthistorik, lokalt smeknamn, verifiering och blockeringsinställning bevaras." } },
        "ta": { "stringUnit": { "state": "translated", "value": "அவர்களின் அரட்டை வரலாறு, உள்ளூர் புனைப்பெயர், சரிபார்ப்பு மற்றும் தடுப்பு அமைப்பு பாதுகாக்கப்படும்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ประวัติแชท ชื่อเล่นในเครื่อง การยืนยัน และการตั้งค่าการบล็อกจะยังคงอยู่" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sohbet geçmişi, yerel takma ad, doğrulama ve engelleme ayarı korunur." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Історія чату, локальне ім’я, перевірка та налаштування блокування збережуться." } },
        "ur": { "stringUnit": { "state": "translated", "value": "ان کی چیٹ کی سرگزشت، مقامی عرف، تصدیق اور بلاک کی ترتیب محفوظ رہے گی۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Lịch sử trò chuyện, biệt danh cục bộ, trạng thái xác minh và cài đặt chặn của họ sẽ được giữ lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "对方的聊天记录、本地昵称、验证状态和拉黑设置都会保留。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "對方的聊天記錄、本機暱稱、驗證狀態和封鎖設定都會保留。" } }
      }
    },
    "recent_chat.delete.action": {
      "comment": "Destructive action that deletes one Recent conversation and its local history",
