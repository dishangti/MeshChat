    "content.alert.recording_error.start_failed": {
      "comment": "Error shown when neither live nor fallback voice recording can start",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تعذر بدء التسجيل." } },
        "bn": { "stringUnit": { "state": "translated", "value": "রেকর্ডিং শুরু করা যায়নি।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Aufnahme konnte nicht gestartet werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "Could not start recording." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo iniciar la grabación." } },
        "fa": { "stringUnit": { "state": "translated", "value": "ضبط شروع نشد." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Hindi masimulan ang pagre-record." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de démarrer l’enregistrement." } },
        "he": { "stringUnit": { "state": "translated", "value": "לא ניתן להתחיל בהקלטה." } },
        "hi": { "stringUnit": { "state": "translated", "value": "रिकॉर्डिंग शुरू नहीं की जा सकी।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tidak dapat memulai perekaman." } },
        "it": { "stringUnit": { "state": "translated", "value": "Impossibile avviare la registrazione." } },
        "ja": { "stringUnit": { "state": "translated", "value": "録音を開始できませんでした。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "녹음을 시작할 수 없습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Rakaman tidak dapat dimulakan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "रेकर्डिङ सुरु गर्न सकिएन।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "De opname kon niet worden gestart." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Nie udało się rozpocząć nagrywania." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Não foi possível iniciar a gravação." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Não foi possível iniciar a gravação." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось начать запись." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Det gick inte att starta inspelningen." } },
        "ta": { "stringUnit": { "state": "translated", "value": "பதிவைத் தொடங்க முடியவில்லை." } },
        "th": { "stringUnit": { "state": "translated", "value": "ไม่สามารถเริ่มการบันทึกได้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Kayıt başlatılamadı." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Не вдалося почати запис." } },
        "ur": { "stringUnit": { "state": "translated", "value": "ریکارڈنگ شروع نہیں ہو سکی۔" } },
