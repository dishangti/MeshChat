        "ms": { "stringUnit": { "state": "translated", "value": "Tetapkan Semula Identiti" } },
        "ne": { "stringUnit": { "state": "translated", "value": "पहिचान रिसेट गर्नुहोस्" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Identiteit resetten" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zresetuj tożsamość" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Repor identidade" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Redefinir identidade" } },
