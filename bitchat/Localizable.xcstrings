            "state": "translated",
            "value": "Abre as definições para ligar ou desligar o gateway"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as configurações para ligar ou desligar o gateway"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает настройки, чтобы включить или выключить шлюз"
