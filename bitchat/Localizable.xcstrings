      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رمز QR هذا أو أن ساعتي الجهازين غير متطابقتين. اطلب من الشخص الآخر إعادة فتحه، ثم امسحه ضوئيًا مرة أخرى."
          }
