        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই QR কোডটির মেয়াদ শেষ হয়ে গেছে অথবা ডিভাইস দুটির ঘড়ির সময় মিলছে না। অন্য ব্যক্তিকে এটি আবার খুলতে বলুন, তারপর আবার স্ক্যান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code ist abgelaufen oder die Uhren der Geräte stimmen nicht überein. Bitte die andere Person, ihn erneut zu öffnen, und scanne ihn dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This QR code has expired or the devices' clocks differ. Ask the other person to reopen it, then scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR ha caducado o los relojes de los dispositivos no coinciden. Pide a la otra persona que vuelva a abrirlo y escanéalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد QR منقضی شده است یا ساعت دستگاه‌ها با هم مطابقت ندارد. از طرف مقابل بخواهید آن را دوباره باز کند، سپس دوباره اسکن کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang QR code na ito o hindi tugma ang oras ng mga device. Hilingin sa kausap na buksan itong muli, pagkatapos ay i-scan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code QR a expiré ou les horloges des appareils ne sont pas synchronisées. Demandez à l’autre personne de le rouvrir, puis scannez-le à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקפו של קוד ה-QR הזה או שהשעונים במכשירים אינם תואמים. בקשו מהאדם השני לפתוח אותו מחדש ואז סרקו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह QR कोड समाप्त हो गया है या दोनों डिवाइसों की घड़ियों में अंतर है। दूसरे व्यक्ति से इसे फिर से खोलने के लिए कहें, फिर दोबारा स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode QR ini telah kedaluwarsa atau waktu pada kedua perangkat berbeda. Minta orang lain membukanya kembali, lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice QR è scaduto oppure gli orologi dei dispositivi non sono sincronizzati. Chiedi all’altra persona di riaprirlo, quindi scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このQRコードは有効期限が切れているか、端末間で時刻がずれています。相手にQRコードを開き直してもらい、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 QR 코드는 만료되었거나 두 기기의 시간이 일치하지 않습니다. 상대방에게 QR 코드를 다시 열어 달라고 한 후 다시 스캔하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod QR ini telah tamat tempoh atau waktu pada kedua-dua peranti tidak sepadan. Minta orang lain membukanya semula, kemudian imbas sekali lagi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो QR कोडको म्याद सकिएको छ वा दुई उपकरणका घडीहरू फरक छन्। अर्को व्यक्तिलाई यसलाई फेरि खोल्न भन्नुहोस्, त्यसपछि फेरि स्क्यान गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze QR-code is verlopen of de klokken van de apparaten lopen niet gelijk. Vraag de andere persoon om de code opnieuw te openen en scan hem daarna nogmaals."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod QR wygasł albo zegary urządzeń nie są zsynchronizowane. Poproś drugą osobę, aby otworzyła go ponownie, a następnie zeskanuj go jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR expirou ou os relógios dos dispositivos não estão sincronizados. Peça à outra pessoa para o voltar a abrir e, em seguida, digitalize-o novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR Code expirou ou os relógios dos dispositivos não estão sincronizados. Peça à outra pessoa para abri-lo novamente e escaneie outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого QR-кода истёк, либо часы на устройствах не совпадают. Попросите собеседника снова открыть его, а затем повторите сканирование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här QR-koden har gått ut eller så går enheternas klockor olika. Be den andra personen att öppna den igen och skanna sedan på nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த QR குறியீடு காலாவதியாகிவிட்டது அல்லது இரு சாதனங்களின் கடிகார நேரங்களும் பொருந்தவில்லை. மற்றவரிடம் அதை மீண்டும் திறக்கச் சொல்லி, பின்னர் மீண்டும் ஸ்கேன் செய்யுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัส QR นี้หมดอายุแล้ว หรือเวลาของอุปกรณ์ทั้งสองไม่ตรงกัน โปรดให้อีกฝ่ายเปิดรหัสนี้ใหม่ แล้วสแกนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu QR kodunun süresi dolmuş veya cihazların saatleri uyuşmuyor. Diğer kişiden kodu yeniden açmasını isteyin, ardından tekrar tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії цього QR-коду минув або годинники на пристроях не збігаються. Попросіть співрозмовника знову відкрити його, а потім відскануйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس QR کوڈ کی میعاد ختم ہو چکی ہے یا دونوں ڈیوائسز کی گھڑیوں میں فرق ہے۔ دوسرے شخص سے اسے دوبارہ کھولنے کو کہیں، پھر دوبارہ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã QR này đã hết hạn hoặc đồng hồ trên hai thiết bị không khớp. Hãy yêu cầu người kia mở lại mã rồi quét lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码已过期，或两台设备的时间不一致。请让对方重新打开二维码后再扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 QR Code 已過期，或兩台裝置的時間不一致。請讓對方重新開啟 QR Code 後再掃描。"
          }
        }
      },
      "comment": "Shown when a verification QR is outside its freshness window or the devices' clocks differ"
    },
