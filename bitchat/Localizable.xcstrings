          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்புகள் geo relay மீது நம்புகிறது. இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
