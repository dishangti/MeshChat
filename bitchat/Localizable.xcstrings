        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le impostazioni per attivare o disattivare il gateway"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開いてゲートウェイのオン/オフを切り替えます"
