        "ms": { "stringUnit": { "state": "translated", "value": "Padam Sembang" } },
        "ne": { "stringUnit": { "state": "translated", "value": "च्याट मेटाउनुहोस्" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Chat verwijderen" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Usuń czat" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Eliminar conversa" } },
