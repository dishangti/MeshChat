          "stringUnit": {
            "state": "translated",
            "value": "compara estas huellas con %@ mediante un canal seguro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این اثرانگشت‌ها را از راهی امن با %@ مقایسه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "ikumpara ang mga fingerprint na ito kay %@ sa isang ligtas na channel."
