        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ க்கான வரைவைக் இந்த உள்ளடக்கத்தால் மாற்றவா? எதுவும் தானாக அனுப்பப்படாது."
          }
