    "verification.scan.status.identity_mismatch": {
      "comment": "Security error when a QR identity conflicts with the saved identity",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطابق رمز QR هوية الأمان المحفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "QR কোডটি সংরক্ষিত নিরাপত্তা পরিচয়ের সঙ্গে মেলে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code stimmt nicht mit der gespeicherten Sicherheitsidentität überein."
