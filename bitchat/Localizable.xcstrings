          "stringUnit": {
            "state": "translated",
            "value": "بلوتوث خاموش است. برای استفاده از MeshChat لطفاً بلوتوث را در تنظیمات روشن کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "naka-off ang bluetooth. pakibuksan sa settings para magamit ang MeshChat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth est désactivé. active le bluetooth dans réglages pour utiliser MeshChat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth כבוי. הפעל bluetooth בהגדרות כדי להשתמש ב-MeshChat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लूटूथ बंद है। MeshChat उपयोग करने के लिए सेटिंग्स में ब्लूटूथ चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth dimatikan. aktifkan bluetooth di pengaturan untuk memakai MeshChat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth è disattivato. attiva bluetooth nelle impostazioni per usare MeshChat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetoothがオフです。設定でbluetoothをオンにしてMeshChatを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth가 꺼져 있습니다. MeshChat을 사용하려면 설정에서 bluetooth를 켜주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth dimatikan. Hidupkan Bluetooth dalam Tetapan untuk menggunakan MeshChat."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth बन्द छ। MeshChat प्रयोग गर्न bluetooth सेटिङमा अन गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth staat uit. zet bluetooth aan in instellingen om MeshChat te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth jest wyłączony. włącz bluetooth w ustawieniach, aby używać MeshChat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth está desligado. Ativa o Bluetooth em Definições para usar o MeshChat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth está desligado. ative o bluetooth em ajustes para usar MeshChat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth выключен. включи bluetooth в настройках, чтобы использовать MeshChat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth är avstängt. slå på bluetooth i inställningar för att använda MeshChat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth அணைக்கப்பட்டுள்ளது. MeshChat பயன்படுத்த அமைப்பில் Bluetooth ஐ இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิด Bluetooth อยู่ กรุณาเปิดในตั้งค่าเพื่อใช้ MeshChat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kapalı. MeshChat'i kullanmak için ayarlardan Bluetooth'u açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth вимкнений. увімкни bluetooth у налаштуваннях, щоб користуватися MeshChat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth بند ہے۔ MeshChat استعمال کرنے کیلئے سیٹنگز میں Bluetooth آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth đang tắt. hãy bật trong cài đặt để dùng MeshChat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth 已关闭。请在设置中开启以使用 MeshChat。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "bluetooth 已關閉。請在設定中開啟以使用 MeshChat。"
          }
        }
      }
    },
    "content.alert.bluetooth_required.permission": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج MeshChat إلى إذن bluetooth للاتصال بالأجهزة القريبة. فعّل الوصول في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিকটবর্তী ডিভাইসের সাথে যুক্ত হতে MeshChat-এর ব্লুটুথ অনুমতি দরকার। দয়া করে সেটিংসে ব্লুটুথ অ্যাক্সেস সক্রিয় করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat benötigt bluetooth-berechtigung, um sich mit geräten in der nähe zu verbinden. erlaube den zugriff in den einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat needs Bluetooth permission to connect with nearby devices. Please enable Bluetooth access in settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat necesita permiso de Bluetooth para conectarse con dispositivos cercanos. Habilita el acceso en Ajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat برای اتصال به دستگاه‌های اطراف به مجوز بلوتوث نیاز دارد. لطفاً دسترسی بلوتوث را در تنظیمات فعال کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "kailangan ng MeshChat ng pahintulot sa bluetooth upang kumonekta sa mga kalapit na device. pakiactivate sa settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat a besoin de l'autorisation bluetooth pour se connecter aux appareils proches. active l'accès dans réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat צריכה הרשאת bluetooth כדי להתחבר למכשירים קרובים. אפשר גישה בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat को पास के उपकरणों से जुड़ने के लिए ब्लूटूथ अनुमति चाहिए। कृपया सेटिंग्स में ब्लूटूथ एक्सेस सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat memerlukan izin bluetooth untuk terhubung dengan perangkat dekat. aktifkan akses di pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat richiede l'autorizzazione bluetooth per collegarsi ai dispositivi vicini. abilita l'accesso nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChatは近くのデバイスと接続するためbluetooth権限が必要です。設定でアクセスを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat은 주변 기기와 연결하기 위해 bluetooth 권한이 필요합니다. 설정에서 bluetooth 접근을 활성화해주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat memerlukan kebenaran Bluetooth untuk disambungkan kepada peranti berhampiran. Benarkan capaian dalam Tetapan."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat लाई नजिकका उपकरणसँग जडान हुन bluetooth अनुमति चाहिन्छ। सेटिङमा पहुँच सक्षम गर।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat heeft bluetooth-toegang nodig om verbinding te maken met apparaten in de buurt. schakel dit in bij instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat potrzebuje uprawnień bluetooth, aby łączyć się z pobliskimi urządzeniami. włącz dostęp w ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MeshChat precisa de autorização de Bluetooth para se ligar a dispositivos próximos. Ativa o acesso em Definições."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat precisa de permissão de bluetooth para conectar com dispositivos próximos. habilite o acesso em ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat нужен доступ к bluetooth, чтобы соединяться с ближайшими устройствами. включи разрешение в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat behöver bluetooth-behörighet för att ansluta till enheter i närheten. aktivera åtkomst i inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அருகிலுள்ள சாதனங்களை இணைக்க MeshChat க்கு Bluetooth அனுமதி தேவை. அமைப்பில் அனுமதி வழங்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat ต้องการสิทธิ์ Bluetooth เพื่อเชื่อมต่อกับอุปกรณ์ใกล้เคียง กรุณาเปิดสิทธิ์ในตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat'in yakın cihazlara bağlanması için Bluetooth izni gerekir. lütfen ayarlardan Bluetooth erişimini etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat потребує дозволу bluetooth для з'єднання з пристроями поруч. ввімкни доступ у налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریب کے آلات سے جڑنے کیلئے MeshChat کو Bluetooth اجازت درکار ہے۔ سیٹنگز میں رسائی فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat cần quyền bluetooth để kết nối thiết bị gần. hãy bật quyền trong cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat 需要 bluetooth 权限以连接附近设备。请在设置中启用访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MeshChat 需要 bluetooth 權限以連線至附近裝置。請在設定中啟用存取權限。"
          }
        }
      }
    },
