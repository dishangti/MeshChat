            "state": "translated",
            "value": "نہیں بھیج سکتے: آپ لوکیشن چینل میں نہیں ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không gửi được: bạn không ở trong kênh vị trí"
          }
