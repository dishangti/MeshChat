    "verification.scan.status.timed_out": {
      "comment": "Error when friend verification does not complete before its deadline",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة التحقق. تأكد من أن صديقك قريب وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাচাইয়ের সময় শেষ হয়েছে। আপনার বন্ধু কাছাকাছি আছেন কিনা নিশ্চিত করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Verifizierung. Stelle sicher, dass dein Freund in der Nähe ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification timed out. Make sure your friend is nearby and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de verificación. Asegúrate de que tu amigo esté cerca e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مهلت تأیید تمام شد. مطمئن شوید دوستتان نزدیک است و دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-time out ang verification. Tiyaking malapit ang kaibigan mo at subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification a expiré. Vérifie que ton ami est à proximité et réessaie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תם הזמן לאימות. ודא שהחבר בקרבת מקום ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापन का समय समाप्त हो गया। सुनिश्चित करें कि आपका मित्र पास है और फिर प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu verifikasi habis. Pastikan teman Anda berada di dekat Anda lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica scaduta. Assicurati che il tuo amico sia nelle vicinanze e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認がタイムアウトしました。友だちが近くにいることを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 시간이 초과되었습니다. 친구가 근처에 있는지 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan tamat masa. Pastikan rakan anda berdekatan dan cuba lagi."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरणको समय सकियो। साथी नजिकै भएको सुनिश्चित गरी फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie verlopen. Zorg dat je vriend in de buurt is en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu weryfikacji. Upewnij się, że znajomy jest w pobliżu, i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação expirou. Certifica-te de que o teu amigo está por perto e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação expirou. Verifique se seu amigo está por perto e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время проверки истекло. Убедитесь, что друг рядом, и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieringen tog för lång tid. Se till att din vän är i närheten och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்ப்பு நேரம் முடிந்தது. நண்பர் அருகில் இருப்பதை உறுதிசெய்து மீண்டும் முயலவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดเวลาการยืนยัน ตรวจสอบว่าเพื่อนอยู่ใกล้แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama zaman aşımına uğradı. Arkadaşının yakında olduğundan emin olup tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час перевірки минув. Переконайтеся, що друг поруч, і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق کا وقت ختم ہو گیا۔ یقینی بنائیں کہ دوست قریب ہے اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá thời gian xác minh. Hãy đảm bảo bạn của bạn ở gần rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证超时。请确认好友在附近，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證逾時。請確認好友在附近，然後再試一次。"
          }
        }
      }
    },
