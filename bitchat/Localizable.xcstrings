    "content.header.carrying_mail": {
      "comment": "Tooltip for the courier indicator",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يحمل رسائل مختومة لتسليمها إلى الأصدقاء" } },
        "bn": { "stringUnit": { "state": "translated", "value": "বন্ধুদের কাছে পৌঁছে দেওয়ার জন্য সিল করা বার্তা বহন করা হচ্ছে" } },
        "de": { "stringUnit": { "state": "translated", "value": "Versiegelte Nachrichten werden für Freunde mitgenommen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Carrying sealed messages for friends to deliver" } },
        "es": { "stringUnit": { "state": "translated", "value": "Llevando mensajes sellados para entregarlos a amigos" } },
        "fa": { "stringUnit": { "state": "translated", "value": "در حال حمل پیام‌های مهروموم‌شده برای تحویل به دوستان" } },
        "fil": { "stringUnit": { "state": "translated", "value": "May dalang mga selyadong mensahe para ihatid sa mga kaibigan" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Transport de messages scellés à remettre à des amis" } },
        "he": { "stringUnit": { "state": "translated", "value": "נושא הודעות חתומות למסירה לחברים" } },
        "hi": { "stringUnit": { "state": "translated", "value": "मित्रों तक पहुँचाने के लिए सीलबंद संदेश ले जा रहा है" } },
        "id": { "stringUnit": { "state": "translated", "value": "Membawa pesan tersegel untuk disampaikan kepada teman" } },
        "it": { "stringUnit": { "state": "translated", "value": "Trasporto di messaggi sigillati da consegnare agli amici" } },
        "ja": { "stringUnit": { "state": "translated", "value": "友だちに届ける封印済みメッセージを運搬中" } },
        "ko": { "stringUnit": { "state": "translated", "value": "친구에게 전달할 봉인된 메시지 운반 중" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Membawa mesej dimeterai untuk dihantar kepada rakan" } },
        "ne": { "stringUnit": { "state": "translated", "value": "साथीहरूलाई पुर्‍याउन सिल गरिएका सन्देश बोकिँदै" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Verzegelde berichten meenemen om aan vrienden te bezorgen" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przenoszenie zapieczętowanych wiadomości do dostarczenia znajomym" } },
        "pt": { "stringUnit": { "state": "translated", "value": "A transportar mensagens seladas para entregar a amigos" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Transportando mensagens lacradas para entregar a amigos" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Перенос запечатанных сообщений для передачи друзьям" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Bär förseglade meddelanden som ska lämnas till vänner" } },
        "ta": { "stringUnit": { "state": "translated", "value": "நண்பர்களிடம் வழங்க முத்திரையிட்ட செய்திகளை எடுத்துச் செல்கிறது" } },
        "th": { "stringUnit": { "state": "translated", "value": "กำลังนำข้อความปิดผนึกไปส่งให้เพื่อน" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Arkadaşlara teslim edilecek mühürlü mesajlar taşınıyor" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Перенесення запечатаних повідомлень для передачі друзям" } },
        "ur": { "stringUnit": { "state": "translated", "value": "دوستوں تک پہنچانے کے لیے سربمہر پیغامات لے جا رہا ہے" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đang mang tin nhắn niêm phong để chuyển cho bạn bè" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在携带密封消息以转交好友" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在攜帶密封訊息以轉交好友" } }
