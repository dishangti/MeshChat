    "fingerprint.local_alias.hint": {
      "comment": "Explains that a local nickname is private to this device",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ على هذا الجهاز فقط. لن يراه هذا الشخص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই ডিভাইসে সংরক্ষিত। এই ব্যক্তি এটি দেখতে পাবেন না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur auf diesem Gerät gespeichert. Diese Person sieht ihn nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved only on this device. This person will not see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en este dispositivo. Esta persona no lo verá."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط روی این دستگاه ذخیره می‌شود. این شخص آن را نمی‌بیند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito lang sine-save. Hindi ito makikita ng taong ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré uniquement sur cet appareil. Cette personne ne le verra pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר רק במכשיר הזה. האדם הזה לא יראה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस डिवाइस पर सहेजा जाता है। इस व्यक्ति को यह नहीं दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya disimpan di perangkat ini. Orang ini tidak akan melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato solo su questo dispositivo. Questa persona non lo vedrà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にのみ保存され、相手には表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만 저장되며 상대방에게는 보이지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan pada peranti ini sahaja. Orang ini tidak akan melihatnya."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो यन्त्रमा मात्र सुरक्षित हुन्छ। यो व्यक्तिले देख्ने छैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op dit apparaat opgeslagen. Deze persoon ziet dit niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywany tylko na tym urządzeniu. Ta osoba go nie zobaczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado apenas neste dispositivo. Esta pessoa não o verá."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo apenas neste dispositivo. Esta pessoa não verá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется только на этом устройстве. Этот человек его не увидит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas bara på den här enheten. Personen ser det inte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் மட்டுமே சேமிக்கப்படும். இந்த நபருக்கு இது தெரியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้เฉพาะบนอุปกรณ์นี้ บุคคลนี้จะไม่เห็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda kaydedilir. Bu kişi bunu görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається лише на цьому пристрої. Ця людина цього не побачить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف اس ڈیوائس پر محفوظ ہوتا ہے۔ یہ شخص اسے نہیں دیکھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trên thiết bị này. Người này sẽ không thấy."
          }
