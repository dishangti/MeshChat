    "verification.scan.status.blocked": {
      "comment": "Error when a scanned person is blocked locally",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ حظر هذا الشخص قبل إضافته كصديق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধু হিসেবে যোগ করার আগে এই ব্যক্তিকে আনব্লক করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre diese Person, bevor du sie als Freund hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock this person before adding them as a friend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea a esta persona antes de añadirla como amiga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از افزودن این شخص به‌عنوان دوست، مسدودسازی را بردارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-unblock muna ang taong ito bago idagdag bilang kaibigan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque cette personne avant de l’ajouter comme ami."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבטל את חסימת האדם לפני הוספתו כחבר."
