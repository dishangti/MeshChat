          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka blokir orang ini sebelum menambahkannya sebagai teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca questa persona prima di aggiungerla come amico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちに追加する前にブロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구로 추가하기 전에 차단을 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyahsekat orang ini sebelum menambahnya sebagai rakan."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "साथीको रूपमा थप्नुअघि यस व्यक्तिलाई अनब्लक गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblokkeer deze persoon voordat je die als vriend toevoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj tę osobę przed dodaniem jej do znajomych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia esta pessoa antes de a adicionares como amiga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie esta pessoa antes de adicioná-la como amiga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте пользователя перед добавлением в друзья."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avblockera personen innan du lägger till hen som vän."
          }
