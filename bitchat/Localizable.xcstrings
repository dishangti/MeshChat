        "ja": { "stringUnit": { "state": "translated", "value": "%@とのチャットを削除しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@ 님과의 채팅을 삭제할까요?" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Padam sembang dengan %@?" } },
        "ne": { "stringUnit": { "state": "translated", "value": "%@ सँगको च्याट मेटाउने?" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Chat met %@ verwijderen?" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Usunąć czat z użytkownikiem %@?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Eliminar a conversa com %@?" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Excluir a conversa com %@?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить чат с %@?" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Radera chatten med %@?" } },
        "ta": { "stringUnit": { "state": "translated", "value": "%@ உடனான அரட்டையை நீக்கவா?" } },
