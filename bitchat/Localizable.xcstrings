    "app_info.settings.danger.erase_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يحذف الدردشات والوسائط وجهات الاتصال والأسماء المستعارة وسجلات التحقق والحظر والمجموعات وسجل المواقع والرسائل المنتظرة وإعدادات الإشعارات والمرحلات. تبقى مفاتيح هويتك واسمك المستعار، لذلك لا تتغير بصمتك. لا يمكن التراجع عن ذلك. يؤدي النقر ثلاث مرات على شعار MeshChat أيضًا إلى إعادة تعيين الهوية." } },
        "bn": { "stringUnit": { "state": "translated", "value": "চ্যাট, মিডিয়া, পরিচিতি, ডাকনাম, যাচাই ও ব্লক রেকর্ড, গ্রুপ, অবস্থানের ইতিহাস, সারিবদ্ধ বার্তা এবং নোটিফিকেশন ও রিলে সেটিংস মুছে দেয়। আপনার পরিচয় কী ও ডাকনাম থাকে, তাই ফিঙ্গারপ্রিন্ট বদলায় না। এটি পূর্বাবস্থায় ফেরানো যাবে না। MeshChat লোগোতে তিনবার ট্যাপ করলে পরিচয়ও রিসেট হয়।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Löscht Chats, Medien, Kontakte, Spitznamen, Verifizierungs- und Sperreinträge, Gruppen, Standortverlauf, wartende Nachrichten sowie Benachrichtigungs- und Relay-Einstellungen. Identitätsschlüssel und Spitzname bleiben erhalten, daher ändert sich dein Fingerabdruck nicht. Dies kann nicht rückgängig gemacht werden. Dreimaliges Tippen auf das MeshChat-Logo setzt zusätzlich die Identität zurück." } },
        "en": { "stringUnit": { "state": "translated", "value": "Deletes chats, media, contacts, nicknames, verification and block records, groups, location history, queued messages, and notification and relay settings. Your identity keys and nickname stay, so your fingerprint does not change. This cannot be undone. Triple-tapping the MeshChat logo also resets identity." } },
        "es": { "stringUnit": { "state": "translated", "value": "Elimina chats, archivos multimedia, contactos, apodos, registros de verificación y bloqueo, grupos, historial de ubicación, mensajes en cola y ajustes de notificaciones y relés. Tus claves de identidad y apodo se conservan, por lo que tu huella no cambia. No se puede deshacer. Tocar tres veces el logotipo de MeshChat también restablece la identidad." } },
        "fa": { "stringUnit": { "state": "translated", "value": "گفتگوها، رسانه‌ها، مخاطبان، نام‌های مستعار، سوابق تأیید و مسدودسازی، گروه‌ها، تاریخچهٔ مکان، پیام‌های در صف و تنظیمات اعلان و رله را حذف می‌کند. کلیدهای هویت و نام مستعار شما باقی می‌مانند، بنابراین اثر انگشت تغییر نمی‌کند. این کار قابل بازگشت نیست. سه بار ضربه‌زدن روی نشان MeshChat هویت را نیز بازنشانی می‌کند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Binubura ang mga chat, media, contact, palayaw, verification at block record, grupo, location history, naka-queue na mensahe, at notification at relay settings. Mananatili ang identity keys at palayaw mo kaya hindi magbabago ang fingerprint. Hindi ito maa-undo. Ang pag-triple tap sa logo ng MeshChat ay nagre-reset din ng identity." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprime les discussions, médias, contacts, surnoms, vérifications, blocages, groupes, historique de localisation, messages en attente et réglages de notification et de relais. Vos clés d’identité et votre surnom restent inchangés, donc votre empreinte ne change pas. Cette action est irréversible. Toucher trois fois le logo MeshChat réinitialise aussi l’identité." } },
        "he": { "stringUnit": { "state": "translated", "value": "מוחק שיחות, מדיה, אנשי קשר, כינויים, רשומות אימות וחסימה, קבוצות, היסטוריית מיקום, הודעות בתור והגדרות התראות וממסרים. מפתחות הזהות והכינוי נשמרים ולכן טביעת האצבע אינה משתנה. אי אפשר לבטל פעולה זו. הקשה משולשת על הלוגו של MeshChat מאפסת גם את הזהות." } },
        "hi": { "stringUnit": { "state": "translated", "value": "चैट, मीडिया, संपर्क, उपनाम, सत्यापन और ब्लॉक रिकॉर्ड, समूह, स्थान इतिहास, कतारबद्ध संदेश तथा सूचना और रिले सेटिंग मिटाता है। आपकी पहचान कुंजियाँ और उपनाम बने रहते हैं, इसलिए फ़िंगरप्रिंट नहीं बदलता। इसे वापस नहीं किया जा सकता। MeshChat लोगो पर तीन बार टैप करने से पहचान भी रीसेट होती है।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Menghapus chat, media, kontak, nama panggilan, catatan verifikasi dan blokir, grup, riwayat lokasi, pesan antrean, serta pengaturan notifikasi dan relay. Kunci identitas dan nama panggilan Anda tetap ada, sehingga sidik jari tidak berubah. Tindakan ini tidak dapat dibatalkan. Mengetuk logo MeshChat tiga kali juga mengatur ulang identitas." } },
        "it": { "stringUnit": { "state": "translated", "value": "Elimina chat, contenuti multimediali, contatti, soprannomi, verifiche, blocchi, gruppi, cronologia delle posizioni, messaggi in coda e impostazioni di notifiche e relay. Le chiavi d’identità e il soprannome restano, quindi l’impronta non cambia. L’operazione è irreversibile. Toccando tre volte il logo MeshChat viene reimpostata anche l’identità." } },
        "ja": { "stringUnit": { "state": "translated", "value": "チャット、メディア、連絡先、ニックネーム、検証・ブロック記録、グループ、位置履歴、送信待ちメッセージ、通知とリレーの設定を削除します。ID鍵とニックネームは保持されるため、フィンガープリントは変わりません。この操作は元に戻せません。MeshChatロゴを3回タップするとIDもリセットされます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "채팅, 미디어, 연락처, 별명, 인증 및 차단 기록, 그룹, 위치 기록, 대기 중인 메시지, 알림 및 릴레이 설정을 삭제합니다. 신원 키와 별명은 유지되므로 지문은 바뀌지 않습니다. 되돌릴 수 없습니다. MeshChat 로고를 세 번 탭하면 신원도 재설정됩니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Memadam sembang, media, kenalan, nama panggilan, rekod pengesahan dan sekatan, kumpulan, sejarah lokasi, mesej beratur serta tetapan pemberitahuan dan geganti. Kunci identiti dan nama panggilan anda dikekalkan, jadi cap jari tidak berubah. Tindakan ini tidak boleh dibuat asal. Mengetik logo MeshChat tiga kali turut menetapkan semula identiti." } },
        "ne": { "stringUnit": { "state": "translated", "value": "च्याट, मिडिया, सम्पर्क, उपनाम, प्रमाणीकरण र रोक सूची, समूह, स्थान इतिहास, लाइनमा रहेका सन्देश तथा सूचना र रिले सेटिङ मेटाउँछ। तपाईंका पहिचान कुञ्जी र उपनाम रहन्छन्, त्यसैले फिङ्गरप्रिन्ट बदलिँदैन। यसलाई उल्ट्याउन सकिँदैन। MeshChat लोगोमा तीन पटक ट्याप गर्दा पहिचान पनि रिसेट हुन्छ।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Verwijdert chats, media, contacten, bijnamen, verificatie- en blokkeerrecords, groepen, locatiegeschiedenis, berichten in de wachtrij en instellingen voor meldingen en relays. Je identiteitssleutels en bijnaam blijven behouden, dus je vingerafdruk verandert niet. Dit kan niet ongedaan worden gemaakt. Drie keer tikken op het MeshChat-logo reset ook de identiteit." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Usuwa czaty, multimedia, kontakty, pseudonimy, wpisy weryfikacji i blokad, grupy, historię lokalizacji, wiadomości w kolejce oraz ustawienia powiadomień i przekaźników. Klucze tożsamości i pseudonim pozostają, więc odcisk się nie zmienia. Tej operacji nie można cofnąć. Trzykrotne stuknięcie logo MeshChat resetuje także tożsamość." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Apaga conversas, multimédia, contactos, alcunhas, registos de verificação e bloqueio, grupos, histórico de localização, mensagens em fila e definições de notificações e relés. As chaves de identidade e a alcunha são mantidas, por isso a impressão digital não muda. Esta ação é irreversível. Tocar três vezes no logótipo MeshChat também repõe a identidade." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Apaga conversas, mídia, contatos, apelidos, registros de verificação e bloqueio, grupos, histórico de localização, mensagens na fila e configurações de notificações e relays. Suas chaves de identidade e seu apelido são mantidos, então a impressão digital não muda. Não é possível desfazer. Tocar três vezes no logo do MeshChat também redefine a identidade." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удаляет чаты, медиа, контакты, псевдонимы, записи проверки и блокировки, группы, историю местоположений, сообщения в очереди и настройки уведомлений и реле. Ключи личности и псевдоним сохраняются, поэтому отпечаток не меняется. Это действие нельзя отменить. Тройное нажатие на логотип MeshChat также сбрасывает личность." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Raderar chattar, media, kontakter, smeknamn, verifierings- och blockeringsposter, grupper, platshistorik, köade meddelanden samt aviserings- och reläinställningar. Identitetsnycklar och smeknamn behålls, så fingeravtrycket ändras inte. Detta går inte att ångra. Tre tryck på MeshChat-logotypen återställer även identiteten." } },
        "ta": { "stringUnit": { "state": "translated", "value": "அரட்டைகள், ஊடகம், தொடர்புகள், புனைப்பெயர்கள், சரிபார்ப்பு மற்றும் தடுப்பு பதிவுகள், குழுக்கள், இருப்பிட வரலாறு, வரிசைச் செய்திகள், அறிவிப்பு மற்றும் ரிலே அமைப்புகளை அழிக்கிறது. அடையாளச் சாவிகளும் புனைப்பெயரும் நீடிப்பதால் கைரேகை மாறாது. இதை மீளப் பெற முடியாது. MeshChat சின்னத்தை மூன்று முறைத் தட்டினால் அடையாளமும் மீட்டமைக்கப்படும்." } },
        "th": { "stringUnit": { "state": "translated", "value": "ลบแชต สื่อ รายชื่อ ชื่อเล่น บันทึกการยืนยันและการบล็อก กลุ่ม ประวัติตำแหน่ง ข้อความที่รอส่ง และการตั้งค่าการแจ้งเตือนกับรีเลย์ คีย์ตัวตนและชื่อเล่นจะยังอยู่ ลายนิ้วมือจึงไม่เปลี่ยน ย้อนกลับไม่ได้ การแตะโลโก้ MeshChat สามครั้งจะรีเซ็ตตัวตนด้วย" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sohbetleri, medyayı, kişileri, takma adları, doğrulama ve engelleme kayıtlarını, grupları, konum geçmişini, sıradaki mesajları ve bildirim ile röle ayarlarını siler. Kimlik anahtarlarınız ve takma adınız kalır, bu yüzden parmak iziniz değişmez. Bu işlem geri alınamaz. MeshChat logosuna üç kez dokunmak kimliği de sıfırlar." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Видаляє чати, медіа, контакти, псевдоніми, записи перевірки й блокування, групи, історію місцезнаходжень, повідомлення в черзі та налаштування сповіщень і ретрансляторів. Ключі ідентичності та псевдонім зберігаються, тому відбиток не змінюється. Цю дію неможливо скасувати. Потрійний дотик до логотипа MeshChat також скидає ідентичність." } },
        "ur": { "stringUnit": { "state": "translated", "value": "چیٹس، میڈیا، رابطے، عرفی نام، تصدیق اور بلاک ریکارڈ، گروپس، مقام کی تاریخ، قطار میں موجود پیغامات اور نوٹیفکیشن و ریلے ترتیبات مٹاتا ہے۔ آپ کی شناختی کلیدیں اور عرفی نام برقرار رہتے ہیں، اس لیے فنگرپرنٹ نہیں بدلتا۔ اسے واپس نہیں کیا جا سکتا۔ MeshChat لوگو پر تین بار ٹیپ کرنے سے شناخت بھی ری سیٹ ہوتی ہے۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Xóa cuộc trò chuyện, nội dung đa phương tiện, liên hệ, biệt danh, bản ghi xác minh và chặn, nhóm, lịch sử vị trí, tin nhắn đang chờ cùng cài đặt thông báo và relay. Khóa danh tính và biệt danh vẫn được giữ nên dấu vân tay không đổi. Không thể hoàn tác. Chạm ba lần vào logo MeshChat cũng đặt lại danh tính." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除聊天、媒体、联系人、昵称、验证与拉黑记录、群组、位置历史、待发送消息，以及通知和中继设置。身份密钥和本人的昵称会保留，因此指纹不会改变。此操作无法撤销。三击 MeshChat 标志还会重置身份。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "刪除聊天、媒體、聯絡人、暱稱、驗證與封鎖記錄、群組、位置記錄、待傳送訊息，以及通知和中繼設定。身分金鑰和本人的暱稱會保留，因此指紋不會改變。此操作無法復原。三擊 MeshChat 標誌還會重設身分。" } }
      }
    },
    "app_info.settings.danger.identity_reset_button": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إعادة تعيين الهوية" } },
        "bn": { "stringUnit": { "state": "translated", "value": "পরিচয় রিসেট করুন" } },
        "de": { "stringUnit": { "state": "translated", "value": "Identität zurücksetzen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Reset Identity" } },
        "es": { "stringUnit": { "state": "translated", "value": "Restablecer identidad" } },
        "fa": { "stringUnit": { "state": "translated", "value": "بازنشانی هویت" } },
        "fil": { "stringUnit": { "state": "translated", "value": "I-reset ang Identity" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Réinitialiser l’identité" } },
