{
  "sourceLanguage": "en",
  "strings": {
    "meshchat.help.title": {
      "comment": "Title of the standalone MeshChat help page and its segmented-control tab",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "مساعدة" } },
        "bn": { "stringUnit": { "state": "translated", "value": "সহায়তা" } },
        "de": { "stringUnit": { "state": "translated", "value": "Hilfe" } },
        "en": { "stringUnit": { "state": "translated", "value": "Help" } },
        "es": { "stringUnit": { "state": "translated", "value": "Ayuda" } },
        "fa": { "stringUnit": { "state": "translated", "value": "راهنما" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Tulong" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aide" } },
        "he": { "stringUnit": { "state": "translated", "value": "עזרה" } },
        "hi": { "stringUnit": { "state": "translated", "value": "सहायता" } },
        "id": { "stringUnit": { "state": "translated", "value": "Bantuan" } },
        "it": { "stringUnit": { "state": "translated", "value": "Aiuto" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ヘルプ" } },
        "ko": { "stringUnit": { "state": "translated", "value": "도움말" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Bantuan" } },
        "ne": { "stringUnit": { "state": "translated", "value": "मद्दत" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Help" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Pomoc" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Ajuda" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Ajuda" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Справка" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Hjälp" } },
        "ta": { "stringUnit": { "state": "translated", "value": "உதவி" } },
        "th": { "stringUnit": { "state": "translated", "value": "วิธีใช้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Yardım" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Довідка" } },
        "ur": { "stringUnit": { "state": "translated", "value": "مدد" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trợ giúp" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "帮助" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "幫助" } }
      }
    },
    "meshchat.help.open_hint": {
      "comment": "Accessibility hint on the MeshChat brand control that opens the standalone Help page",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يفتح المساعدة والمعلومات والإعدادات" } },
        "bn": { "stringUnit": { "state": "translated", "value": "সহায়তা, তথ্য ও সেটিংস খোলে" } },
        "de": { "stringUnit": { "state": "translated", "value": "Öffnet Hilfe, Info und Einstellungen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Opens Help, Info, and Settings" } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre Ayuda, Información y Ajustes" } },
        "fa": { "stringUnit": { "state": "translated", "value": "راهنما، اطلاعات و تنظیمات را باز می‌کند" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Binubuksan ang Tulong, Impormasyon, at Settings" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvre Aide, Infos et Réglages" } },
        "he": { "stringUnit": { "state": "translated", "value": "פותח עזרה, מידע והגדרות" } },
        "hi": { "stringUnit": { "state": "translated", "value": "सहायता, जानकारी और सेटिंग्स खोलता है" } },
        "id": { "stringUnit": { "state": "translated", "value": "Membuka Bantuan, Info, dan Pengaturan" } },
        "it": { "stringUnit": { "state": "translated", "value": "Apre Aiuto, Info e Impostazioni" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ヘルプ、情報、設定を開きます" } },
        "ko": { "stringUnit": { "state": "translated", "value": "도움말, 정보 및 설정 열기" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Membuka Bantuan, Info dan Tetapan" } },
        "ne": { "stringUnit": { "state": "translated", "value": "मद्दत, जानकारी र सेटिङ खोल्छ" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Opent Help, Info en Instellingen" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Otwiera Pomoc, Informacje i Ustawienia" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Abre Ajuda, Informações e Definições" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Abre Ajuda, Informações e Ajustes" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Открывает Справку, Информацию и Настройки" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Öppnar Hjälp, Info och Inställningar" } },
        "ta": { "stringUnit": { "state": "translated", "value": "உதவி, தகவல் மற்றும் அமைப்புகளைத் திறக்கும்" } },
        "th": { "stringUnit": { "state": "translated", "value": "เปิดวิธีใช้ ข้อมูล และตั้งค่า" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Yardım, Bilgi ve Ayarlar'ı açar" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Відкриває Довідку, Інформацію та Налаштування" } },
        "ur": { "stringUnit": { "state": "translated", "value": "مدد، معلومات اور سیٹنگز کھولتا ہے" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mở Trợ giúp, Thông tin và Cài đặt" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开帮助、信息和设置页面" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟幫助、資訊和設定頁面" } }
      }
    },
    "content.clear.confirm_message": {
      "comment": "Explanation shown before deleting the current chat history from this device",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يؤدي هذا إلى حذف سجل هذه الدردشة من هذا الجهاز فقط. تظل إعدادات الهوية محفوظة." } },
        "bn": { "stringUnit": { "state": "translated", "value": "এটি শুধু এই ডিভাইস থেকে এই চ্যাটের ইতিহাস মুছে দেবে। পরিচয় সেটিংস সংরক্ষিত থাকবে।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Dadurch wird der Verlauf dieses Chats nur von diesem Gerät gelöscht. Identitätseinstellungen bleiben erhalten." } },
        "en": { "stringUnit": { "state": "translated", "value": "This deletes this chat's history from this device only. Identity settings are preserved." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esto elimina el historial de este chat solo de este dispositivo. Se conservarán los ajustes de identidad." } },
        "fa": { "stringUnit": { "state": "translated", "value": "با این کار، تاریخچه این گفت‌وگو فقط از این دستگاه حذف می‌شود. تنظیمات هویت حفظ می‌شوند." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Buburahin lamang nito ang history ng chat na ito sa device na ito. Mananatili ang mga setting ng identity." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cela supprime l’historique de cette discussion de cet appareil uniquement. Les réglages d’identité sont conservés." } },
        "he": { "stringUnit": { "state": "translated", "value": "פעולה זו מוחקת את היסטוריית הצ׳אט מהמכשיר הזה בלבד. הגדרות הזהות נשמרות." } },
        "hi": { "stringUnit": { "state": "translated", "value": "इससे इस चैट का इतिहास केवल इस डिवाइस से मिटेगा। पहचान सेटिंग सुरक्षित रहेंगी।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Ini hanya menghapus riwayat chat ini dari perangkat ini. Pengaturan identitas tetap disimpan." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa operazione elimina la cronologia della chat solo da questo dispositivo. Le impostazioni dell’identità vengono conservate." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このチャットの履歴をこのデバイスからのみ削除します。ID設定は保持されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 채팅 기록을 이 기기에서만 삭제합니다. 신원 설정은 유지됩니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Ini hanya memadamkan sejarah sembang ini daripada peranti ini. Tetapan identiti dikekalkan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "यसले यो च्याटको इतिहास यस यन्त्रबाट मात्र मेटाउँछ। पहिचान सेटिङहरू सुरक्षित रहन्छन्।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Hiermee wordt de geschiedenis van deze chat alleen van dit apparaat verwijderd. Identiteitsinstellingen blijven behouden." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Spowoduje to usunięcie historii tego czatu tylko z tego urządzenia. Ustawienia tożsamości zostaną zachowane." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Isto elimina o histórico desta conversa apenas deste dispositivo. As definições de identidade são preservadas." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Isso exclui o histórico desta conversa apenas deste dispositivo. As configurações de identidade são preservadas." } },
        "ru": { "stringUnit": { "state": "translated", "value": "История этого чата будет удалена только с этого устройства. Настройки личности сохранятся." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Detta raderar historiken för chatten endast från den här enheten. Identitetsinställningarna bevaras." } },
        "ta": { "stringUnit": { "state": "translated", "value": "இது இந்த அரட்டையின் வரலாற்றை இந்தச் சாதனத்திலிருந்து மட்டும் நீக்கும். அடையாள அமைப்புகள் பாதுகாக்கப்படும்." } },
        "th": { "stringUnit": { "state": "translated", "value": "การดำเนินการนี้จะลบประวัติแชทนี้ออกจากอุปกรณ์นี้เท่านั้น โดยยังคงการตั้งค่าข้อมูลประจำตัวไว้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu işlem, bu sohbetin geçmişini yalnızca bu cihazdan siler. Kimlik ayarları korunur." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Історію цього чату буде видалено лише з цього пристрою. Налаштування особи збережуться." } },
        "ur": { "stringUnit": { "state": "translated", "value": "اس سے اس چیٹ کی سرگزشت صرف اس ڈیوائس سے حذف ہوگی۔ شناخت کی ترتیبات محفوظ رہیں گی۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thao tác này chỉ xóa lịch sử cuộc trò chuyện khỏi thiết bị này. Các cài đặt danh tính vẫn được giữ lại." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这只会删除此设备上的聊天记录。身份设置会保留。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這只會刪除此裝置上的聊天記錄。身分設定會保留。" } }
      }
    },
    "friends.activity.added_you": {
      "comment": "Notification and local event text when a named person adds the local user as a friend; %@ is the person's display name",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "أضافك %@ كصديق." } },
        "bn": { "stringUnit": { "state": "translated", "value": "%@ আপনাকে বন্ধু হিসেবে যোগ করেছেন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ hat dich als Freund hinzugefügt." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ added you as a friend." } },
        "es": { "stringUnit": { "state": "translated", "value": "%@ te añadió como amigo." } },
        "fa": { "stringUnit": { "state": "translated", "value": "%@ شما را به‌عنوان دوست اضافه کرد." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Idinagdag ka ni %@ bilang kaibigan." } },
        "fr": { "stringUnit": { "state": "translated", "value": "%@ vous a ajouté comme ami." } },
        "he": { "stringUnit": { "state": "translated", "value": "%@ הוסיף אותך כחבר." } },
        "hi": { "stringUnit": { "state": "translated", "value": "%@ ने आपको मित्र के रूप में जोड़ा।" } },
        "id": { "stringUnit": { "state": "translated", "value": "%@ menambahkan Anda sebagai teman." } },
        "it": { "stringUnit": { "state": "translated", "value": "%@ ti ha aggiunto come amico." } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@があなたを友だちに追加しました。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@ 님이 회원님을 친구로 추가했습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "%@ menambah anda sebagai rakan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "%@ ले तपाईंलाई साथीको रूपमा थप्नुभयो।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "%@ heeft je als vriend toegevoegd." } },
        "pl": { "stringUnit": { "state": "translated", "value": "%@ dodał(a) Cię do znajomych." } },
        "pt": { "stringUnit": { "state": "translated", "value": "%@ adicionou-te como amigo." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "%@ adicionou você como amigo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "%@ добавил(а) вас в друзья." } },
        "sv": { "stringUnit": { "state": "translated", "value": "%@ lade till dig som vän." } },
        "ta": { "stringUnit": { "state": "translated", "value": "%@ உங்களை நண்பராகச் சேர்த்துள்ளார்." } },
        "th": { "stringUnit": { "state": "translated", "value": "%@ เพิ่มคุณเป็นเพื่อนแล้ว" } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ sizi arkadaş olarak ekledi." } },
        "uk": { "stringUnit": { "state": "translated", "value": "%@ додав(-ла) вас у друзі." } },
        "ur": { "stringUnit": { "state": "translated", "value": "%@ نے آپ کو دوست کے طور پر شامل کیا۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "%@ đã thêm bạn làm bạn bè." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 已添加你为好友。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "%@ 已將你加為好友。" } }
      }
    },
    "friends.activity.removed_you": {
      "comment": "Local event text when a named person removes the local user as a friend; %@ is the person's display name",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "أزالك %@ من الأصدقاء." } },
        "bn": { "stringUnit": { "state": "translated", "value": "%@ আপনাকে বন্ধুদের তালিকা থেকে সরিয়েছেন।" } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ hat dich aus den Freunden entfernt." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ removed you as a friend." } },
        "es": { "stringUnit": { "state": "translated", "value": "%@ te eliminó de sus amigos." } },
        "fa": { "stringUnit": { "state": "translated", "value": "%@ شما را از دوستان حذف کرد." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Inalis ka ni %@ bilang kaibigan." } },
        "fr": { "stringUnit": { "state": "translated", "value": "%@ vous a retiré de ses amis." } },
        "he": { "stringUnit": { "state": "translated", "value": "%@ הסיר אותך מהחברים." } },
        "hi": { "stringUnit": { "state": "translated", "value": "%@ ने आपको मित्रों से हटा दिया।" } },
        "id": { "stringUnit": { "state": "translated", "value": "%@ menghapus Anda dari teman." } },
        "it": { "stringUnit": { "state": "translated", "value": "%@ ti ha rimosso dagli amici." } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@があなたを友だちから削除しました。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@ 님이 회원님을 친구에서 삭제했습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "%@ mengalih keluar anda daripada rakan." } },
        "ne": { "stringUnit": { "state": "translated", "value": "%@ ले तपाईंलाई साथीहरूबाट हटाउनुभयो।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "%@ heeft je als vriend verwijderd." } },
        "pl": { "stringUnit": { "state": "translated", "value": "%@ usunął(-ęła) Cię ze znajomych." } },
        "pt": { "stringUnit": { "state": "translated", "value": "%@ removeu-te dos amigos." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "%@ removeu você dos amigos." } },
        "ru": { "stringUnit": { "state": "translated", "value": "%@ удалил(а) вас из друзей." } },
        "sv": { "stringUnit": { "state": "translated", "value": "%@ tog bort dig som vän." } },
        "ta": { "stringUnit": { "state": "translated", "value": "%@ உங்களை நண்பர்களிலிருந்து நீக்கியுள்ளார்." } },
        "th": { "stringUnit": { "state": "translated", "value": "%@ ลบคุณออกจากเพื่อนแล้ว" } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ sizi arkadaşlarından çıkardı." } },
        "uk": { "stringUnit": { "state": "translated", "value": "%@ видалив(-ла) вас із друзів." } },
        "ur": { "stringUnit": { "state": "translated", "value": "%@ نے آپ کو دوستوں سے ہٹا دیا۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "%@ đã xóa bạn khỏi danh sách bạn bè." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 已将你从好友中删除。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "%@ 已將你從好友中移除。" } }
      }
    },
    "friends.remove.confirm_title": {
      "comment": "Confirmation title before removing the named person from Friends; exactly one target-name placeholder",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "إزالة %@ من الأصدقاء؟" } },
        "bn": { "stringUnit": { "state": "translated", "value": "বন্ধুদের তালিকা থেকে %@-কে সরাবেন?" } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ aus den Freunden entfernen?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Remove %@ from Friends?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Eliminar a %@ de tus amigos?" } },
        "fa": { "stringUnit": { "state": "translated", "value": "%@ از دوستان حذف شود؟" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Alisin si %@ sa Friends?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Retirer %@ des amis ?" } },
        "he": { "stringUnit": { "state": "translated", "value": "להסיר את %@ מהחברים?" } },
        "hi": { "stringUnit": { "state": "translated", "value": "%@ को दोस्तों से हटाएँ?" } },
        "id": { "stringUnit": { "state": "translated", "value": "Hapus %@ dari Teman?" } },
        "it": { "stringUnit": { "state": "translated", "value": "Rimuovere %@ dagli amici?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@を友達から削除しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@ 님을 친구에서 삭제할까요?" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Alih keluar %@ daripada Rakan?" } },
        "ne": { "stringUnit": { "state": "translated", "value": "%@ लाई साथीहरूबाट हटाउने?" } },
        "nl": { "stringUnit": { "state": "translated", "value": "%@ uit Vrienden verwijderen?" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Usunąć użytkownika %@ ze znajomych?" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Remover %@ dos amigos?" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Remover %@ dos amigos?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить %@ из друзей?" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Ta bort %@ från vänner?" } },
        "ta": { "stringUnit": { "state": "translated", "value": "%@-ஐ நண்பர்களிலிருந்து நீக்கவா?" } },
        "th": { "stringUnit": { "state": "translated", "value": "นำ %@ ออกจากเพื่อนหรือไม่?" } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ arkadaşlardan kaldırılsın mı?" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Видалити %@ із друзів?" } },
        "ur": { "stringUnit": { "state": "translated", "value": "%@ کو دوستوں سے ہٹائیں؟" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Xóa %@ khỏi Bạn bè?" } },
