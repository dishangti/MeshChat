          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "оценено по gossip-спискам соседей (до 10 на пира) — твоё устройство выделено"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "uppskattat från skvallrade grannlistor (upp till 10 per peer) — din enhet är markerad"
