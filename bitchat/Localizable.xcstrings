        "uk": { "stringUnit": { "state": "translated", "value": "Скинути ідентичність" } },
        "ur": { "stringUnit": { "state": "translated", "value": "شناخت ری سیٹ کریں" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đặt lại danh tính" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "重置身份" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "重設身分" } }
      }
    },
    "app_info.settings.danger.identity_reset_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "ينشئ مفاتيح Mesh والتوقيع وNostr جديدة. تبقى الدردشات والوسائط وجهات الاتصال والأسماء المستعارة والحظر والإعدادات. تُحذف المجموعات الخاصة والرسائل المنتظرة لأنها تستخدم المفاتيح القديمة. ستراك الأجهزة الأخرى كهوية غير موثقة. لا يمكن التراجع عن ذلك." } },
        "bn": { "stringUnit": { "state": "translated", "value": "নতুন Mesh, স্বাক্ষর এবং Nostr কী তৈরি করে। চ্যাট, মিডিয়া, পরিচিতি, ডাকনাম, ব্লক এবং সেটিংস থাকে। পুরোনো কী ব্যবহার করায় ব্যক্তিগত গ্রুপ ও সারিবদ্ধ বার্তা মুছে যায়। অন্য ডিভাইস আপনাকে যাচাই না-করা হিসেবে দেখবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erstellt neue Mesh-, Signatur- und Nostr-Schlüssel. Chats, Medien, Kontakte, Spitznamen, Sperren und Einstellungen bleiben erhalten. Private Gruppen und wartende Nachrichten werden entfernt, da sie die alten Schlüssel verwenden. Andere Geräte sehen dich als nicht verifiziert. Dies kann nicht rückgängig gemacht werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "Creates new Mesh, signing, and Nostr keys. Chats, media, contacts, nicknames, blocks, and settings stay. Private groups and queued messages are removed because they use the old keys. Other devices will see you as unverified. This cannot be undone." } },
        "es": { "stringUnit": { "state": "translated", "value": "Crea nuevas claves de Mesh, firma y Nostr. Se conservan los chats, archivos multimedia, contactos, apodos, bloqueos y ajustes. Los grupos privados y mensajes en cola se eliminan porque usan las claves anteriores. Los demás dispositivos te verán como no verificado. No se puede deshacer." } },
        "fa": { "stringUnit": { "state": "translated", "value": "کلیدهای Mesh، امضا و Nostr جدید می‌سازد. گفتگوها، رسانه‌ها، مخاطبان، نام‌های مستعار، مسدودسازی‌ها و تنظیمات باقی می‌مانند. گروه‌های خصوصی و پیام‌های در صف چون از کلیدهای قدیمی استفاده می‌کنند حذف می‌شوند. دستگاه‌های دیگر شما را تأییدنشده می‌بینند. این کار قابل بازگشت نیست." } },
        "fil": { "stringUnit": { "state": "translated", "value": "Gumagawa ng bagong Mesh, signing, at Nostr keys. Mananatili ang mga chat, media, contact, palayaw, block, at setting. Aalisin ang private groups at naka-queue na mensahe dahil ginagamit nila ang lumang keys. Makikita ka ng ibang device bilang hindi verified. Hindi ito maa-undo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Crée de nouvelles clés Mesh, de signature et Nostr. Les discussions, médias, contacts, surnoms, blocages et réglages restent. Les groupes privés et messages en attente sont supprimés car ils utilisent les anciennes clés. Les autres appareils vous verront comme non vérifié. Cette action est irréversible." } },
        "he": { "stringUnit": { "state": "translated", "value": "יוצר מפתחות Mesh, חתימה ו-Nostr חדשים. שיחות, מדיה, אנשי קשר, כינויים, חסימות והגדרות נשמרים. קבוצות פרטיות והודעות בתור נמחקות כי הן משתמשות במפתחות הישנים. מכשירים אחרים יראו אותך כלא מאומת. אי אפשר לבטל פעולה זו." } },
        "hi": { "stringUnit": { "state": "translated", "value": "नई Mesh, साइनिंग और Nostr कुंजियाँ बनाता है। चैट, मीडिया, संपर्क, उपनाम, ब्लॉक और सेटिंग बनी रहती हैं। निजी समूह और कतारबद्ध संदेश पुरानी कुंजियाँ इस्तेमाल करने के कारण हटा दिए जाते हैं। दूसरे डिवाइस आपको असत्यापित देखेंगे। इसे वापस नहीं किया जा सकता।" } },
        "id": { "stringUnit": { "state": "translated", "value": "Membuat kunci Mesh, penandatanganan, dan Nostr baru. Chat, media, kontak, nama panggilan, blokir, dan pengaturan tetap ada. Grup pribadi dan pesan antrean dihapus karena memakai kunci lama. Perangkat lain akan melihat Anda sebagai belum terverifikasi. Tindakan ini tidak dapat dibatalkan." } },
        "it": { "stringUnit": { "state": "translated", "value": "Crea nuove chiavi Mesh, di firma e Nostr. Chat, contenuti multimediali, contatti, soprannomi, blocchi e impostazioni restano. I gruppi privati e i messaggi in coda vengono rimossi perché usano le vecchie chiavi. Gli altri dispositivi ti vedranno come non verificato. L’operazione è irreversibile." } },
        "ja": { "stringUnit": { "state": "translated", "value": "新しいMesh鍵、署名鍵、Nostr鍵を作成します。チャット、メディア、連絡先、ニックネーム、ブロック、設定は保持されます。古い鍵を使用するプライベートグループと送信待ちメッセージは削除されます。他の端末では未検証として表示されます。この操作は元に戻せません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "새 Mesh, 서명 및 Nostr 키를 만듭니다. 채팅, 미디어, 연락처, 별명, 차단 및 설정은 유지됩니다. 이전 키를 사용하는 비공개 그룹과 대기 중인 메시지는 삭제됩니다. 다른 기기에서는 미인증으로 표시됩니다. 되돌릴 수 없습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Mencipta kunci Mesh, tandatangan dan Nostr baharu. Sembang, media, kenalan, nama panggilan, sekatan dan tetapan dikekalkan. Kumpulan peribadi dan mesej beratur dibuang kerana menggunakan kunci lama. Peranti lain akan melihat anda sebagai belum disahkan. Tindakan ini tidak boleh dibuat asal." } },
        "ne": { "stringUnit": { "state": "translated", "value": "नयाँ Mesh, हस्ताक्षर र Nostr कुञ्जी बनाउँछ। च्याट, मिडिया, सम्पर्क, उपनाम, रोक र सेटिङ रहन्छन्। पुराना कुञ्जी प्रयोग गर्ने निजी समूह र लाइनमा रहेका सन्देश हटाइन्छन्। अन्य यन्त्रले तपाईंलाई अप्रमाणित देख्नेछन्। यसलाई उल्ट्याउन सकिँदैन।" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Maakt nieuwe Mesh-, ondertekenings- en Nostr-sleutels. Chats, media, contacten, bijnamen, blokkeringen en instellingen blijven behouden. Privégroepen en berichten in de wachtrij worden verwijderd omdat ze de oude sleutels gebruiken. Andere apparaten zien je als niet geverifieerd. Dit kan niet ongedaan worden gemaakt." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Tworzy nowe klucze Mesh, podpisu i Nostr. Czaty, multimedia, kontakty, pseudonimy, blokady i ustawienia pozostają. Prywatne grupy i wiadomości w kolejce są usuwane, ponieważ używają starych kluczy. Inne urządzenia zobaczą cię jako niezweryfikowanego. Tej operacji nie można cofnąć." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Cria novas chaves Mesh, de assinatura e Nostr. As conversas, multimédia, contactos, alcunhas, bloqueios e definições são mantidos. Os grupos privados e as mensagens em fila são removidos porque usam as chaves antigas. Os outros dispositivos verão a sua identidade como não verificada. Esta ação é irreversível." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Cria novas chaves Mesh, de assinatura e Nostr. Conversas, mídia, contatos, apelidos, bloqueios e configurações são mantidos. Grupos privados e mensagens na fila são removidos porque usam as chaves antigas. Outros dispositivos verão você como não verificado. Não é possível desfazer." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Создаёт новые ключи Mesh, подписи и Nostr. Чаты, медиа, контакты, псевдонимы, блокировки и настройки сохраняются. Приватные группы и сообщения в очереди удаляются, потому что используют старые ключи. Другие устройства увидят вас как непроверенного пользователя. Это действие нельзя отменить." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Skapar nya Mesh-, signerings- och Nostr-nycklar. Chattar, media, kontakter, smeknamn, blockeringar och inställningar behålls. Privata grupper och köade meddelanden tas bort eftersom de använder de gamla nycklarna. Andra enheter ser dig som overifierad. Detta går inte att ångra." } },
        "ta": { "stringUnit": { "state": "translated", "value": "புதிய Mesh, கையொப்பம் மற்றும் Nostr சாவிகளை உருவாக்குகிறது. அரட்டைகள், ஊடகம், தொடர்புகள், புனைப்பெயர்கள், தடுப்புகள் மற்றும் அமைப்புகள் நீடிக்கும். பழைய சாவிகளைப் பயன்படுத்துவதால் தனிப்பட்ட குழுக்களும் வரிசைச் செய்திகளும் அகற்றப்படும். பிற சாதனங்கள் உங்களைச் சரிபார்க்கப்படாதவராகக் காணும். இதை மீளப் பெற முடியாது." } },
        "th": { "stringUnit": { "state": "translated", "value": "สร้างคีย์ Mesh คีย์ลงนาม และคีย์ Nostr ชุดใหม่ แชต สื่อ รายชื่อ ชื่อเล่น การบล็อก และการตั้งค่ายังคงอยู่ กลุ่มส่วนตัวและข้อความที่รอส่งจะถูกลบเพราะใช้คีย์เดิม อุปกรณ์อื่นจะเห็นว่าคุณยังไม่ได้รับการยืนยัน ย้อนกลับไม่ได้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Yeni Mesh, imzalama ve Nostr anahtarları oluşturur. Sohbetler, medya, kişiler, takma adlar, engellemeler ve ayarlar kalır. Eski anahtarları kullandıkları için özel gruplar ve sıradaki mesajlar kaldırılır. Diğer cihazlar sizi doğrulanmamış olarak görür. Bu işlem geri alınamaz." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Створює нові ключі Mesh, підпису й Nostr. Чати, медіа, контакти, псевдоніми, блокування та налаштування зберігаються. Приватні групи й повідомлення в черзі видаляються, бо використовують старі ключі. Інші пристрої бачитимуть вас як неперевіреного користувача. Цю дію неможливо скасувати." } },
        "ur": { "stringUnit": { "state": "translated", "value": "نئی Mesh، دستخطی اور Nostr کلیدیں بناتا ہے۔ چیٹس، میڈیا، رابطے، عرفی نام، بلاکس اور ترتیبات برقرار رہتی ہیں۔ پرانی کلیدیں استعمال کرنے کی وجہ سے نجی گروپس اور قطار میں موجود پیغامات ہٹا دیے جاتے ہیں۔ دوسرے آلات آپ کو غیر تصدیق شدہ دیکھیں گے۔ اسے واپس نہیں کیا جا سکتا۔" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Tạo khóa Mesh, khóa ký và khóa Nostr mới. Cuộc trò chuyện, nội dung đa phương tiện, liên hệ, biệt danh, danh sách chặn và cài đặt vẫn được giữ. Nhóm riêng tư và tin nhắn đang chờ bị xóa vì dùng khóa cũ. Thiết bị khác sẽ thấy bạn là chưa xác minh. Không thể hoàn tác." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "生成新的 Mesh、签名和 Nostr 密钥。聊天、媒体、联系人、昵称、拉黑记录和设置会保留。私密群组和待发送消息使用旧密钥，因此会被移除。其他设备会将你视为未验证。此操作无法撤销。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "產生新的 Mesh、簽署和 Nostr 金鑰。聊天、媒體、聯絡人、暱稱、封鎖記錄和設定會保留。私人群組和待傳送訊息使用舊金鑰，因此會被移除。其他裝置會將你視為未驗證。此操作無法復原。" } }
      }
    },
    "app_info.settings.danger.panic_button": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين الهوية ومسح البيانات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিচয় রিসেট ও ডেটা মুছুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identität zurücksetzen & Daten löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Identity & Wipe Data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer identidad y borrar datos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازنشانی هویت و پاک کردن داده‌ها"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-reset ang Identity at Burahin ang Data"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser l’identité et effacer les données"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפוס זהות ומחיקת נתונים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान रीसेट करें और डेटा मिटाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur Ulang Identitas & Hapus Data"
          }
        },
