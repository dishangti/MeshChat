        "bn": { "stringUnit": { "state": "translated", "value": "%@-এর সঙ্গে চ্যাট মুছবেন?" } },
        "de": { "stringUnit": { "state": "translated", "value": "Chat mit %@ löschen?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Delete Chat with %@?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Eliminar el chat con %@?" } },
        "fa": { "stringUnit": { "state": "translated", "value": "گفت‌وگو با %@ حذف شود؟" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Burahin ang chat kay %@?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Supprimer la discussion avec %@ ?" } },
        "he": { "stringUnit": { "state": "translated", "value": "למחוק את הצ׳אט עם %@?" } },
