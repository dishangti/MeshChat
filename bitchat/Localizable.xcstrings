          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "não é possível bloquear %@: não encontrado ou identidade não verificável"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "não é possível bloquear %@: não encontrado ou identidade não verificável"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "не удалось заблокировать %@: не найден или нельзя проверить личность"
