    "content.accessibility.carrying_mail": {
      "comment": "Accessibility label for the courier indicator; %lld is the number of sealed messages",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يحمل %lld رسالة مختومة للأصدقاء" } },
        "bn": { "stringUnit": { "state": "translated", "value": "বন্ধুদের জন্য %lldটি সিল করা বার্তা বহন করা হচ্ছে" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld versiegelte Nachrichten für Freunde werden mitgeführt" } },
        "en": { "stringUnit": { "state": "translated", "value": "Carrying %lld sealed messages for friends" } },
        "es": { "stringUnit": { "state": "translated", "value": "Llevando %lld mensajes sellados para amigos" } },
        "fa": { "stringUnit": { "state": "translated", "value": "در حال حمل %lld پیام مهروموم‌شده برای دوستان" } },
        "fil": { "stringUnit": { "state": "translated", "value": "May dalang %lld selyadong mensahe para sa mga kaibigan" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Transport de %lld messages scellés pour des amis" } },
        "he": { "stringUnit": { "state": "translated", "value": "נושא %lld הודעות חתומות עבור חברים" } },
        "hi": { "stringUnit": { "state": "translated", "value": "मित्रों के लिए %lld सीलबंद संदेश ले जा रहा है" } },
        "id": { "stringUnit": { "state": "translated", "value": "Membawa %lld pesan tersegel untuk teman" } },
        "it": { "stringUnit": { "state": "translated", "value": "Trasporto di %lld messaggi sigillati per gli amici" } },
        "ja": { "stringUnit": { "state": "translated", "value": "友だち宛ての封印済みメッセージを%lld件運搬中" } },
        "ko": { "stringUnit": { "state": "translated", "value": "친구를 위한 봉인된 메시지 %lld개 운반 중" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Membawa %lld mesej dimeterai untuk rakan" } },
        "ne": { "stringUnit": { "state": "translated", "value": "साथीहरूका लागि %lld वटा सिल गरिएका सन्देश बोकिँदै" } },
        "nl": { "stringUnit": { "state": "translated", "value": "%lld verzegelde berichten voor vrienden meenemen" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przenoszenie %lld zapieczętowanych wiadomości dla znajomych" } },
        "pt": { "stringUnit": { "state": "translated", "value": "A transportar %lld mensagens seladas para amigos" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Transportando %lld mensagens lacradas para amigos" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Запечатанных сообщений для друзей в пути: %lld" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Bär %lld förseglade meddelanden åt vänner" } },
        "ta": { "stringUnit": { "state": "translated", "value": "நண்பர்களுக்கான %lld முத்திரையிட்ட செய்திகளை எடுத்துச் செல்கிறது" } },
        "th": { "stringUnit": { "state": "translated", "value": "กำลังนำข้อความปิดผนึก %lld ข้อความไปให้เพื่อน" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Arkadaşlar için %lld mühürlü mesaj taşınıyor" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Запечатаних повідомлень для друзів у дорозі: %lld" } },
        "ur": { "stringUnit": { "state": "translated", "value": "دوستوں کے لیے %lld سربمہر پیغامات لے جا رہا ہے" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đang mang %lld tin nhắn niêm phong cho bạn bè" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "为好友携带 %lld 条密封消息" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "正為好友攜帶 %lld 則密封訊息" } }
      }
    },
    "content.delivery.carried": {
      "comment": "Delivery status for a message handed to a friend for physical delivery",
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يحملها صديق قد يلتقي بالمستلم" } },
        "bn": { "stringUnit": { "state": "translated", "value": "এমন এক বন্ধু বহন করছেন যিনি প্রাপকের সঙ্গে দেখা করতে পারেন" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wird von einem Freund mitgenommen, der die Person treffen könnte" } },
        "en": { "stringUnit": { "state": "translated", "value": "Carried by a friend who may meet them" } },
        "es": { "stringUnit": { "state": "translated", "value": "Lo lleva un amigo que podría encontrarse con la persona" } },
        "fa": { "stringUnit": { "state": "translated", "value": "دوستی آن را حمل می‌کند که شاید گیرنده را ببیند" } },
        "fil": { "stringUnit": { "state": "translated", "value": "Dala ng kaibigang maaaring makatagpo ang tatanggap" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Transporté par un ami susceptible de rencontrer la personne" } },
        "he": { "stringUnit": { "state": "translated", "value": "נישאת בידי חבר שעשוי לפגוש את הנמען" } },
        "hi": { "stringUnit": { "state": "translated", "value": "ऐसा मित्र ले जा रहा है जो प्राप्तकर्ता से मिल सकता है" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibawa teman yang mungkin bertemu penerima" } },
        "it": { "stringUnit": { "state": "translated", "value": "Trasportato da un amico che potrebbe incontrare il destinatario" } },
        "ja": { "stringUnit": { "state": "translated", "value": "受信者に会うかもしれない友だちが運搬中" } },
        "ko": { "stringUnit": { "state": "translated", "value": "받는 사람을 만날 수도 있는 친구가 운반 중" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Dibawa oleh rakan yang mungkin bertemu penerima" } },
        "ne": { "stringUnit": { "state": "translated", "value": "प्रापकलाई भेट्न सक्ने साथीले बोकेको छ" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Meegenomen door een vriend die de ontvanger mogelijk ontmoet" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Niesiona przez znajomego, który może spotkać odbiorcę" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Transportada por um amigo que poderá encontrar o destinatário" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Transportada por um amigo que pode encontrar o destinatário" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Передано другу, который может встретить получателя" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Bärs av en vän som kanske träffar mottagaren" } },
        "ta": { "stringUnit": { "state": "translated", "value": "பெறுநரைச் சந்திக்கக்கூடிய நண்பர் எடுத்துச் செல்கிறார்" } },
        "th": { "stringUnit": { "state": "translated", "value": "เพื่อนที่อาจพบผู้รับกำลังนำไปส่ง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Alıcıyla karşılaşabilecek bir arkadaş taşıyor" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Передано другові, який може зустріти одержувача" } },
        "ur": { "stringUnit": { "state": "translated", "value": "ایک دوست لے جا رہا ہے جو وصول کنندہ سے مل سکتا ہے" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Được một người bạn có thể gặp người nhận mang đi" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "由可能遇到收件人的好友携带" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "由可能遇到收件人的好友攜帶" } }
      }
    },
