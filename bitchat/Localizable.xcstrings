          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ engellendi. artık ondan mesaj almayacaksın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "заблоковано %@. ти більше не отримуватимеш від них повідомлень"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ کو بلاک کر دیا۔ اب آپ کو ان سے پیغامات نہیں ملیں گے"
          }
        },
        "vi": {
          "stringUnit": {
